// The bridge from the C++ world to the flat form: reads the session's `hir::Module` through raw
// pointers and builds the flat `XlcHirModule` of abi.xl that the dump, the prune and the native
// selector read. This is the xl replacement for touching the C++ tree directly; the layouts are
// pinned by /tmp/hirprobe.cpp (clang++, arm64-apple-macos, libc++): a libc++ or hir.h change
// moves the offsets and this file moves with them.
//
// Representations the reads rely on:
//   std::string          24 bytes; short strings keep the bytes in place with `size << 1` in the
//                        last byte, long strings carry the flag in the top bit of the last byte,
//                        the data pointer at 0 and the size at 8.
//   std::vector<T>       { begin, end, capacity } pointers; the size is the byte distance.
//   std::shared_ptr<T>   { pointer, control block }; the object pointer is the first word.
//   std::unique_ptr<T>   one pointer.
//
// Shape: the sub-arrays the flat entities point into (function locals, enum members, aggregate
// fields and vtables, interface methods) are filled completely before any entity references
// them, so no reallocation can move a pointer the flat form stores. Expression trees flatten
// post-order (children first, so a parent carries its children's indices); the arguments of one
// expression go through the `refs` arena, collected first and appended after, so nested calls
// cannot interleave another expression's argument range.
from "std" import String, Vec, format
from "../util/source" import Span, spanNone
from "abi" import XlcHirModule, XlcHirFunction, XlcHirGlobal, XlcHirEnum, XlcHirEnumMember,
    XlcHirAggregate, XlcHirField, XlcHirVtableSlot, XlcHirInterface, XlcHirIfaceMethod, XlcHirImpl,
    XlcHirExpr, XlcHirStmt, XlcHirLocal, XlcHirFieldInit, XlcHirAsmOperand, XlcHirStr, view,
    E_INT_CONST, E_FLOAT_CONST, E_BOOL_CONST, E_STR_CONST, E_NIL, E_LOCAL_REF, E_GLOBAL_REF,
    E_FUNC_REF, E_EXTERNAL, E_UNARY, E_BINARY, E_SELECT, E_CAST, E_CALL, E_CALL_INDIRECT,
    E_CALL_VIRTUAL, E_CALL_ITABLE, E_CALL_EXTERNAL, E_SYSCALL, E_FIELD, E_INDEX, E_SLICE,
    E_DEREF, E_ADDR_OF, E_ARRAY_LIST, E_ARRAY_REPEAT, E_TUPLE_LIT, E_STRUCT_LIT, E_NEW,
    E_TO_INTERFACE, E_ATOMIC_LOAD, E_ATOMIC_STORE, E_ATOMIC_XCHG, E_ATOMIC_CAS, E_ATOMIC_ADD,
    E_FENCE, E_ASM, E_CONSTRUCT, E_MOVE, E_MATERIALIZE, E_RAW_READ, E_UNWIND_PADS,
    E_UNWIND_PAD_COUNT, S_LOCAL, S_ASSIGN, S_RETURN, S_EXPR, S_IF, S_WHILE, S_CONTINUE,
    S_BREAK, S_BLOCK, S_TRY

// ---- offsets: hir::Expr (sizeof 568) -----------------------------------------------------------

const XE_KIND: usize = 0
const XE_TYPE: usize = 8
const XE_SPAN: usize = 168
const XE_INT_VALUE: usize = 192
const XE_FLOAT_VALUE: usize = 200
const XE_BOOL_VALUE: usize = 208
const XE_TEXT: usize = 216
const XE_MEMBER: usize = 240
const XE_LOCAL: usize = 264
const XE_UNARY_OP: usize = 268
const XE_BINARY_OP: usize = 272
const XE_LHS: usize = 280
const XE_RHS: usize = 288
const XE_ARGS: usize = 296
const XE_FIELDS: usize = 320
const XE_ASM_OPERANDS: usize = 344
const XE_CLOBBERS: usize = 368
const XE_TARGET: usize = 392
const XE_INDEX: usize = 552
const XE_IMPLICIT: usize = 556
const XE_CHECKED: usize = 557
const XE_THROUGH_POINTER: usize = 558
const XE_REGISTERED: usize = 559
const XE_NOMEM: usize = 560
const XE_NORETURN: usize = 561

// ---- offsets: hir::Stmt (sizeof 128) -----------------------------------------------------------

const XS_KIND: usize = 0
const XS_SPAN: usize = 4
const XS_LOCAL: usize = 24
const XS_MSG_LOCAL: usize = 28
const XS_TARGET: usize = 32
const XS_VALUE: usize = 40
const XS_BODY: usize = 48
const XS_ELSE_BODY: usize = 72
const XS_STEP: usize = 96
const XS_POST_TEST: usize = 120
const XS_DEPTH: usize = 124

