// The entry of the xlang part of xlc: one object compiled by an installed `xl`
// (xmake/xlang.lua) that carries the lexer, the preprocessor, the macro expander and the HIR dump
// and prune, and exposes their C entry points. Everything reachable from here is linked; the C++
// side sees only the `xlc*` functions of include/xlang/lang/lexer_c.h, directives_c.h and
// macro_c.h.
from "lexer/lexer" import xlcLex, xlcLexFree
from "preprocess/preprocess" import xlcPreprocess, xlcPreprocessFree
from "macro/expand" import xlcExpandMacros, xlcExpandMacrosFree
from "frontend/frontend" import xlcFrontendParse
from "../hir/dump" import xlcHirDump, xlcHirDumpFree
from "../hir/prune" import xlcHirPrune, xlcHirPruneFree
from "parser/parser" import xlcParse
from "../sema/flat" import Flat
from "../sema/types" import Types
from "../sema/conversion" import implicitConversion, commonBinaryType
from "../sema/layout" import LayoutHistory, formatLayoutRecord
from "../util/source" import xlcUtilSourcesNew, xlcUtilAddFile, xlcUtilSourcesFree
from "../util/diagnostics" import xlcDiagNew, xlcDiagConfigure, xlcDiagAddAllowScope,
    xlcDiagReport, xlcDiagBeginQuiet, xlcDiagEndQuiet, xlcDiagFlush, xlcDiagExplain,
    xlcDiagFreeEngine
