// The MIR text form (`--dump-mir`). The unit tests match this text, so every line keeps the
// spelling of the MIR dump exactly:
//
//   fn name -> R
//     let _0: T  (param a)
//     bb0:
//       _2 = move _1
//       call f(move _2) -> _3, bb1 unwind bb4
//
// Locals are `_n` (their HIR id), blocks `bbN`.
from "std" import String, Vec, format, toString
from "model" import Place, Projection, Constant, Operand, Rvalue, Callee, Terminator, Body, Module,
    Local, LK_PARAM, LK_USER, LK_DROP_FLAG, PK_FIELD, PK_DEREF, PK_INDEX, OK_COPY, OK_MOVE,
    CK_NONE, CK_INT, CK_FLOAT, CK_BOOL, CK_STR, CK_NIL, CK_FUNCTION, CK_GLOBAL, RK_USE,
    RK_ADDRESS_OF, RK_UNARY, RK_BINARY, RK_CAST, RK_AGGREGATE, RK_REPEAT, RK_ZERO, RK_SLICE,
    RK_TO_INTERFACE, BI_ALLOC, BI_ATOMIC_LOAD, BI_ATOMIC_STORE, BI_ATOMIC_XCHG, BI_ATOMIC_CAS,
    BI_ATOMIC_ADD, BI_FENCE, BI_ASM, BI_UNWIND_PADS, BI_UNWIND_PAD_COUNT, CL_DIRECT, CL_INDIRECT,
    CL_VIRTUAL, CL_INTERFACE, CL_SYSCALL, CL_BUILTIN, TK_GOTO, TK_BRANCH, TK_CALL, TK_DROP, TK_TRY,
    TK_RETURN, TK_UNREACHABLE

/// The `Local` kind word of the `let` line.
fn kindName(kind: u8) -> str {
    switch {
        case kind == LK_PARAM { return "param" }
        case kind == LK_USER { return "user" }
        case kind == LK_DROP_FLAG { return "flag" }
        default { return "temp" }
    }
}

/// `_n` followed by the projections: `.f`, `(*p)` wrapping what came before, `[_i]`.
fn placeText(p: *Place) -> String {
    local out = format("_{}", p.localId)
    for i in 0..p.projections.length() {
        local pr = p.projections.get(i)
        if pr.kind == PK_FIELD {
            out.append(format(".{}", pr.field))
        } else if pr.kind == PK_DEREF {
            out = format("(*{})", &out)
        } else {
            out.append(format("[_{}{}]", pr.index, pr.checked ? " checked" : ""))
        }
    }
    return out
}

/// A constant. Floats print as C++ `std::format("{}", double)` does: a whole value carries no `.0`.
fn constantText(c: *Constant) -> String {
    switch {
        case c.kind == CK_NONE { return String("()") }
        case c.kind == CK_INT { return format("{}", c.intBits) }
        case c.kind == CK_FLOAT {
            local t = toString(c.floatValue)
            if t.findLast("e") < 0 && t.length() >= 2 && t.at(t.length() - 2) == b'.' && t.at(t.length() - 1) == b'0' {
                return t.slice(0, t.length() - 2)
            }
            return t
        }
        case c.kind == CK_BOOL { return String(c.boolValue ? "true" : "false") }
        case c.kind == CK_STR { return format("\"{}\"", &c.text) }
        case c.kind == CK_NIL { return String("nil") }
        case c.kind == CK_FUNCTION { return format("fn {}", &c.text) }
        case c.kind == CK_GLOBAL { return format("&{}", &c.text) }
        default { return String("?") }
    }
}

/// One operand: `copy p`, `move p` or `const c`.
fn operandText(o: *Operand) -> String {
    if o.kind == OK_COPY {
        return format("copy {}", &placeText(&o.place))
    }
    if o.kind == OK_MOVE {
        return format("move {}", &placeText(&o.place))
    }
    return format("const {}", &constantText(&o.constant))
}

/// A list of operands, separated by `, `.
fn operandsText(list: *Vec<Operand>) -> String {
    local out = String()
    for i in 0..list.length() {
        if i > 0 {
            out.append(", ")
        }
        out.append(&operandText(list.get(i)))
    }
    return out
}

/// An aggregate: `T { a, .f = b }` (`fields` empty: positional).
fn aggregateText(r: *Rvalue) -> String {
    local out = String()
    for i in 0..r.operands.length() {
        if i > 0 {
            out.append(", ")
        }
        if r.fields.length() > 0 {
            out.append(format(".{} = ", *r.fields.get(i)))
        }
        out.append(&operandText(r.operands.get(i)))
    }
    return format("{} {{ {} }}", &r.typeName, &out)
}

/// The right side of an assignment.
fn rvalueText(r: *Rvalue) -> String {
    local checked = r.checked ? " checked" : ""
    switch {
        case r.kind == RK_USE { return operandsText(&r.operands) }
        case r.kind == RK_ADDRESS_OF { return format("&{}", &placeText(&r.place)) }
        case r.kind == RK_UNARY { return format("{}{}", &r.op, &operandsText(&r.operands)) }
        case r.kind == RK_BINARY {
            return format("{} {} {}{}", &operandText(r.operands.get(0)), &r.op,
                &operandText(r.operands.get(1)), checked)
        }
        case r.kind == RK_CAST { return format("{} as {}", &operandsText(&r.operands), &r.typeName) }
        case r.kind == RK_AGGREGATE { return aggregateText(r) }
        case r.kind == RK_REPEAT { return format("[{}; {}]", &operandsText(&r.operands), r.count) }
        case r.kind == RK_ZERO { return format("zeroed {}", &r.typeName) }
        case r.kind == RK_SLICE {
            return format("{}[{}..{}]{}", &placeText(&r.place), &operandText(r.operands.get(0)),
                &operandText(r.operands.get(1)), checked)
        }
        case r.kind == RK_TO_INTERFACE {
            return format("{} as {} by {}", &operandsText(&r.operands), &r.typeName, &r.name)
        }
        default { return String("?") }
    }
}

/// The spelling of a builtin callee.
fn builtinName(b: u8) -> str {
    switch {
        case b == BI_ALLOC { return "alloc" }
        case b == BI_ATOMIC_LOAD { return "atomic.load" }
        case b == BI_ATOMIC_STORE { return "atomic.store" }
        case b == BI_ATOMIC_XCHG { return "atomic.xchg" }
        case b == BI_ATOMIC_CAS { return "atomic.cas" }
        case b == BI_ATOMIC_ADD { return "atomic.add" }
        case b == BI_FENCE { return "fence" }
        case b == BI_ASM { return "asm" }
        case b == BI_UNWIND_PADS { return "unwindPads" }
        case b == BI_UNWIND_PAD_COUNT { return "unwindPadCount" }
        default { return "?" }
    }
}

/// The callee of a call: a name, `(fn-pointer)`, `virtual[slot] f`, `(iface).m[slot]`, `syscall`
/// or a builtin.
fn calleeText(c: *Callee) -> String {
    switch {
        case c.kind == CL_DIRECT { return String(c.name.asStr()) }
        case c.kind == CL_INDIRECT { return format("({})", &operandText(&c.value)) }
        case c.kind == CL_VIRTUAL { return format("virtual[{}] {}", c.index, &c.name) }
        case c.kind == CL_INTERFACE { return format("({}).{}[{}]", &operandText(&c.value), &c.name, c.index) }
        case c.kind == CL_SYSCALL { return String("syscall") }
        case c.kind == CL_BUILTIN {
            return c.builtin == BI_ALLOC ? format("alloc<{}>", &c.typeName) : String(builtinName(c.builtin))
        }
        default { return String("?") }
    }
}

/// The successor list: `bb1, bb2` then ` unwind bb3` when there is an unwind edge.
fn targetsText(t: *Terminator) -> String {
    local out = String()
    for i in 0..t.targets.length() {
        out.append(format("{}bb{}", i > 0 ? ", " : "", *t.targets.get(i)))
    }
    if t.hasUnwind {
        out.append(format("{}unwind bb{}", out.length() > 0 ? " " : "", t.unwind))
    }
    return out
}

/// The terminator of a block.
fn terminatorText(t: *Terminator) -> String {
    switch {
        case t.kind == TK_GOTO { return format("goto {}", &targetsText(t)) }
        case t.kind == TK_BRANCH {
            return format("branch {} -> {}", &operandText(&t.operand), &targetsText(t))
        }
        case t.kind == TK_CALL {
            local result = t.hasDestination ? format("{} = ", &placeText(&t.destination)) : String()
            local next = t.targets.length() == 0 && !t.hasUnwind ? String("never") : targetsText(t)
            return format("{}call {}({}) -> {}", &result, &calleeText(&t.callee),
                &operandsText(&t.args), &next)
        }
        case t.kind == TK_DROP {
            return format("drop {} by {} -> {}", &placeText(&t.place), &t.glue, &targetsText(t))
        }
        case t.kind == TK_TRY {
            return format("try {}, _{} -> {}", &placeText(&t.place), t.message, &targetsText(t))
        }
        case t.kind == TK_RETURN { return format("return {}", &operandText(&t.operand)) }
        case t.kind == TK_UNREACHABLE { return String("unreachable") }
        default { return String("?") }
    }
}

/// One body: the header, its locals, then every block.
fn dumpBody(out: *String, b: *Body) {
    out.append(format("fn {} -> {}\n", &b.name, &b.ret))
    for id in 0..b.locals.length() {
        local l = b.locals.get(id)
        out.append(format("  let _{}: {}  ({}{}{})\n", id, &l.typeName, kindName(l.kind),
            l.name.length() > 0 ? " " : "", &l.name))
    }
    for id in 0..b.blocks.length() {
        local block = b.blocks.get(id)
        out.append(format("  bb{}:\n", id))
        for s in 0..block.statements.length() {
            local st = block.statements.get(s)
            out.append(format("    {} = {}\n", &placeText(&st.place), &rvalueText(&st.value)))
        }
        out.append(format("    {}\n", &terminatorText(&block.terminator)))
    }
}

/// The text of every body of `m`, in order.
export fn dumpModule(m: *Module) -> String {
    local out = String()
    for i in 0..m.bodies.length() {
        dumpBody(&out, m.bodies.get(i))
    }
    return out
}
