// The lowered program as the output step reads it. The session's HIR is pruned to what the roots
// reach (src/hir/prune.xl, plan 24), and the `@library` imports of what is left are added to the
// link.
from "std" import Vec, String
from "../hir/prune" import xlcHirPrune, xlcHirPruneFree
from "../hir/abi" import XlcHirModule, XlcHirKeep, view, owned
from "../session/session" import Session
from "../driver/link" import LinkRequest, Import

/// `KeepExports` of the prune (src/hir/prune.xl): none, `export(c)` only, every export.
const KEEP_NONE: i32 = 0
const KEEP_C: i32 = 1
const KEEP_ALL: i32 = 2

/// Erases every function and global the reachability prune does not reach from the roots. A
/// library or an object keeps every export (`emit` other than exe); an executable keeps the
/// `export(c)` functions when it links prebuilt objects (`hasInputs`), and nothing else.
export fn pruneProgram(session: *Session, emit: str, hasInputs: bool) {
    local keep = emit != "exe" ? KEEP_ALL : hasInputs ? KEEP_C : KEEP_NONE
    local k = xlcHirPrune(session.hirModule(), keep)
    local functions = Vec<u32>()
    local globals = Vec<u32>()
    for i in 0..k.functionCount as usize {
        functions.push(k.functions[i])
    }
    for i in 0..k.globalCount as usize {
        globals.push(k.globals[i])
    }
    xlcHirPruneFree(k)
    session.keep(&functions, &globals)
}

/// Adds the `@library` imports of the flat module `m` to the link (`declare` functions with a
/// library, the ones the Windows link generates import libraries for).
export fn addLinkImports(m: *XlcHirModule, r: *LinkRequest) {
    for i in 0..m.functionCount as usize {
        local f = &m.functions[i]
        if f.declared != 0 && f.importLibrary.len > 0 {
            r.imports.push(Import(owned(f.importLibrary), owned(f.symbol)))
        }
    }
}
