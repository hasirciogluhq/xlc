// The boundary between the CLI written in xlang and the C++ backend: the flat structs of
// include/xlang/backend_c.h mirrored field for field, the `declare fn` bindings of the session
// (include/xlang/backend_c.h), and the helpers that turn strings into boundary strings and back.
// The code generation bindings are in src/codegen/llvm.xl (include/xlang/codegen/codegen_c.h).
from "std" import String, Vec
from "std/str" import fromParts

/// One string across the boundary: the bytes are not NUL-terminated.
@repr(c)
export struct XlcStr {
    bytes: *u8
    len: u32
}

/// A list of strings across the boundary.
@repr(c)
export struct XlcStrList {
    items: *XlcStr
    count: u32
}

/// A list of indices (functions, globals or modules). Matches `XlcIndexList`.
@repr(c)
export struct XlcIndexList {
    items: *u32
    count: u32
}

/// A source span. Matches `XlcSpan`, the layout of `xlang::Span`.
@repr(c)
export struct XlcSpan {
    file: u32
    line: u32
    column: u32
    endLine: u32
    endColumn: u32
}

/// The command-line configuration, already parsed into values. Field order and types match
/// `XlcConfig` in include/xlang/backend_c.h exactly.
@repr(c)
export struct XlcConfig {
    target: XlcStr
    opt: XlcStr
    debug: i32
    cpu: XlcStr
    mangle: XlcStr
    safety: XlcStr
    layoutScheme: XlcStr
    layoutHistory: XlcStr
    defines: XlcStrList
    undefs: XlcStrList
    allow: XlcStrList
    deny: XlcStrList
    warnAll: i32
    allowAll: i32
    contextErrors: u64
    contextWarnings: u64
    logPath: XlcStr
    diagFormat: XlcStr
    diagLogLevel: XlcStr
    crt: i32
}

/// The resolved target. Matches `XlcTarget`; the strings live in the session.
@repr(c)
export struct XlcTarget {
    triple: XlcStr
    os: XlcStr
    arch: XlcStr
}

/// One source module of the compilation, in dependency order. Matches `XlcModule`.
@repr(c)
export struct XlcModule {
    key: XlcStr
    text: XlcStr
    registered: i32
    deps: XlcIndexList
}

/// The opaque backend session, behind `xlcSessionNew`/`xlcSessionFree`.
export type XlcSession = u8

// Every backend function is `declare`d: it resolves at link time from the backend archive
// (`xlc-backend`), so `--emit=obj` alone always warns W0301; silenced per declaration.
@allow(W0301)
export declare fn xlcSetColor(on: i32)
@allow(W0301)
export declare fn xlcExplain(code: XlcStr) -> i32
@allow(W0301)
export declare fn xlcVersion()
@allow(W0301)
export declare fn xlcPrintCfg(config: *XlcConfig) -> i32
@allow(W0301)
export declare fn xlcDumpAst(config: *XlcConfig, path: XlcStr) -> i32
@allow(W0301)
export declare fn xlcSessionNew(config: *XlcConfig) -> *XlcSession
@allow(W0301)
export declare fn xlcSessionFree(session: *XlcSession)
@allow(W0301)
export declare fn xlcSessionAddModuleRoot(session: *XlcSession, spec: XlcStr) -> i32
@allow(W0301)
export declare fn xlcSessionAddImplicitImport(session: *XlcSession, spec: XlcStr) -> i32
@allow(W0301)
export declare fn xlcSessionLoadRoot(session: *XlcSession, path: XlcStr) -> i32
@allow(W0301)
export declare fn xlcSessionAnalyze(session: *XlcSession) -> i32
@allow(W0301)
export declare fn xlcSessionLower(session: *XlcSession) -> i32
@allow(W0301)
export declare fn xlcSessionDumpHir(session: *XlcSession) -> i32
@allow(W0301)
export declare fn xlcSessionDumpMir(session: *XlcSession) -> i32
@allow(W0301)
export declare fn xlcSessionDumpLayout(session: *XlcSession, typeName: XlcStr, record: i32) -> i32
@allow(W0301)
export declare fn xlcSessionTarget(session: *XlcSession, target: *XlcTarget)
@allow(W0301)
export declare fn xlcSessionOptLevel(session: *XlcSession) -> i32
@allow(W0301)
export declare fn xlcSessionHirModule(session: *XlcSession) -> *void
@allow(W0301)
export declare fn xlcSessionKeep(session: *XlcSession, functions: XlcIndexList, globals: XlcIndexList)
@allow(W0301)
export declare fn xlcSessionSizeOf(session: *XlcSession, name: XlcStr, size: *i64) -> i32
@allow(W0301)
export declare fn xlcSessionModuleCount(session: *XlcSession) -> u32
@allow(W0301)
export declare fn xlcSessionModule(session: *XlcSession, index: u32, module: *XlcModule) -> i32
@allow(W0301)
export declare fn xlcSessionConfigKey(session: *XlcSession, emit: XlcStr, key: *XlcStr)
@allow(W0301)
export declare fn xlcSessionDiagnose(session: *XlcSession, code: XlcStr, span: *XlcSpan, message: XlcStr, hint: XlcStr)
@allow(W0301)
export declare fn xlcSessionHasErrors(session: *XlcSession) -> i32
@allow(W0301)
export declare fn xlcSessionErrorCount(session: *XlcSession) -> i64
@allow(W0301)
export declare fn xlcSessionWarningCount(session: *XlcSession) -> i64
@allow(W0301)
export declare fn xlcSessionPrintSummary(session: *XlcSession)
@allow(W0301)
export declare fn xlcSessionFlush(session: *XlcSession)

/// The byte an empty boundary string points at: the C++ side wants a valid pointer even for
/// length zero.
global kEmptyByte: u8 = 0

/// `String` -> boundary string. The bytes live as long as the String does.
export fn xstr(s: *String) -> XlcStr {
    if s.len == 0 {
        return XlcStr { bytes: &kEmptyByte, len: 0 }
    }
    return XlcStr { bytes: s.ptr, len: s.len as u32 }
}

/// `str` -> boundary string. The bytes stay alive as long as the view does.
export fn strOf(s: str) -> XlcStr {
    if s.len == 0 {
        return XlcStr { bytes: &kEmptyByte, len: 0 }
    }
    return XlcStr { bytes: s.ptr, len: s.len as u32 }
}

/// Boundary string -> a `str` view. The bytes stay alive for the one call that uses it.
export fn xview(s: XlcStr) -> str {
    return fromParts(s.bytes, s.len as usize)
}

/// Boundary string -> an owned `String` copy.
export fn ownedOf(s: XlcStr) -> String {
    return String(fromParts(s.bytes, s.len as usize))
}

/// Copies one list into the arena and returns the boundary list. The arena Vec must outlive the
/// call that uses the result.
export fn xlist(items: *Vec<String>, arena: *Vec<XlcStr>) -> XlcStrList {
    for i in 0..items.length() {
        arena.push(xstr(items.get(i)))
    }
    return XlcStrList { items: arena.data, count: arena.length() as u32 }
}
