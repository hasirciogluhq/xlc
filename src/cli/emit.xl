// The output step of the CLI: where the output goes, the program pruned and checked, the header or
// the code generated, then the archive or the link (src/driver/link.xl) of the objects it produced.
//
// The one code generator is the native backend (src/codegen/native); it picks the selector and
// the object writer from the target and rejects a target it has no backend for (E0714).
//
//   header                 written from the flat HIR (src/codegen/header.xl) to the output (`-o -` streams)
//   obj                    written by the code generator straight to the output (`-o -` streams)
//   exe, shared            linked from the code generator's objects plus the prebuilt inputs
//   static                 archived from the code generator's objects
//
// Without `--incremental` the code generator writes one scratch object next to the output (same
// directory, so the same file system and permissions), removed here whether or not the link
// succeeds; `--incremental` objects live in the cache and stay (src/cli/incremental.xl).
from "std" import String, Vec, format
from "std/io" import fprint
from "std/io/files" import removeFile
from "std/io/fs" import fsWrite
from "std/str" import toUpperAscii
from "../session/session" import Session
from "path" import stemOf, fileNameOf, dirOf
from "entry" import checkEntry
from "program" import pruneProgram, addLinkImports
from "incremental" import emitIncremental
from "../driver/link" import LinkRequest, link
from "../codegen/native" import emitNativeObj
from "../driver/link" import archive
from "../codegen/header" import headerText

/// Everything the output step needs from the command line.
export class EmitPlan {
    root: String
    output: String          // "" = next to `root`, named by `emit`
    emit: String            // exe|obj|ir|bc|header|static|shared
    incremental: bool
    cacheDir: String
    inputs: Vec<String>     // prebuilt objects and libraries handed to the linker
    linkArgs: Vec<String>   // `--link-arg`
    crt: bool

    fn init(self) {
        self.inputs = Vec<String>()
        self.linkArgs = Vec<String>()
    }
}

/// The default output: next to the input, named after it (`main.xl` -> `main`, `main.exe`,
/// `libmain.a`, `main.dll`, ...).
export fn defaultOutput(root: *String, emit: *String, os: *String) -> String {
    local dir = dirOf(root.asStr())
    local stem = stemOf(root.asStr())
    local windows = os.asStr() == "windows"
    local kind = emit.asStr()
    // (prefix, suffix) around the stem; the last row is `shared`.
    local (prefix, suffix) = kind == "exe" ? ("", windows ? ".exe" : "")
                           : kind == "obj" ? ("", windows ? ".obj" : ".o")
                           : kind == "ir" ? ("", ".ll")
                           : kind == "bc" ? ("", ".bc")
                           : kind == "header" ? ("", ".h")
                           : kind == "static" ? (windows ? "" : "lib", windows ? ".lib" : ".a")
                           : (windows ? "" : "lib", windows ? ".dll" : os.asStr() == "macos" ? ".dylib" : ".so")
    dir.append(prefix)
    dir.append(&stem)
    dir.append(suffix)
    return dir
}

/// Generates code and archives or links the result. False when anything failed; the failure is
/// already reported (a diagnostic, or an `error:` line).
export fn emitProgram(session: *Session, plan: *EmitPlan) -> bool {
    local target = &session.config.target
    local os = target.os.clone()
    local arch = target.arch.clone()
    local output = plan.output.length() > 0 ? plan.output.clone() : defaultOutput(&plan.root, &plan.emit, &os)
    local windows = os.asStr() == "windows"


    // Lowering is lazy (the first hirModule call runs it). A program with errors has holes in its
    // HIR (-1 operands), so it is lowered and checked before the prune walks it; the prune used
    // to run the lowering itself and crash on the holes before any diagnostic was printed.
    session.hirModule()
    if session.hasErrors() { return false }
    // Plan 24: only what the roots reach is code-generated and linked; the flat module below is
    // read after that prune, so it describes exactly what is generated.
    pruneProgram(session, plan.emit.asStr(), plan.inputs.length() > 0)
    local module = session.hirModule()
    if session.hasErrors() { return false }

    local rootName = fileNameOf(plan.root.asStr())
    local stem = stemOf(plan.root.asStr())
    if !checkEntry(session, module, plan.emit.asStr(), rootName.asStr(), os.asStr(), plan.crt) {
        return false
    }

    if plan.emit.asStr() == "header" {
        local guard = toUpperAscii(format("XLANG_{}_H", stem.asStr()).asStr())
        local text = headerText(session, module, guard.asStr())
        if output.asStr() == "-" { // `-o -` streams, like the LLVM writers of ir, bc and obj
            fprint(1, text.asStr())
            return true
        }
        if !fsWrite(output.cstr(), text.asStr()) {
            fprint(2, format("error: cannot write `{}`\n", output.asStr()).asStr())
            return false
        }
        return true
    }

    local emit = plan.emit.asStr()
    local linked = emit == "exe" || emit == "static" || emit == "shared"
    local objects = Vec<String>()
    local temporary = false
    local none = String()

    if !linked {
        // obj: written in place.
        return emitNativeObj(module, target, false, "", &output)
    }

    if plan.incremental {
        if !emitIncremental(session, module, &plan.emit, &stem, &output, &plan.cacheDir, windows, &objects) {
            return false
        }
    } else {
        // The intermediate object sits next to the output (same directory, so the same permissions
        // and file system); the CLI removes it whether or not the link succeeds.
        local obj = output.clone()
        obj.append(".tmp.o")
        if !emitNativeObj(module, target, false, "", &obj) {
            return false
        }
        objects.push(obj)
        temporary = true
    }
    if session.hasErrors() {
        return false
    }

    local ok = false
    if emit == "static" {
        ok = archive(&objects, &output, &os)
    } else {
        local r = LinkRequest()
        for i in 0..objects.length() {
            r.objects.push(objects.get(i).clone())
        }
        for o in plan.inputs {
            r.objects.push(o.clone())
        }
        r.output = output.clone()
        r.shared = emit == "shared"
        r.crt = plan.crt
        r.os = os.clone()
        r.arch = arch.clone()
        addLinkImports(module, &r)
        for a in plan.linkArgs {
            r.extraArgs.push(a.clone())
        }
        ok = link(&r)
    }
    if temporary {
        for i in 0..objects.length() {
            removeFile(objects.get(i))
        }
    }
    return ok
}
