// The incremental build (plan 8.1/8.2): one object per source module, named by the content hash of
// the module, of the modules it imports and of the build configuration. An object already in the
// cache is not generated again. Port of the former emitIncremental in src/cli/emit.cpp.
//
// The hash is FNV-1a over the configuration key (`xlcSessionConfigKey`), the module key, the module
// text and the hashes of its dependencies; a module that registers names salts every name, because
// those names are visible everywhere.
from "std" import String, Vec, format
from "std/str" import eq, fromParts
from "std/io/files" import exists, makeDirAll
from "../hir/abi" import XlcHirModule, view
from "../session/session" import Session, ModuleRow
from "path" import dirOf, joinPath
from "../codegen/native" import emitNativeObj
from "../util/source" import spanNone

/// FNV-1a offset basis and prime (64-bit).
const FNV_BASIS: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

/// One FNV-1a step over `s`, then a separator round (the C++ `mix`).
fn mix(h: u64, s: str) -> u64 {
    local x = h
    for i in 0..s.len {
        x = (x ^ (s.ptr[i] as u64)) * FNV_PRIME
    }
    return (x ^ 0xff) * FNV_PRIME
}

/// The hash of module `i`, memoized. A module reached again while it is being hashed (an import
/// cycle) contributes 0, as the C++ `base[&m] = 0` did.
fn baseHash(i: usize, cfg: str, mods: *Vec<ModuleRow>, memo: *Vec<u64>, state: *Vec<u8>) -> u64 {
    if *state.get(i) != 0 {
        return *memo.get(i)
    }
    state.set(i, 1)
    memo.set(i, 0)
    local m = mods.get(i)
    local h = mix(mix(mix(FNV_BASIS, cfg), m.key.asStr()), m.text)
    for k in 0..m.deps.length() {
        local d = baseHash(*m.deps.get(k) as usize, cfg, mods, memo, state)
        local text = format("{}", d)
        h = mix(h, text.asStr())
    }
    memo.set(i, h)
    return h
}

/// The module key with `/` written as `.`, for the object file name.
fn objectName(key: str) -> String {
    local out = String()
    for i in 0..key.len {
        out.push(key.ptr[i] == b'/' ? b'.' : key.ptr[i])
    }
    return out
}

/// Whether module `key` contributes functions or globals to the flat module `m`.
fn hasCode(m: *XlcHirModule, key: str) -> bool {
    if key.len == 0 {
        return true
    }
    for i in 0..m.functionCount as usize {
        if eq(view(m.functions[i].module), key) {
            return true
        }
    }
    for i in 0..m.globalCount as usize {
        if eq(view(m.globals[i].module), key) {
            return true
        }
    }
    return false
}

/// Generates and caches one object per module of the program, and returns the object paths in
/// link order. `emit` is the output kind (it is part of the key), `output` the final output (the
/// cache sits next to it unless `cacheDir` names one), `stem` the root file stem. False after a
/// reported failure; `objects` then holds nothing usable.
export fn emitIncremental(session: *Session, m: *XlcHirModule, emit: *String, stem: *String, output: *String,
                          cacheDir: *String, windows: bool, objects: *Vec<String>) -> bool {
    local cacheRoot: String = cacheDir.length() > 0 ? cacheDir.clone() : joinPath(dirOf(output.asStr()).asStr(), ".xlc-cache", windows)
    makeDirAll(&cacheRoot)

    local cfg = session.configKey(emit.asStr())

    // The module table of the session, in dependency order.
    local mods = session.modules()
    local count = mods.length()
    local memo = Vec<u64>()
    local state = Vec<u8>()
    for i in 0..count {
        memo.push(0)
        state.push(0)
    }

    // Registered names (panic, allocator, ...) are visible everywhere: they salt every module hash.
    local salt = String()
    for i in 0..count {
        if mods.get(i).registered {
            local h = baseHash(i, cfg.asStr(), &mods, &memo, &state)
            salt.append(format("{};", h).asStr())
        }
    }

    local ext: str = windows ? ".obj" : ".o"
    for i in 0..count {
        local row = mods.get(i)
        local key = row.key.asStr()
        if !hasCode(m, key) {
            continue
        }
        local name = key.len == 0 ? stem.clone() : objectName(key)
        local leaf = format("{}-{:016x}{}", name.asStr(), mix(baseHash(i, cfg.asStr(), &mods, &memo, &state), salt.asStr()), ext)
        local obj = joinPath(cacheRoot.asStr(), leaf.asStr(), windows)
        if !exists(&obj) {
            if !emitNativeObj(m, &session.config.target, true, key, &obj) {
                if !session.hasErrors() {
                    local message = format("code generation for module `{}` failed without a diagnostic", name.asStr())
                    session.diagnose("E0714", spanNone(), message.asStr(), "internal error: the back end returned no object")
                }
                return false
            }
        }
        objects.push(obj)
    }
    return !session.hasErrors()
}
