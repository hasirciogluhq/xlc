// Lowering of function bodies: parameters, locals, statements and the expression walk. The
// xlang source of sema/lower/item/function.cpp and the expr/ and stmt/ subtrees; this file
// grows as the lowering pass is ported.
from "std" import String, Vec, format
from "../hir/abi" import XlcHirLocal, XlcHirStr, XlcHirFieldInit, E_STRUCT_LIT, S_RETURN, S_BREAK, S_CONTINUE
from "../lang/ast/ast" import XSpan, XE_INT_LITERAL, XE_FLOAT_LITERAL, XE_BOOL_LITERAL, XE_STRING_LITERAL,
    XE_BYTE_LITERAL, XE_NAME, XE_UNARY, XE_BINARY, XE_CALL, XE_INDEX, XE_SLICE, XE_FIELD,
    XE_CAST, XE_ARRAY_LIST, XE_ARRAY_REPEAT, XE_TUPLE_LITERAL, XE_STRUCT_LITERAL, XE_NEW,
    XE_TERNARY, XE_TRY, XE_CLOSURE,
    XS_LOCAL, XS_DELETE, XS_CONST, XS_ASSIGN, XS_RETURN, XS_EXPR, XS_IF, XS_WHILE, XS_DO_WHILE,
    XS_FOR, XS_FOR_RANGE, XS_FOR_PACK, XS_FOR_EACH, XS_SWITCH, XS_DEFER, XS_TRY, XS_CONTINUE,
    XS_BREAK, XS_UNSAFE, XS_BLOCK
from "../sema/sema" import Sema, SY_ENUM
from "../sema/item" import SDecl, SItem, SParam
from "../lang/ast/ast" import XStmt, XExpr, XU_NEG, XU_NOT, XU_DEREF, XU_ADDROF, XU_BITNOT,
    XB_ADD, XB_SUB, XB_MUL, XB_DIV, XB_MOD, XB_EQ, XB_NE, XB_LT, XB_LE, XB_GT, XB_GE,
    XB_AND, XB_OR, XB_BITAND, XB_BITOR, XB_BITXOR, XB_SHL, XB_SHR
from "../sema/types" import T_NAMED, T_POINTER, T_SLICE, T_ARRAY, T_STR, T_INT, T_BOOL, T_ENUM, T_TUPLE
from "./stmt" import switchChain
from "../sema/resolve" import resolve
from "./state" import Lowerer, ScopeEntry, ScopeStack, XlcHirLocalRec,
    SE_LOCAL, SE_GLOBAL, SE_FUNCTION, SE_CONSTANT, SE_TYPE, SE_NAMESPACE, SE_EXTERNAL
from "./builder" import FnBuild, XlcHirGlobalRec
from "./queries" import lowerLayoutQuery, enumMemberValue, unaryOpName, binaryOpName, lowerArrayLen,
    isConstValue
from "./call" import lowerCall
from "./methods" import classSelfType
from "./typing" import exprType, exprTypeName, isLiteralExpr, isFloatLiteralExpr, isNumeric,
    effectiveType, typeNameOf, isIntType, isFloatType, resolveBase, fieldIndexOf, aggregateTypeOf,
    fieldTypeOf
from "./diagnose" import coerceChecked, checkCast, checkIndex, checkSlice, checkDeref, checkField,
    checkStructLit, checkDuplicateInit, knownField, reportTwoSites
from "../sema/conversion" import implicitConversion, commonBinaryType, C_OK, C_WARN
from "../sema/const_eval" import evalConst
from "../sema/const_value" import CV_INT
from "../sema/layout_calc" import layoutOfName

/// The statement kinds of the flat AST (the `XS_*` constants of ast.xl, mirrored).
export fn lowerModuleTouch() { return }

/// A module-level function: the declaration comes from the item.
export fn lowerFunction(l: *Lowerer, item: i32, declIdx: i32, qname: str, localName: str,
                        owner: str) {
    runFunction(l, item, l.s.declOf(item), qname, localName, owner)
}

/// A class method: the declaration comes from the SDecl arena index.
export fn lowerFunctionDecl(l: *Lowerer, item: i32, declIdx: i32, qname: str, localName: str,
                            owner: str) {
    runFunctionDecl(l, item, declIdx, qname, localName, owner)
}

    /// Opens the function under construction: the header fields, the scope and the parameters.
export fn beginFunction(l: *Lowerer, qname: str, localName: str, owner: str, ret: str) {
        l.fnName = String(qname)
        l.fnSymbol = String("")
        l.fnRet = String(ret)
        l.fnLocals = Vec<*XlcHirLocalRec>()
        l.fnParamCount = 0
        l.fnBody = Vec<i32>()
        l.fnUnwind = Vec<i32>()
        l.prelude = Vec<i32>()
        l.defers = Vec<Vec<i32>>()
        l.fnFlags = Vec<u32>()
        l.loops = Vec<String>()
        l.loopMarks = Vec<i32>()
        l.emitted = Vec<i32>()
        l.currentClass = String(owner)
        l.hasSelf = false
        l.scopes.push()
    }

    /// Closes the function: appends its record to the builder and pops the scope.
export fn endFunction(l: *Lowerer, item: i32) {
        local f = new FnBuild(l.fnName.asStr())
        (*f).symbol = l.fnSymbol.clone()
        (*f).ret = l.fnRet.clone()
        for i in 0..l.fnLocals.length() {
            local lr = l.fnLocals.get(i)
            local rec: XlcHirLocal
            rec.name = l.b.str((*lr).name.asStr())
            rec.typeName = l.b.str((*lr).typeName.asStr())
            (*f).locals.push(rec)
        }
        (*f).paramCount = l.fnParamCount
        local body = l.b.stmtList(&l.fnBody)
        (*f).bodyFirst = body.0
        (*f).bodyCount = body.1
        // The landing pad: every registered cleanup, newest first, when an unwinder is registered.
        local pads = Vec<i32>()
        if l.b.unwindFunction.asStr().len > 0 {
            for i in 0..l.fnUnwind.length() {
                pads.push(*l.fnUnwind.get(l.fnUnwind.length() - 1 - i))
            }
        }
        local unwind = l.b.stmtList(&pads)
        (*f).unwindFirst = unwind.0
        (*f).unwindCount = unwind.1
        if item >= 0 {
            local it = l.s.items.get(item as usize)
            (*f).exported = (*it).exported != 0 || (*it).exportC != 0 || (*it).registered != 0
            (*f).exportC = (*it).exportC != 0
            (*f).registered = (*it).registered != 0
            (*f).isEntry = l.s.text((*it).registerRole) == "entry"
            (*f).isInit = l.s.text((*it).registerRole) == "init"
            (*f).isFini = l.s.text((*it).registerRole) == "fini"
            // The role functions are set by the role pass before the bodies (roles.xl).
            if (*f).isInit {
                l.b.initFns.push(l.fnName.clone())
            }
            if (*f).isFini {
                l.b.finiFns.push(l.fnName.clone())
            }
        }
        l.b.addFn(f)
        l.scopes.pop()
    }

    /// Adds a local to the function under construction and returns its id.
export fn addLocal(l: *Lowerer, name: str, typeName: str) -> u32 {
        local id = l.fnLocals.length() as u32
        l.fnLocals.push(new XlcHirLocalRec(name, typeName))
        return id
    }

    /// A function with a body: parameters, prologue, the body statements and the drops.
export fn runFunction(l: *Lowerer, item: i32, d: *SDecl, qname: str, localName: str, owner: str) {
        local ret = l.typeName(resolve(l.s, (*d).ret))
        if (*d).hasRet == 0 { ret = String("void") }
        l.fnRetTy = (*d).hasRet == 0 ? l.s.types.makeVoid() : resolve(l.s, (*d).ret)
        beginFunction(l, qname, localName, owner, ret.asStr())
        // The parameters, in order; a `self` first when the owner is a class.
        if owner.len > 0 {
            local selfTy = format("*{}", owner)
            local id = addLocal(l, "self", selfTy.asStr())
            l.selfLocal = id
            l.hasSelf = true
            l.fnParamCount = l.fnParamCount + 1
            local e = new ScopeEntry()
            (*e).kind = SE_LOCAL
            (*e).name = String("self")
            (*e).ty = classSelfType(l.s, owner)
            (*e).localId = id
            l.scopes.declare(e)
        }
        for i in 0..(*d).paramsCount as usize {
            local p = l.s.paramAt((*d).paramsFirst as usize + i)
            if (*p).isSelf != 0 { continue }
            local ty = l.typeName(resolve(l.s, (*p).ty))
            local id = addLocal(l, l.s.text((*p).name), ty.asStr())
            l.fnParamCount = l.fnParamCount + 1
            local e = new ScopeEntry()
            (*e).kind = SE_LOCAL
            (*e).name = String(l.s.text((*p).name))
            (*e).ty = resolve(l.s, (*p).ty)
            (*e).localId = id
            l.scopes.declare(e)
        }
        // The body.
        if (*d).hasBody != 0 && (*d).body >= 0 {
            local body = lowerBlockInto(l, (*d).body)
            // The `defer` flags are declared before the first statement (C++ function.cpp).
            for i in 0..l.fnFlags.length() {
                l.fnBody.push(l.b.localStmt(*l.fnFlags.get(i), "", "bool", l.b.boolConst(false, "bool")))
            }
            for i in 0..body.length() {
                l.fnBody.push(*body.get(i))
            }
        }
        endFunction(l, item)
    }

    /// A top-level function or a class method: dispatches on the declaration.
export fn runFunctionDecl(l: *Lowerer, item: i32, declIdx: i32, qname: str, localName: str, owner: str) {
        runFunction(l, item, l.s.declAt(declIdx as usize), qname, localName, owner)
    }

    /// The statements of block `blockIdx` lowered into a new list.
export fn lowerBlockInto(l: *Lowerer, blockIdx: i32) -> Vec<i32> {
        l.scopes.push()
        l.defers.push(Vec<i32>())
        local out = lowerStatements(l, blockIdx)
        // Falling off the end runs the block's defers; a jump already ran them (C++ lowerBlock).
        if !endsInJump(l, &out) {
            emitDefers(l, l.defers.length() - 1, &out)
        }
        l.defers.pop()
        l.scopes.pop()
        return out
    }

    /// The statements of a block in the current scope, without a defer frame of its own (the
    /// `try` body runs its leave call as its frame's defer, so it lowers its list directly).
export fn lowerStatements(l: *Lowerer, blockIdx: i32) -> Vec<i32> {
        local out = Vec<i32>()
        local blk = l.s.blockAt(blockIdx)
        local count = (*blk).stmtsCount
        local first = (*blk).stmtsFirst
        for i in 0..count as usize {
            local idx = l.s.stmtIndexOf(first + i as u32)
            local st = lowerStmt(l, idx)
            for e in 0..l.emitted.length() {
                out.push(*l.emitted.get(e))
            }
            l.emitted = Vec<i32>()
            if st >= 0 { out.push(st) }
        }
        return out
    }

    /// The deferred statements of the frames from `from` up, innermost frame first and each
    /// frame's defers newest first, appended to `out` (C++ emitDefers).
export fn emitDefers(l: *Lowerer, start: usize, out: *Vec<i32>) {
        local n = l.defers.length() - start
        for k in 0..n {
            local frame = l.defers.get(l.defers.length() - 1 - k)
            for i in 0..(*frame).length() {
                (*out).push(*(*frame).get((*frame).length() - 1 - i))
            }
        }
    }

    /// Lowers one statement and returns its index, or -1 for nothing.
export fn lowerStmt(l: *Lowerer, idx: i32) -> i32 {
        local st = l.s.stmtAt(idx)
        if (*st).kind == XS_LOCAL {
            return lowerLet(l, idx)
        }
        if (*st).kind == XS_CONST {
            return lowerLocalConst(l, idx)
        }
        if (*st).kind == XS_EXPR {
            local value = lowerExpr(l, (*st).expr)
            if value < 0 { return -1 }
            // An expression statement: the value is discarded.
            return l.b.exprStmt(value)
        }
        if (*st).kind == XS_RETURN {
            local value = -1
            if (*st).expr >= 0 {
                value = lowerExprAs(l, (*st).expr, l.fnRetTy)
            }
            // With defers pending, the value is computed first, into `$retN`, and then the
            // defers run (C++ statement.cpp, Return).
            local pending = false
            for f in 0..l.defers.length() {
                if (*l.defers.get(f)).length() > 0 { pending = true }
            }
            if pending {
                if value >= 0 {
                    local tyName = typeNameOf(l, l.fnRetTy)
                    local keep = hiddenLocal(l, "ret", tyName)
                    l.emitted.push(l.b.localStmt(keep, "", tyName, value))
                    value = l.b.localRef(keep, tyName)
                }
                emitDefers(l, 0, &l.emitted)
            }
            return l.b.returnStmt(value)
        }
        if (*st).kind == XS_IF {
            local cond = lowerExpr(l, (*st).expr)
            local body = lowerBlockInto(l, (*st).body)
            local elseBody = Vec<i32>()
            if (*st).elseBody >= 0 {
                elseBody = lowerBlockInto(l, (*st).elseBody)
            }
            return l.b.ifStmt(cond, body, elseBody)
        }
        if (*st).kind == XS_WHILE {
            local cond = lowerExpr(l, (*st).expr)
            local body = loopBody(l, l.s.flat.strOf((*st).label), (*st).body)
            return l.b.whileStmt(cond, body, false)
        }
        if (*st).kind == XS_BREAK || (*st).kind == XS_CONTINUE {
            local depth = jumpDepth(l, l.s.flat.strOf((*st).name))
            if depth < 0 {
                reportJump(l, (*st).span, (*st).kind == XS_BREAK, l.s.flat.strOf((*st).name))
                return -1
            }
            // The defers of the loop body and the blocks inside it run before the jump.
            local target = l.loops.length() - 1 - depth as usize
            emitDefers(l, *l.loopMarks.get(target) as usize, &l.emitted)
            return (*st).kind == XS_BREAK ? l.b.breakStmt(depth as u32) : l.b.continueStmt(depth as u32)
        }
        if (*st).kind == XS_BLOCK {
            local body = lowerBlockInto(l, (*st).body)
            return l.b.blockStmt(body)
        }
        if (*st).kind == XS_UNSAFE {
            // Inside `unsafe { }` a signedness change converts (C++ Stmt::Kind::Unsafe).
            l.unsafeDepth += 1
            local body = lowerBlockInto(l, (*st).body)
            l.unsafeDepth -= 1
            return l.b.blockStmt(body)
        }
        if (*st).kind == XS_ASSIGN {
            return lowerAssign(l, st)
        }
        if (*st).kind == XS_FOR {
            return lowerCFor(l, st)
        }
        if (*st).kind == XS_FOR_RANGE {
            return lowerForRange(l, idx, st)
        }
        if (*st).kind == XS_SWITCH {
            return lowerSwitch(l, idx, st)
        }
        if (*st).kind == XS_DEFER {
            return lowerDefer(l, st)
        }
        if (*st).kind == XS_TRY {
            return lowerTry(l, st)
        }
        if (*st).kind == XS_DO_WHILE {
            // The condition is lowered after the body, as the C++ pass does.
            local body = loopBody(l, l.s.flat.strOf((*st).label), (*st).body)
            local cond = lowerExpr(l, (*st).expr)
            return l.b.whileStmt(cond, body, true)
        }
        if (*st).kind == XS_DELETE {
            // `delete p`: drop the value, then free. The registered free function.
            local p = lowerExpr(l, (*st).expr)
            local args = Vec<i32>()
            args.push(p)
            local range = l.b.args(args)
            return l.b.exprStmt(l.b.call(l.b.freeFunction.asStr(), range.0, range.1, "void"))
        }
        l.err("E0500", (*st).span, "this statement form is not lowered yet",
            "the xlang lowering pass is still being ported")
        return -1
    }

    /// A `let`: the local, its optional initializer and the binding.
export fn lowerLet(l: *Lowerer, idx: i32) -> i32 {
        local st = l.s.stmtAt(idx)
        if (*st).namesCount > 0 { return lowerTupleLocal(l, idx) }
        local name = l.s.stmtTextAt(idx)
        // The declared type, resolved; without one, the type of the initializer.
        local declared = -1
        if (*st).hasType != 0 && (*st).typeIdx >= 0 {
            declared = resolve(l.s, l.s.types.internAst((*st).typeIdx))
        }
        local value = -1
        local vty = declared
        if (*st).expr >= 0 {
            value = lowerExprAs(l, (*st).expr, declared)
            if vty < 0 { vty = effectiveType(l, (*st).expr, -1) }
        }
        local tyName = vty < 0 ? "void" : l.keep(l.s.types.text(vty).asStr())
        local id = addLocal(l, name, tyName)
        local e = new ScopeEntry()
        (*e).kind = SE_LOCAL
        (*e).name = String(name)
        (*e).ty = vty
        (*e).localId = id
        l.scopes.declare(e)
        return l.b.localStmt(id, name, tyName, value)
    }

/// `local (a, b) = expr` (C++ stmt/tuple.cpp): the tuple is held once in the hidden local `$tupleN`
/// and each name is a local that reads its element. The hold and every name but the last go to
/// `emitted` (before the statement); the last name's local is the statement returned.
fn lowerTupleLocal(l: *Lowerer, idx: i32) -> i32 {
        local st = l.s.stmtAt(idx)
        if (*st).expr < 0 {
            l.err("E0708", (*st).span, "a tuple target needs an initializer", "write `local (a, b) = expr`")
            return -1
        }
        local value = lowerExprWant(l, (*st).expr, -1)
        local tupleTy = exprType(l, (*st).expr)
        if value < 0 || tupleTy < 0 { return -1 }
        if l.s.types.get(tupleTy).kind != T_TUPLE {
            local shown = l.s.types.text(tupleTy)
            l.err("E0708", (*l.s.exprAt((*st).expr)).span,
                format("cannot take `{}` apart: it is not a tuple", shown.asStr()).asStr(),
                "a tuple target needs a tuple value on the right")
            return -1
        }
        local count = l.s.types.get(tupleTy).argsCount
        if count != (*st).namesCount {
            l.err("E0708", (*st).span,
                format("the tuple target names {} variable(s), the value has {}", (*st).namesCount, count).asStr(),
                "write one name per tuple element")
            return -1
        }
        local tupleName = typeNameOf(l, tupleTy)
        local hold = hiddenLocal(l, "tuple", tupleName)
        local holdName = format("$tuple{}", l.hiddenCount - 1)
        l.emitted.push(l.b.localStmt(hold, holdName.asStr(), tupleName, value))
        local last = -1
        for i in 0..(*st).namesCount as usize {
            local name = l.s.flat.strOf(l.s.flat.pathSeg((*st).namesFirst + i as u32))
            local elemTy = (l.s.types.get(tupleTy).argsFirst + i as u32) as i32
            local elemName = typeNameOf(l, elemTy)
            local field = l.b.field(l.b.localRef(hold, tupleName), "", elemName, false, i as u32)
            local id = addLocal(l, name, elemName)
            local decl = l.b.localStmt(id, name, elemName, field)
            bindLocal(l, name, id, elemTy)
            if last >= 0 { l.emitted.push(last) }
            last = decl
        }
        return last
    }

/// `const NAME = expr` or `const NAME: T = expr` in a body (C++ global.cpp, lowerLocalConst): the
/// value becomes a private global named `fn$NAME$N` (N is the hidden counter, shared with the
/// hidden locals) and the name is bound to it in the scope. The statement adds nothing to the block.
fn lowerLocalConst(l: *Lowerer, idx: i32) -> i32 {
        local st = l.s.stmtAt(idx)
        local name = l.s.stmtTextAt(idx)
        local t = -1
        local value = -1
        if (*st).hasType != 0 {
            t = resolve(l.s, l.s.types.internAst((*st).typeIdx))
            value = lowerExprAs(l, (*st).expr, t)
        } else {
            value = lowerExprWant(l, (*st).expr, -1)
            if value >= 0 { t = exprType(l, (*st).expr) }
        }
        // The initializer of a `const` must be a compile-time constant (E0715); otherwise the
        // global has no initializer.
        if value >= 0 {
            local off = -1
            if !isConstValue(l, value, &off) {
                local at = (*l.b.exprAt(off >= 0 ? off : value)).span
                l.s.diag.error("E0715", at, "`const` initializer is not a compile-time constant",
                    "a `const` holds literals, arithmetic on them, arrays and struct literals; it cannot call functions or read other names")
                value = -1
            }
        }
        local gname = format("{}${}${}", l.fnName.asStr(), name, l.hiddenCount)
        l.hiddenCount = l.hiddenCount + 1
        local rec = new XlcHirGlobalRec(gname.asStr(), typeNameOf(l, t))
        (*rec).constant = true
        if value >= 0 { (*rec).init = value }
        l.b.globals.push(rec)
        local e = new ScopeEntry()
        (*e).kind = SE_GLOBAL
        (*e).name = String(name)
        (*e).ty = t
        (*e).span = l.s.span((*st).span)
        (*e).qname = gname.clone()
        (*e).readonly = true
        if !l.scopes.declare(e) {
            local first = (*l.scopes.lookup(name)).span
            reportTwoSites(l, "E0401", format("`{}` is defined twice in this scope", name).asStr(),
                first, "first definition", l.s.span((*st).span), "second definition",
                "rename one of them")
        }
        return -1
    }

    /// Lowers one expression and returns its HIR index, or -1.
export fn lowerExpr(l: *Lowerer, idx: i32) -> i32 {
        return lowerExprWant(l, idx, -1)
    }

    /// Lowers `idx` where the context expects type `want` (a Types index, -1 for none), then
    /// converts the value to `want` the way the C++ `coerce` does.
export fn lowerExprAs(l: *Lowerer, idx: i32, want: i32) -> i32 {
        return coerceTo(l, idx, lowerExprWant(l, idx, want), want)
    }

    /// Lowers `idx` with the context type `want` (-1 for none). An unsuffixed literal takes the
    /// type it is given: an integer one a float type too. The operators pass `want` on to the
    /// operands that are literals (see `lowerBinary`). The node it builds takes the span of `idx`;
    /// the operands are lowered inside, and each restores the span of its parent.
export fn lowerExprWant(l: *Lowerer, idx: i32, want: i32) -> i32 {
        if idx < 0 { return -1 }
        local saved = l.b.span
        l.b.span = l.s.span((*l.s.exprAt(idx)).span)
        local v = lowerExprNode(l, idx, want)
        l.b.span = saved
        return v
    }

    /// The expression walk of `lowerExprWant` (the node kinds, one branch each).
fn lowerExprNode(l: *Lowerer, idx: i32, want: i32) -> i32 {
        local e = l.s.exprAt(idx)
        if (*e).kind == XE_INT_LITERAL {
            if want >= 0 && isFloatType(l, want) {
                return l.b.floatConst((*e).intValue as f64, typeNameOf(l, want))
            }
            if want >= 0 && isIntType(l, want) {
                return l.b.intConst((*e).intValue, typeNameOf(l, want))
            }
            return l.b.intConst((*e).intValue, exprTypeName(l, idx))
        }
        if (*e).kind == XE_FLOAT_LITERAL {
            local ft = want >= 0 && isFloatType(l, want) ? typeNameOf(l, want) : "f64"
            return l.b.floatConst((*e).floatValue, ft)
        }
        if (*e).kind == XE_BOOL_LITERAL {
            return l.b.boolConst((*e).boolValue != 0, exprTypeName(l,idx))
        }
        if (*e).kind == XE_STRING_LITERAL {
            return l.b.strConst(l.s.exprTextAt(idx), exprTypeName(l,idx))
        }
        if (*e).kind == XE_BYTE_LITERAL {
            return l.b.intConst((*e).intValue, exprTypeName(l,idx))
        }
        if (*e).kind == XE_NAME {
            return lowerName(l, idx)
        }
        if (*e).kind == XE_BINARY {
            return lowerBinary(l, idx, e, want)
        }
        if (*e).kind == XE_UNARY {
            // A negative literal takes the context type; the other operators do not pass it on.
            local lhs = lowerExprWant(l, (*e).lhs, (*e).unaryOp == XU_NEG ? want : -1)
            if (*e).unaryOp == XU_DEREF {
                if !checkDeref(l, e) { return -1 }
                return l.b.deref(lhs, exprTypeName(l, idx))
            }
            if (*e).unaryOp == XU_ADDROF {
                return l.b.addrOf(lhs, exprTypeName(l, idx))
            }
            return l.b.unary(unaryOpName((*e).unaryOp), lhs, typeNameOf(l, effectiveType(l, idx, want)))
        }
        if (*e).kind == XE_CAST {
            local value = lowerExpr(l, (*e).lhs)
            local to = resolve(l.s, l.s.types.internAst((*e).typeIdx))
            if !checkCast(l, idx, exprType(l, (*e).lhs), to) { return -1 }
            return l.b.cast(value, exprTypeName(l, idx), false)
        }
        if (*e).kind == XE_FIELD {
            // `Enum.Member` is the member's constant, typed as the enum (C++ fieldExpr).
            if (*l.s.exprAt((*e).lhs)).kind == XE_NAME {
                local en = l.s.exprTextAt((*e).lhs)
                local sym = l.s.find(en)
                if sym >= 0 && (*l.s.symbols.get(sym as usize)).kind == SY_ENUM {
                    local decl = l.s.declOfItem(l.s.itemOf(sym))
                    if decl < 0 { return -1 }
                    return l.b.intConst(enumMemberValue(l, l.s.declOf(decl), l.s.exprTextAt(idx)) as u64, en)
                }
            }
            local base = lowerExpr(l, (*e).lhs)
            // A field of a pointer is read through it (`field.ptr`); the index is the field's
            // position in its aggregate.
            if !checkField(l, idx, e) { return -1 }
            local bt = exprType(l, (*e).lhs)
            local viaPointer = bt >= 0 && l.s.types.get(bt).kind == T_POINTER
            local owner = resolveBase(l, bt)
            local fieldName = l.s.exprTextAt(idx)
            if fieldName == "len" && owner >= 0 && l.s.types.get(owner).kind == T_ARRAY {
                return lowerArrayLen(l, e, owner)
            }
            // A tuple element is named by its position, which the parser keeps in `intValue`.
            local index = fieldIndexOf(l, owner, fieldName)
            if owner >= 0 && l.s.types.get(owner).kind == T_TUPLE { index = (*e).intValue as u32 }
            return l.b.field(base, fieldName, exprTypeName(l, idx), viaPointer, index)
        }
        if (*e).kind == XE_INDEX {
            return lowerIndex(l, idx, e)
        }
        if (*e).kind == XE_SLICE {
            local base = lowerExpr(l, (*e).lhs)
            if !checkSlice(l, e) { return -1 }
            // The bounds are `usize`, as the C++ slice lowering converts them.
            local bounds = l.s.types.makeInt(0, false)
            local lo = -1
            if (*e).argsCount > 0 {
                lo = lowerExprAs(l, l.s.refAt("expr", (*e).argsFirst as i32), bounds)
            }
            local hi = lowerExprAs(l, (*e).rhs, bounds)
            local sl = l.b.slice(base, lo, hi, exprTypeName(l, idx))
            if l.checkedSafety { (*l.b.exprAt(sl)).checked = 1 }
            return sl
        }
        if (*e).kind == XE_ARRAY_LIST || (*e).kind == XE_TUPLE_LITERAL {
            local items = lowerArgList(l, e)
            if (*e).kind == XE_ARRAY_LIST {
                return l.b.arrayList(items, exprTypeName(l, idx))
            }
            return l.b.tupleLit(items, exprTypeName(l, idx))
        }
        if (*e).kind == XE_ARRAY_REPEAT {
            local value = lowerExpr(l, (*e).lhs)
            return l.b.arrayRepeat(value, (*e).intValue, "")
        }
        if (*e).kind == XE_STRUCT_LITERAL {
            return lowerStructLit(l, idx, e)
        }
        if (*e).kind == XE_NEW {
            return lowerNew(l, idx, e)
        }
        if (*e).kind == XE_TERNARY {
            local cond = lowerExpr(l, (*e).lhs)
            local thenValue = lowerExpr(l, (*e).rhs)
            local elseValue = lowerExpr(l, l.s.refAt("expr", (*e).argsFirst as i32))
            return l.b.select(cond, thenValue, elseValue, exprTypeName(l, idx))
        }
        if (*e).kind == XE_CALL {
            return lowerCall(l, idx)
        }
        l.err("E0500", (*e).span, "this expression form is not lowered yet",
            "the xlang lowering pass is still being ported")
        return -1
    }

    /// `base[i]` (as the C++ `indexExpr`): a `str`, slice or array index is bounds checked under
    /// `--safety=checked`; a pointer index is not.
export fn lowerIndex(l: *Lowerer, idx: i32, e: *XExpr) -> i32 {
        local base = lowerExpr(l, (*e).lhs)
        local sub = lowerExpr(l, (*e).rhs)
        if !checkIndex(l, e) { return -1 }
        local at = l.b.index(base, sub, exprTypeName(l, idx))
        local bt = exprType(l, (*e).lhs)
        local bk = bt < 0 ? -1 : l.s.types.get(bt).kind
        if l.checkedSafety && (bk == T_STR || bk == T_SLICE || bk == T_ARRAY) {
            (*l.b.exprAt(at)).checked = 1
        }
        return at
    }

    /// The value converted to type `want` (-1: no conversion). An implicit conversion is a cast
    /// marked implicit; a conversion the language does not allow is left as it is (the sema
    /// reports those, and the xlang sema does not report them yet).
export fn coerceTo(l: *Lowerer, idx: i32, value: i32, want: i32) -> i32 {
        if want < 0 || value < 0 { return value }
        local vt = effectiveType(l, idx, want)
        if vt < 0 || l.s.types.same(vt, want) { return value }
        return coerceChecked(l, idx, value, vt, want)
    }

    /// A binary operation, as the C++ `binaryExpr`: a literal operand takes the type of the other
    /// one, the numeric operands are converted to their common type, and the result is that type
    /// (`bool` for a comparison). `&&` and `||` take `bool` operands. A shift keeps the type of its
    /// left operand, and its count is converted to it.
export fn lowerBinary(l: *Lowerer, idx: i32, e: *XExpr, want: i32) -> i32 {
        return lowerBinaryOf(l, (*e).binaryOp, (*e).lhs, (*e).rhs, want)
    }

    /// `lhs op rhs` over two expression indices. A compound assignment `t op= v` lowers as the
    /// binary `t op v` (the C++ pass rewrites the AST the same way), so the operands are indices
    /// the caller picks.
export fn lowerBinaryOf(l: *Lowerer, op: i32, lhsExpr: i32, rhsExpr: i32, want: i32) -> i32 {
        local boolT = l.s.types.makeBool()
        if op == XB_AND || op == XB_OR {
            local andLhs = lowerExprAs(l, lhsExpr, boolT)
            local andRhs = lowerExprAs(l, rhsExpr, boolT)
            return l.b.binary(binaryOpName(op), andLhs, andRhs, "bool")
        }
        local isCmp = op >= XB_EQ && op <= XB_GE
        local hint = isCmp ? -1 : want
        local lhs = -1
        local rhs = -1
        local lt = -1
        local rt = -1
        // A literal on the left takes the type of a non-literal right operand; otherwise the right
        // operand takes the type of a numeric left one.
        if isLiteralExpr(l, lhsExpr) && (!isLiteralExpr(l, rhsExpr) || isFloatLiteralExpr(l, rhsExpr)) {
            rhs = lowerExprWant(l, rhsExpr, hint)
            rt = effectiveType(l, rhsExpr, hint)
            lhs = lowerExprWant(l, lhsExpr, rt)
            lt = effectiveType(l, lhsExpr, rt)
        } else {
            lhs = lowerExprWant(l, lhsExpr, hint)
            lt = effectiveType(l, lhsExpr, hint)
            local rightHint = isNumeric(l, lt) ? lt : hint
            rhs = lowerExprWant(l, rhsExpr, rightHint)
            rt = effectiveType(l, rhsExpr, rightHint)
        }
        if op == XB_SHL || op == XB_SHR {
            if !l.s.types.same(lt, rt) {
                rhs = l.b.cast(rhs, typeNameOf(l, lt), false)
            }
            return l.b.binary(binaryOpName(op), lhs, rhs, typeNameOf(l, lt))
        }
        local common = -1
        if isNumeric(l, lt) && isNumeric(l, rt) {
            local c = commonBinaryType(l.s.types, lt, rt, l.s.pointerBits)
            if c.status == C_OK {
                common = c.ty
                if !l.s.types.same(lt, common) { lhs = l.b.cast(lhs, typeNameOf(l, common), true) }
                if !l.s.types.same(rt, common) { rhs = l.b.cast(rhs, typeNameOf(l, common), true) }
            }
        } else if isCmp {
            common = lt
        }
        return l.b.binary(binaryOpName(op), lhs, rhs, typeNameOf(l, isCmp ? boolT : common))
    }

    /// A name: a local, a global, a function or a constant.
export fn lowerName(l: *Lowerer, idx: i32) -> i32 {
        local name = l.s.exprTextAt(idx)
        local entry = l.lookupName(name)
        if entry == nil {
            // `nil` with no binding of that name is the null pointer, typed `*void` (C++ nameExpr).
            if name == "nil" { return l.b.nil("*void") }
            l.err("E0706", (*l.s.exprAt(idx)).span,
                format("unknown name `{}`", name).asStr(), "not found in any scope")
            return -1
        }
        local tyName = exprTypeName(l,idx)
        if (*entry).kind == SE_LOCAL {
            return l.b.localRef((*entry).localId, tyName)
        }
        if (*entry).kind == SE_GLOBAL {
            return l.b.globalRef((*entry).qname.asStr(), tyName)
        }
        if (*entry).kind == SE_FUNCTION {
            return l.b.funcRef((*entry).qname.asStr(), tyName)
        }
        if (*entry).kind == SE_CONSTANT {
            // A define constant folds to its value.
            local value = l.constOfName(name)
            if value >= 0 {
                local cv = *l.s.consts.get(value as usize)
                return l.b.intConst((*cv).intValue.lo, tyName)
            }
        }
        l.err("E0706", (*l.s.exprAt(idx)).span,
            format("`{}` has no lowered form here", name).asStr(), "not a value")
        return -1
    }

/// The statements of the single-statement block or statement `idx`, as a list.
export fn lowerStmtList(l: *Lowerer, idx: i32) -> Vec<i32> {
    local out = Vec<i32>()
    if idx < 0 { return out }
    local st = lowerStmt(l, idx)
    if st >= 0 { out.push(st) }
    return out
}

/// The body of a loop labeled `label` ("" for none): lowered with the loop on the loop stack, so
/// a `break` or `continue` in it finds its target.
export fn loopBody(l: *Lowerer, label: str, block: i32) -> Vec<i32> {
        l.loops.push(String(label))
        l.loopMarks.push(l.defers.length() as i32)
        local body = lowerBlockInto(l, block)
        l.loopMarks.pop()
        l.loops.pop()
        return body
    }

    /// The `depth` of a `break` or `continue`: the number of loops it leaves, 0 for the innermost.
    /// A label names an enclosing loop; -1 when there is no loop, or none with that label.
export fn jumpDepth(l: *Lowerer, label: str) -> i32 {
        local n = l.loops.length()
        if n == 0 { return -1 }
        if label.len == 0 { return 0 }
        for i in 0..n {
            if (*l.loops.get(n - 1 - i)).asStr() == label { return i as i32 }
        }
        return -1
    }

    /// The E0709 of a jump with no loop to target (C++ `lowerJump`).
export fn reportJump(l: *Lowerer, at: XSpan, isBreak: bool, label: str) {
        local word = isBreak ? "break" : "continue"
        if l.loops.length() == 0 {
            l.err("E0709", at, format("`{}` outside of a loop", word).asStr(), "there is no enclosing loop")
            return
        }
        l.err("E0709", at, format("no enclosing loop is labeled `{}`", label).asStr(),
            "write `label: while ...` on the loop first")
    }

    /// A `local` of a compiler-made name: the next `$<prefix><n>` (the C++ `hiddenLocal`).
export fn hiddenLocal(l: *Lowerer, prefix: str, typeName: str) -> u32 {
        local name = format("${}{}", prefix, l.hiddenCount)
        l.hiddenCount = l.hiddenCount + 1
        return addLocal(l, name.asStr(), typeName)
    }

    /// Declares the name `name` in the current scope as the local `id` of type `ty`.
export fn bindLocal(l: *Lowerer, name: str, id: u32, ty: i32) {
        local e = new ScopeEntry()
        (*e).kind = SE_LOCAL
        (*e).name = String(name)
        (*e).ty = ty
        (*e).localId = id
        l.scopes.declare(e)
    }

    /// `target = value`, or for a compound `target op= value` the assignment of the binary
    /// `target op value` (the target is lowered twice, as the C++ pass clones its AST).
fn lowerAssign(l: *Lowerer, st: *XStmt) -> i32 {
        local want = exprType(l, (*st).target)
        local target = lowerExpr(l, (*st).target)
        local value = -1
        if (*st).hasCompoundOp != 0 {
            value = lowerBinaryOf(l, (*st).compoundOp, (*st).target, (*st).expr, want)
        } else {
            value = lowerExprAs(l, (*st).expr, want)
        }
        return l.b.assign(target, value)
    }

/// A C-style `for`: a block holding the initializer and a `while` whose step runs after the body
/// (the C++ pass keeps the step apart and the flat form does the same; the walker of the codegen
/// runs it under every `continue`).
export fn lowerCFor(l: *Lowerer, st: *XStmt) -> i32 {
        l.scopes.push()
        local inner = Vec<i32>()
        if (*st).init >= 0 {
            local init = lowerStmt(l, (*st).init)
            if init >= 0 { inner.push(init) }
        }
        local cond = (*st).expr >= 0 ? lowerExpr(l, (*st).expr) : l.b.boolConst(true, "bool")
        local body = loopBody(l, l.s.flat.strOf((*st).label), (*st).body)
        local loop = l.b.whileStmt(cond, body, false)
        if (*st).step >= 0 {
            local step = Vec<i32>()
            local s = lowerStmt(l, (*st).step)
            if s >= 0 { step.push(s) }
            l.b.setStep(loop, step)
        }
        inner.push(loop)
        l.scopes.pop()
        return l.b.blockStmt(inner)
    }

/// `for i in lo..hi` (or `..=`): a block holding the counter `i` (the lower bound), a hidden
/// `$endN` (the upper bound, read once) and a `while i < $endN` whose step is `i = i + 1`. An
/// untyped literal bound takes the type of the other one (C++ `lowerForRange`).
export fn lowerForRange(l: *Lowerer, idx: i32, st: *XStmt) -> i32 {
        local name = l.s.stmtTextAt(idx)
        local lo = (*st).expr
        local hi = (*st).expr2
        local hint = -1
        if isLiteralExpr(l, lo) && !isLiteralExpr(l, hi) {
            local probe = exprType(l, hi)
            if probe >= 0 && isIntType(l, probe) { hint = probe }
        }
        l.scopes.push()
        local loValue = lowerExprWant(l, lo, hint)
        local t = effectiveType(l, lo, hint)
        local tyName = typeNameOf(l, t)
        local hiValue = lowerExprWant(l, hi, t)
        local hiCoerced = coerceTo(l, hi, hiValue, t)
        local endName = format("$end{}", l.hiddenCount)
        local counter = addLocal(l, name, tyName)
        local end = hiddenLocal(l, "end", tyName)
        bindLocal(l, name, counter, t)
        local inner = Vec<i32>()
        inner.push(l.b.localStmt(counter, name, tyName, loValue))
        inner.push(l.b.localStmt(end, endName.asStr(), tyName, hiCoerced))
        local cmp = l.b.binary((*st).rangeInclusive != 0 ? "<=" : "<",
            l.b.localRef(counter, tyName), l.b.localRef(end, tyName), "bool")
        local body = loopBody(l, l.s.flat.strOf((*st).label), (*st).body)
        local loop = l.b.whileStmt(cmp, body, false)
        local inc = l.b.binary("+", l.b.localRef(counter, tyName), l.b.intConst(1, tyName), tyName)
        local step = Vec<i32>()
        step.push(l.b.assign(l.b.localRef(counter, tyName), inc))
        l.b.setStep(loop, step)
        inner.push(loop)
        l.scopes.pop()
        return l.b.blockStmt(inner)
    }

/// A `case` value `v` that is a constant an earlier `case` of the same switch already handles is
/// E0709 at the value (C++ stmt/switch.cpp). `seen` holds the low 64 bits of the constants so far.
fn checkCaseValue(l: *Lowerer, v: i32, seen: *Vec<u64>) {
    local cv = evalConst(l.s, v)
    if cv < 0 || (*l.s.consts.get(cv as usize)).kind != CV_INT { return }
    local key = (*l.s.consts.get(cv as usize)).intValue.lo
    for i in 0..(*seen).length() {
        if *(*seen).get(i) == key {
            l.err("E0709", (*l.s.exprAt(v)).span, "duplicate `case` value",
                "this value is already handled by an earlier `case`")
            return
        }
    }
    (*seen).push(key)
}

/// A `switch`: an if/else chain over the case values; the default case is the last `else`.
export fn lowerSwitch(l: *Lowerer, idx: i32, st: *XStmt) -> i32 {
    if (*st).expr < 0 {
        return lowerConditionSwitch(l, st)
    }
    // `switch` on an integer, bool or enum: the subject is a hidden local `$swN`, and each case
    // is `$swN == v || ...` (C++ stmt/switch.cpp). Sum types are not ported yet.
    local t = exprType(l, (*st).expr)
    local k = t < 0 ? -1 : l.s.types.get(t).kind
    if k != T_INT && k != T_BOOL && k != T_ENUM {
        l.err("E0500", (*st).span, "this `switch` form is not lowered yet",
            "switch on integers, bools and enums only, for now")
        return -1
    }
    local tyName = typeNameOf(l, t)
    l.scopes.push()
    local value = lowerExprWant(l, (*st).expr, -1)
    local subject = hiddenLocal(l, "sw", tyName)
    local inner = Vec<i32>()
    inner.push(l.b.localStmt(subject, format("$sw{}", l.hiddenCount - 1).asStr(), tyName, value))
    local conds = Vec<i32>()
    local bodies = Vec<Vec<i32>>()
    local defaultBody = Vec<i32>()
    local seen = Vec<u64>()
    local hasDefault = false
    for i in 0..(*st).casesCount as usize {
        local c = l.s.flat.caseAt(((*st).casesFirst + i as u32) as i32)
        if (*c).isDefault != 0 {
            if hasDefault {
                l.err("E0709", (*c).span, "a `switch` has more than one `default`", "remove the duplicate")
            }
            hasDefault = true
            defaultBody = lowerBlockInto(l, (*c).body)
            continue
        }
        if (*c).valuesCount == 0 {
            l.err("E0709", (*c).span, "`case` needs at least one value", "write `case 1, 2 { ... }`")
        }
        for j in 0..(*c).valuesCount as usize {
            checkCaseValue(l, l.s.refAt("expr", ((*c).valuesFirst + j as u32) as i32), &seen)
        }
        local cond = -1
        for j in 0..(*c).valuesCount as usize {
            local v = l.s.refAt("expr", ((*c).valuesFirst + j as u32) as i32)
            local eq = l.b.binary("==", l.b.localRef(subject, tyName), lowerExprWant(l, v, t), "bool")
            cond = cond < 0 ? eq : l.b.binary("||", cond, eq, "bool")
        }
        local body = lowerBlockInto(l, (*c).body)
        // A case with no value was reported above; its body is checked and its arm is dropped.
        if cond < 0 { continue }
        conds.push(cond)
        bodies.push(body)
    }
    local chain = switchChain(l, &conds, &bodies, &defaultBody)
    for i in 0..chain.length() {
        inner.push(*chain.get(i))
    }
    l.scopes.pop()
    return l.b.blockStmt(inner)
}

/// `defer stmt` (C++ statement.cpp, Defer): the statement runs under a flag that the defer sets
/// here, so a panic that unwinds runs only the defers reached. The guard `if $dfrN { $dfrN = false;
/// stmt }` goes to the innermost block's frame (run at its end and at every jump out of it) and
/// to the unwind list. The flag is declared at the head of the function.
fn lowerDefer(l: *Lowerer, st: *XStmt) -> i32 {
        local inner = (*st).step
        local k = (*l.s.stmtAt(inner)).kind
        if k == XS_RETURN || k == XS_BREAK || k == XS_CONTINUE || k == XS_DEFER || k == XS_LOCAL || k == XS_CONST {
            l.err("E0709", (*st).span, "this statement cannot be deferred",
                "a `defer` runs when the block is left; it cannot return, jump, declare a variable or defer again")
            return -1
        }
        local flag = hiddenLocal(l, "dfr", "bool")
        l.fnFlags.push(flag)
        local lowered = lowerStmt(l, inner)
        local body = Vec<i32>()
        body.push(l.b.assign(l.b.localRef(flag, "bool"), l.b.boolConst(false, "bool")))
        for e in 0..l.emitted.length() {
            body.push(*l.emitted.get(e))
        }
        l.emitted = Vec<i32>()
        if lowered >= 0 { body.push(lowered) }
        local guard = l.b.ifStmt(l.b.localRef(flag, "bool"), body, Vec<i32>())
        l.fnUnwind.push(guard)
        (*l.defers.get(l.defers.length() - 1)).push(guard)
        return l.b.assign(l.b.localRef(flag, "bool"), l.b.boolConst(true, "bool"))
    }

/// `try { } catch e { }` (C++ stmt/try_catch.cpp): two hidden locals, the snapshot the unwinder
/// fills and the message buffer; the body ends with the call that leaves the snapshot (`unwind`
/// with op 0), and the handler binds `e` to the message. Needs the registered `unwind` role.
fn lowerTry(l: *Lowerer, st: *XStmt) -> i32 {
        if l.b.unwindFunction.asStr().len == 0 {
            l.err("E0501", (*st).span, "`try` has no registered `unwind` function",
                "register one with `register(unwind) fn ...`, or import a library that does")
            return -1
        }
        local snapTy = "[usize; 32]"
        local msgTy = "[u8; 256]"
        local snap = hiddenLocal(l, "snap", snapTy)
        local msg = hiddenLocal(l, "msg", msgTy)
        // The body runs in a frame whose only defer is the leave call (C++ try_catch.cpp).
        local leaveArgs = Vec<i32>()
        leaveArgs.push(l.b.intConst(0, "i32"))
        local addr = l.b.addrOf(l.b.localRef(snap, snapTy), "*[usize; 32]")
        leaveArgs.push(l.b.cast(addr, "*usize", false))
        leaveArgs.push(l.b.nil("*u8"))
        local range = l.b.args(leaveArgs)
        local leave = l.b.exprStmt(l.b.call(l.b.unwindFunction.asStr(), range.0, range.1, "void"))
        l.scopes.push()
        l.defers.push(Vec<i32>())
        (*l.defers.get(l.defers.length() - 1)).push(leave)
        local unwindFirst = l.fnUnwind.length()
        local body = lowerStatements(l, (*st).body)
        if !endsInJump(l, &body) {
            emitDefers(l, l.defers.length() - 1, &body)
        }
        l.defers.pop()
        l.scopes.pop()
        // The handler: the cleanups the body registered (newest first), then `e` as a `*u8`.
        l.scopes.push()
        local handler = Vec<i32>()
        for i in 0..l.fnUnwind.length() - unwindFirst {
            handler.push(*l.fnUnwind.get(l.fnUnwind.length() - 1 - i))
        }
        local name = l.s.flat.strOf((*st).name)
        if name.len > 0 {
            local id = addLocal(l, name, "*u8")
            bindLocal(l, name, id, l.s.types.makePointer(l.s.types.makeInt(8, false)))
            local value = l.b.cast(l.b.addrOf(l.b.localRef(msg, msgTy), "*[u8; 256]"), "*u8", false)
            handler.push(l.b.localStmt(id, name, "*u8", value))
        }
        if (*st).elseBody >= 0 {
            local rest = lowerBlockInto(l, (*st).elseBody)
            for i in 0..rest.length() {
                handler.push(*rest.get(i))
            }
        }
        l.scopes.pop()
        local t = l.b.tryStmt(body, handler, msg)
        (*l.b.stmtAt(t)).localId = snap
        // The two locals come before the `try` in the enclosing list (through `emitted`).
        l.emitted.push(l.b.localStmt(snap, "", snapTy, -1))
        l.emitted.push(l.b.localStmt(msg, "", msgTy, -1))
        return t
    }

/// True when the last statement of `list` leaves the block (return, break or continue).
fn endsInJump(l: *Lowerer, list: *Vec<i32>) -> bool {
        if (*list).length() == 0 { return false }
        local k = (*l.b.stmtAt(*(*list).get((*list).length() - 1))).kind
        return k == S_RETURN || k == S_BREAK || k == S_CONTINUE
    }

/// A subject-less `switch { case c { } default { } }`: the chain `if c { } else { }` over the
/// conditions, which are lowered as bool. A chain of one `if` is that `if`; the C++ pass splices
/// a longer chain into the enclosing list, which the lowering here does not do yet.
fn lowerConditionSwitch(l: *Lowerer, st: *XStmt) -> i32 {
    local boolT = l.s.types.makeBool()
    local conds = Vec<i32>()
    local bodies = Vec<Vec<i32>>()
    local defaultBody = Vec<i32>()
    for i in 0..(*st).casesCount as usize {
        local c = l.s.flat.caseAt(((*st).casesFirst + i as u32) as i32)
        if (*c).isDefault != 0 {
            defaultBody = lowerBlockInto(l, (*c).body)
            continue
        }
        local cond = -1
        for j in 0..(*c).valuesCount as usize {
            local v = l.s.refAt("expr", ((*c).valuesFirst + j as u32) as i32)
            local test = lowerExprAs(l, v, boolT)
            cond = cond < 0 ? test : l.b.binary("||", cond, test, "bool")
        }
        conds.push(cond)
        bodies.push(lowerBlockInto(l, (*c).body))
    }
    local chain = switchChain(l, &conds, &bodies, &defaultBody)
    if conds.length() > 0 {
        return *chain.get(0)
    }
    return l.b.blockStmt(chain)
}

/// The lowered argument expressions of a record's `argsFirst/argsCount` range, in order.
export fn lowerArgList(l: *Lowerer, e: *XExpr) -> Vec<i32> {
    local out = Vec<i32>()
    for i in 0..(*e).argsCount as usize {
        local a = l.s.refAt("expr", ((*e).argsFirst + i as u32) as i32)
        local v = lowerExpr(l, a)
        if v < 0 { continue }
        out.push(v)
    }
    return out
}

/// A struct literal: the field initializers in source order.
export fn lowerStructLit(l: *Lowerer, idx: i32, e: *XExpr) -> i32 {
    local agg = aggregateTypeOf(l, e)
    if !checkStructLit(l, e, agg) { return -1 }
    local tyName = typeNameOf(l, agg)
    local first = l.b.fieldInits.length() as u32
    lowerFieldInits(l, e, agg)
    local at = l.b.expr(E_STRUCT_LIT, tyName)
    local p = l.b.exprAt(at)
    (*p).fieldFirst = first
    (*p).fieldCount = l.b.fieldInits.length() as u32 - first
    return at
}

/// The field initializers of a struct literal or `new T { ... }` of the aggregate `agg`, in source
/// order (the C++ `lowerFields`): an unknown field is E0709 and its value is still lowered for its
/// own errors; a repeated field is E0709 and dropped; every other value is converted to the
/// declared type of its field.
fn lowerFieldInits(l: *Lowerer, e: *XExpr, agg: i32) {
    for i in 0..(*e).fieldsCount as usize {
        local f = l.s.flat.initAt(((*e).fieldsFirst + i as u32) as i32)
        local name = l.s.flat.strOf((*f).name)
        if !knownField(l, agg, name, (*f).span) {
            lowerExpr(l, (*f).value)
            continue
        }
        if !checkDuplicateInit(l, e, i as u32) { continue }
        local ft = fieldTypeOf(l, agg, name)
        local v = -1
        if ft >= 0 {
            v = lowerExprAs(l, (*f).value, ft)
        } else {
            v = lowerExpr(l, (*f).value)
        }
        if v < 0 { continue }
        local rec: XlcHirFieldInit
        rec.name = XlcHirStr { bytes: nil as *u8, len: 0 }
        rec.value = v
        l.b.fieldInits.push(rec)
        l.b.fieldName(l.b.fieldInits.length() as u32 - 1, name, fieldIndexOf(l, agg, name))
    }
}

/// `new T` / `new T { fields }` / `new T(args)`: the allocation, the init call and the fields.
export fn lowerNew(l: *Lowerer, idx: i32, e: *XExpr) -> i32 {
    local tyName = typeNameOf(l, aggregateTypeOf(l, e))
    local at = l.b.newExpr(format("*{}", tyName).asStr())
    local p = l.b.exprAt(at)
    // A class with an `init`: the call becomes the init function over the argument list.
    if (*e).hasCallArgs != 0 {
        local args = lowerArgList(l, e)
        local range = l.b.args(args)
        (*p).lhs = l.b.construct(format("{}.init", tyName).asStr(), Vec<i32>(), tyName)
        (*p).argFirst = range.0
        (*p).argCount = range.1
        return at
    }
    // The field initializers.
    local first = l.b.fieldInits.length() as u32
    lowerFieldInits(l, e, aggregateTypeOf(l, e))
    (*p).fieldFirst = first
    (*p).fieldCount = l.b.fieldInits.length() as u32 - first
    return at
}

