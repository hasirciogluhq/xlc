// Lowering of function bodies: parameters, locals, statements and the expression walk. The
// xlang source of sema/lower/item/function.cpp and the expr/ and stmt/ subtrees; this file
// grows as the lowering pass is ported.
from "std" import String, Vec, format
from "../hir/abi" import XlcHirLocal, XlcHirStr, XlcHirFieldInit, E_STRUCT_LIT
from "../lang/ast/ast" import XSpan, XE_INT_LITERAL, XE_FLOAT_LITERAL, XE_BOOL_LITERAL, XE_STRING_LITERAL,
    XE_BYTE_LITERAL, XE_NAME, XE_UNARY, XE_BINARY, XE_CALL, XE_INDEX, XE_SLICE, XE_FIELD,
    XE_CAST, XE_ARRAY_LIST, XE_ARRAY_REPEAT, XE_TUPLE_LITERAL, XE_STRUCT_LITERAL, XE_NEW,
    XE_TERNARY, XE_TRY, XE_CLOSURE,
    XS_LOCAL, XS_DELETE, XS_CONST, XS_ASSIGN, XS_RETURN, XS_EXPR, XS_IF, XS_WHILE, XS_DO_WHILE,
    XS_FOR, XS_FOR_RANGE, XS_FOR_PACK, XS_FOR_EACH, XS_SWITCH, XS_DEFER, XS_TRY, XS_CONTINUE,
    XS_BREAK, XS_UNSAFE, XS_BLOCK
from "../sema/sema" import Sema
from "../sema/item" import SDecl, SItem, SParam
from "../lang/ast/ast" import XStmt, XExpr, XU_NEG, XU_NOT, XU_DEREF, XU_ADDROF, XU_BITNOT,
    XB_ADD, XB_SUB, XB_MUL, XB_DIV, XB_MOD, XB_EQ, XB_NE, XB_LT, XB_LE, XB_GT, XB_GE,
    XB_AND, XB_OR, XB_BITAND, XB_BITOR, XB_BITXOR, XB_SHL, XB_SHR
from "../sema/types" import T_NAMED, T_POINTER, T_SLICE, T_ARRAY, T_STR
from "../sema/resolve" import resolve
from "./state" import Lowerer, ScopeEntry, ScopeStack, XlcHirLocalRec,
    SE_LOCAL, SE_GLOBAL, SE_FUNCTION, SE_CONSTANT, SE_TYPE, SE_NAMESPACE, SE_EXTERNAL
from "./builder" import FnBuild
from "./call" import lowerCall
from "./typing" import exprType, exprTypeName, isLiteralExpr, isFloatLiteralExpr, isNumeric,
    effectiveType, typeNameOf, isIntType, isFloatType, resolveBase, fieldIndexOf, aggregateTypeOf
from "../sema/conversion" import implicitConversion, commonBinaryType, C_OK, C_WARN
from "../sema/const_eval" import evalConst
from "../sema/layout_calc" import layoutOfName

/// The statement kinds of the flat AST (the `XS_*` constants of ast.xl, mirrored).
export fn lowerModuleTouch() { return }

/// A module-level function: the declaration comes from the item.
export fn lowerFunction(l: *Lowerer, item: i32, declIdx: i32, qname: str, localName: str,
                        owner: str) {
    runFunction(l, item, l.s.declOf(item), qname, localName, owner)
}

/// A class method: the declaration comes from the SDecl arena index.
export fn lowerFunctionDecl(l: *Lowerer, item: i32, declIdx: i32, qname: str, localName: str,
                            owner: str) {
    runFunctionDecl(l, item, declIdx, qname, localName, owner)
}

/// The initializer of a global: a constant expression folded to a literal.
export fn lowerConstInit(l: *Lowerer, exprIdx: i32, tyName: str) -> i32 {
    return runConstInit(l, exprIdx, tyName)
}

    /// Opens the function under construction: the header fields, the scope and the parameters.
export fn beginFunction(l: *Lowerer, qname: str, localName: str, owner: str, ret: str) {
        l.fnName = String(qname)
        l.fnSymbol = String("")
        l.fnRet = String(ret)
        l.fnLocals = Vec<*XlcHirLocalRec>()
        l.fnParamCount = 0
        l.fnBody = Vec<i32>()
        l.fnUnwind = Vec<i32>()
        l.prelude = Vec<i32>()
        l.currentClass = String(owner)
        l.hasSelf = false
        l.scopes.push()
    }

    /// Closes the function: appends its record to the builder and pops the scope.
export fn endFunction(l: *Lowerer, item: i32) {
        local f = new FnBuild(l.fnName.asStr())
        (*f).symbol = l.fnSymbol.clone()
        (*f).ret = l.fnRet.clone()
        for i in 0..l.fnLocals.length() {
            local lr = l.fnLocals.get(i)
            local rec: XlcHirLocal
            rec.name = l.b.str((*lr).name.asStr())
            rec.typeName = l.b.str((*lr).typeName.asStr())
            (*f).locals.push(rec)
        }
        (*f).paramCount = l.fnParamCount
        for i in 0..l.fnBody.length() {
            (*f).body.push(*l.fnBody.get(i))
        }
        for i in 0..l.fnUnwind.length() {
            (*f).unwind.push(*l.fnUnwind.get(i))
        }
        if item >= 0 {
            local it = l.s.items.get(item as usize)
            (*f).exported = (*it).exported != 0 || (*it).exportC != 0 || (*it).registered != 0
            (*f).exportC = (*it).exportC != 0
            (*f).registered = (*it).registered != 0
            (*f).isEntry = l.s.text((*it).registerRole) == "entry"
            (*f).isInit = l.s.text((*it).registerRole) == "init"
            (*f).isFini = l.s.text((*it).registerRole) == "fini"
            if (*f).isInit {
                l.b.initFns.push(l.fnName.clone())
            }
            if (*f).isFini {
                l.b.finiFns.push(l.fnName.clone())
            }
        }
        l.b.addFn(f)
        l.scopes.pop()
    }

    /// Adds a local to the function under construction and returns its id.
export fn addLocal(l: *Lowerer, name: str, typeName: str) -> u32 {
        local id = l.fnLocals.length() as u32
        l.fnLocals.push(new XlcHirLocalRec(name, typeName))
        return id
    }

    /// A function with a body: parameters, prologue, the body statements and the drops.
export fn runFunction(l: *Lowerer, item: i32, d: *SDecl, qname: str, localName: str, owner: str) {
        local ret = l.typeName(resolve(l.s, (*d).ret))
        if (*d).hasRet == 0 { ret = String("void") }
        l.fnRetTy = (*d).hasRet == 0 ? l.s.types.makeVoid() : resolve(l.s, (*d).ret)
        beginFunction(l, qname, localName, owner, ret.asStr())
        // The parameters, in order; a `self` first when the owner is a class.
        if owner.len > 0 {
            local selfTy = format("*{}", owner)
            local id = addLocal(l, "self", selfTy.asStr())
            l.selfLocal = id
            l.hasSelf = true
            l.fnParamCount = l.fnParamCount + 1
            local e = new ScopeEntry()
            (*e).kind = SE_LOCAL
            (*e).name = String("self")
            (*e).ty = -1
            (*e).localId = id
            l.scopes.declare(e)
        }
        for i in 0..(*d).paramsCount as usize {
            local p = l.s.paramAt((*d).paramsFirst as usize + i)
            if (*p).isSelf != 0 { continue }
            local ty = l.typeName(resolve(l.s, (*p).ty))
            local id = addLocal(l, l.s.text((*p).name), ty.asStr())
            l.fnParamCount = l.fnParamCount + 1
            local e = new ScopeEntry()
            (*e).kind = SE_LOCAL
            (*e).name = String(l.s.text((*p).name))
            (*e).ty = resolve(l.s, (*p).ty)
            (*e).localId = id
            l.scopes.declare(e)
        }
        // The body.
        if (*d).hasBody != 0 && (*d).body >= 0 {
            l.fnBody = lowerBlockInto(l, (*d).body)
        }
        endFunction(l, item)
    }

    /// A top-level function or a class method: dispatches on the declaration.
export fn runFunctionDecl(l: *Lowerer, item: i32, declIdx: i32, qname: str, localName: str, owner: str) {
        runFunction(l, item, l.s.declAt(declIdx as usize), qname, localName, owner)
    }

    /// The statements of block `blockIdx` lowered into a new list.
export fn lowerBlockInto(l: *Lowerer, blockIdx: i32) -> Vec<i32> {
        local out = Vec<i32>()
        local blk = l.s.blockAt(blockIdx)
        local count = (*blk).stmtsCount
        local first = (*blk).stmtsFirst
        l.scopes.push()
        for i in 0..count as usize {
            local idx = l.s.stmtIndexOf(first + i as u32)
            local st = lowerStmt(l, idx)
            if st >= 0 { out.push(st) }
        }
        l.scopes.pop()
        return out
    }

    /// Lowers one statement and returns its index, or -1 for nothing.
export fn lowerStmt(l: *Lowerer, idx: i32) -> i32 {
        local st = l.s.stmtAt(idx)
        if (*st).kind == XS_LOCAL {
            return lowerLet(l, idx)
        }
        if (*st).kind == XS_EXPR {
            local value = lowerExpr(l, (*st).expr)
            if value < 0 { return -1 }
            // An expression statement: the value is discarded.
            return l.b.exprStmt(value)
        }
        if (*st).kind == XS_RETURN {
            local value = -1
            if (*st).expr >= 0 {
                value = lowerExprAs(l, (*st).expr, l.fnRetTy)
            }
            return l.b.returnStmt(value)
        }
        if (*st).kind == XS_IF {
            local cond = lowerExpr(l, (*st).expr)
            local body = lowerBlockInto(l, (*st).body)
            local elseBody = Vec<i32>()
            if (*st).elseBody >= 0 {
                elseBody = lowerBlockInto(l, (*st).elseBody)
            }
            return l.b.ifStmt(cond, body, elseBody)
        }
        if (*st).kind == XS_WHILE {
            local cond = lowerExpr(l, (*st).expr)
            l.loopDepth = l.loopDepth + 1
            local body = lowerBlockInto(l, (*st).body)
            l.loopDepth = l.loopDepth - 1
            return l.b.whileStmt(cond, body, l.loopDepth as u32, false)
        }
        if (*st).kind == XS_BREAK {
            return l.b.breakStmt(l.loopDepth as u32)
        }
        if (*st).kind == XS_CONTINUE {
            return l.b.continueStmt(l.loopDepth as u32)
        }
        if (*st).kind == XS_BLOCK {
            local body = lowerBlockInto(l, (*st).body)
            return l.b.blockStmt(body)
        }
        if (*st).kind == XS_ASSIGN {
            local target = lowerExpr(l, (*st).target)
            local value = lowerExprAs(l, (*st).expr, exprType(l, (*st).target))
            return l.b.assign(target, value)
        }
        if (*st).kind == XS_FOR {
            return lowerCFor(l, st)
        }
        if (*st).kind == XS_FOR_RANGE {
            return lowerForRange(l, idx, st)
        }
        if (*st).kind == XS_SWITCH {
            return lowerSwitch(l, idx, st)
        }
        if (*st).kind == XS_DEFER {
            // The deferred statements run when the enclosing scope unwinds: they join the
            // function's unwind list (the C++ pass builds unwind pads).
            local body = lowerStmtList(l, (*st).init)
            for i in 0..body.length() {
                l.fnUnwind.push(*body.get(i))
            }
            return -1
        }
        if (*st).kind == XS_TRY {
            local body = lowerBlockInto(l, (*st).body)
            local handler = Vec<i32>()
            if (*st).elseBody >= 0 {
                handler = lowerBlockInto(l, (*st).elseBody)
            }
            local msgLocal = addLocal(l,l.s.stmtTextAt(idx), "String")
            return l.b.tryStmt(body, handler, msgLocal)
        }
        if (*st).kind == XS_DO_WHILE {
            local cond = lowerExpr(l, (*st).expr)
            l.loopDepth = l.loopDepth + 1
            local body = lowerBlockInto(l, (*st).body)
            l.loopDepth = l.loopDepth - 1
            return l.b.whileStmt(cond, body, l.loopDepth as u32, true)
        }
        if (*st).kind == XS_DELETE {
            // `delete p`: drop the value, then free. The registered free function.
            local p = lowerExpr(l, (*st).expr)
            local args = Vec<i32>()
            args.push(p)
            local range = l.b.args(args)
            return l.b.exprStmt(l.b.call(l.b.freeFunction.asStr(), range.0, range.1, "void"))
        }
        l.err("E0500", (*st).span, "this statement form is not lowered yet",
            "the xlang lowering pass is still being ported")
        return -1
    }

    /// A `let`: the local, its optional initializer and the binding.
export fn lowerLet(l: *Lowerer, idx: i32) -> i32 {
        local st = l.s.stmtAt(idx)
        local name = l.s.stmtTextAt(idx)
        // The declared type, resolved; without one, the type of the initializer.
        local declared = -1
        if (*st).hasType != 0 && (*st).typeIdx >= 0 {
            declared = resolve(l.s, l.s.types.internAst((*st).typeIdx))
        }
        local value = -1
        local vty = declared
        if (*st).expr >= 0 {
            value = lowerExprAs(l, (*st).expr, declared)
            if vty < 0 { vty = effectiveType(l, (*st).expr, -1) }
        }
        local tyName = vty < 0 ? "void" : l.keep(l.s.types.text(vty).asStr())
        local id = addLocal(l, name, tyName)
        local e = new ScopeEntry()
        (*e).kind = SE_LOCAL
        (*e).name = String(name)
        (*e).ty = vty
        (*e).localId = id
        l.scopes.declare(e)
        return l.b.localStmt(id, name, tyName, value)
    }

    /// Lowers one expression and returns its HIR index, or -1.
export fn lowerExpr(l: *Lowerer, idx: i32) -> i32 {
        return lowerExprWant(l, idx, -1)
    }

    /// Lowers `idx` where the context expects type `want` (a Types index, -1 for none), then
    /// converts the value to `want` the way the C++ `coerce` does.
export fn lowerExprAs(l: *Lowerer, idx: i32, want: i32) -> i32 {
        return coerceTo(l, idx, lowerExprWant(l, idx, want), want)
    }

    /// Lowers `idx` with the context type `want` (-1 for none). An unsuffixed literal takes the
    /// type it is given: an integer one a float type too. The operators pass `want` on to the
    /// operands that are literals (see `lowerBinary`).
export fn lowerExprWant(l: *Lowerer, idx: i32, want: i32) -> i32 {
        if idx < 0 { return -1 }
        local e = l.s.exprAt(idx)
        if (*e).kind == XE_INT_LITERAL {
            if want >= 0 && isFloatType(l, want) {
                return l.b.floatConst((*e).intValue as f64, typeNameOf(l, want))
            }
            if want >= 0 && isIntType(l, want) {
                return l.b.intConst((*e).intValue, typeNameOf(l, want))
            }
            return l.b.intConst((*e).intValue, exprTypeName(l, idx))
        }
        if (*e).kind == XE_FLOAT_LITERAL {
            local ft = want >= 0 && isFloatType(l, want) ? typeNameOf(l, want) : "f64"
            return l.b.floatConst((*e).floatValue, ft)
        }
        if (*e).kind == XE_BOOL_LITERAL {
            return l.b.boolConst((*e).boolValue != 0, exprTypeName(l,idx))
        }
        if (*e).kind == XE_STRING_LITERAL {
            return l.b.strConst(l.s.exprTextAt(idx), exprTypeName(l,idx))
        }
        if (*e).kind == XE_BYTE_LITERAL {
            return l.b.intConst((*e).intValue, exprTypeName(l,idx))
        }
        if (*e).kind == XE_NAME {
            return lowerName(l, idx)
        }
        if (*e).kind == XE_BINARY {
            return lowerBinary(l, idx, e, want)
        }
        if (*e).kind == XE_UNARY {
            // A negative literal takes the context type; the other operators do not pass it on.
            local lhs = lowerExprWant(l, (*e).lhs, (*e).unaryOp == XU_NEG ? want : -1)
            if (*e).unaryOp == XU_DEREF {
                return l.b.deref(lhs, exprTypeName(l, idx))
            }
            if (*e).unaryOp == XU_ADDROF {
                return l.b.addrOf(lhs, exprTypeName(l, idx))
            }
            return l.b.unary(unaryOpName((*e).unaryOp), lhs, typeNameOf(l, effectiveType(l, idx, want)))
        }
        if (*e).kind == XE_CAST {
            local value = lowerExpr(l, (*e).lhs)
            return l.b.cast(value, exprTypeName(l, idx), false)
        }
        if (*e).kind == XE_FIELD {
            local base = lowerExpr(l, (*e).lhs)
            // A field of a pointer is read through it (`field.ptr`); the index is the field's
            // position in its aggregate.
            local bt = exprType(l, (*e).lhs)
            local viaPointer = bt >= 0 && l.s.types.get(bt).kind == T_POINTER
            local owner = resolveBase(l, bt)
            local fieldName = l.s.exprTextAt(idx)
            return l.b.field(base, fieldName, exprTypeName(l, idx), viaPointer, fieldIndexOf(l, owner, fieldName))
        }
        if (*e).kind == XE_INDEX {
            return lowerIndex(l, idx, e)
        }
        if (*e).kind == XE_SLICE {
            local base = lowerExpr(l, (*e).lhs)
            local lo = -1
            if (*e).argsCount > 0 {
                lo = lowerExpr(l, l.s.refAt("expr", (*e).argsFirst as i32))
            }
            local hi = lowerExpr(l, (*e).rhs)
            return l.b.slice(base, lo, hi, "")
        }
        if (*e).kind == XE_ARRAY_LIST || (*e).kind == XE_TUPLE_LITERAL {
            local items = lowerArgList(l, e)
            if (*e).kind == XE_ARRAY_LIST {
                return l.b.arrayList(items, exprTypeName(l, idx))
            }
            return l.b.tupleLit(items, exprTypeName(l, idx))
        }
        if (*e).kind == XE_ARRAY_REPEAT {
            local value = lowerExpr(l, (*e).lhs)
            return l.b.arrayRepeat(value, (*e).intValue, "")
        }
        if (*e).kind == XE_STRUCT_LITERAL {
            return lowerStructLit(l, idx, e)
        }
        if (*e).kind == XE_NEW {
            return lowerNew(l, idx, e)
        }
        if (*e).kind == XE_TERNARY {
            local cond = lowerExpr(l, (*e).lhs)
            local thenValue = lowerExpr(l, (*e).rhs)
            local elseValue = lowerExpr(l, l.s.refAt("expr", (*e).argsFirst as i32))
            return l.b.select(cond, thenValue, elseValue, exprTypeName(l, idx))
        }
        if (*e).kind == XE_CALL {
            return lowerCall(l, idx)
        }
        l.err("E0500", (*e).span, "this expression form is not lowered yet",
            "the xlang lowering pass is still being ported")
        return -1
    }

    /// `base[i]` (as the C++ `indexExpr`): a `str`, slice or array index is bounds checked under
    /// `--safety=checked`; a pointer index is not.
export fn lowerIndex(l: *Lowerer, idx: i32, e: *XExpr) -> i32 {
        local base = lowerExpr(l, (*e).lhs)
        local sub = lowerExpr(l, (*e).rhs)
        local at = l.b.index(base, sub, exprTypeName(l, idx))
        local bt = exprType(l, (*e).lhs)
        local bk = bt < 0 ? -1 : l.s.types.get(bt).kind
        if l.checkedSafety && (bk == T_STR || bk == T_SLICE || bk == T_ARRAY) {
            (*l.b.exprAt(at)).checked = 1
        }
        return at
    }

    /// The value converted to type `want` (-1: no conversion). An implicit conversion is a cast
    /// marked implicit; a conversion the language does not allow is left as it is (the sema
    /// reports those, and the xlang sema does not report them yet).
export fn coerceTo(l: *Lowerer, idx: i32, value: i32, want: i32) -> i32 {
        if want < 0 || value < 0 { return value }
        local vt = effectiveType(l, idx, want)
        if vt < 0 || l.s.types.same(vt, want) { return value }
        local r = implicitConversion(l.s.types, vt, want, false, l.s.pointerBits)
        if r.status == C_OK || r.status == C_WARN {
            return l.b.cast(value, typeNameOf(l, want), true)
        }
        return value
    }

    /// A binary operation, as the C++ `binaryExpr`: a literal operand takes the type of the other
    /// one, the numeric operands are converted to their common type, and the result is that type
    /// (`bool` for a comparison). `&&` and `||` take `bool` operands. A shift keeps the type of its
    /// left operand, and its count is converted to it.
export fn lowerBinary(l: *Lowerer, idx: i32, e: *XExpr, want: i32) -> i32 {
        local op = (*e).binaryOp
        local boolT = l.s.types.makeBool()
        if op == XB_AND || op == XB_OR {
            local andLhs = lowerExprAs(l, (*e).lhs, boolT)
            local andRhs = lowerExprAs(l, (*e).rhs, boolT)
            return l.b.binary(binaryOpName(op), andLhs, andRhs, "bool")
        }
        local isCmp = op >= XB_EQ && op <= XB_GE
        local hint = isCmp ? -1 : want
        local lhs = -1
        local rhs = -1
        local lt = -1
        local rt = -1
        // A literal on the left takes the type of a non-literal right operand; otherwise the right
        // operand takes the type of a numeric left one.
        if isLiteralExpr(l, (*e).lhs) && (!isLiteralExpr(l, (*e).rhs) || isFloatLiteralExpr(l, (*e).rhs)) {
            rhs = lowerExprWant(l, (*e).rhs, hint)
            rt = effectiveType(l, (*e).rhs, hint)
            lhs = lowerExprWant(l, (*e).lhs, rt)
            lt = effectiveType(l, (*e).lhs, rt)
        } else {
            lhs = lowerExprWant(l, (*e).lhs, hint)
            lt = effectiveType(l, (*e).lhs, hint)
            local rightHint = isNumeric(l, lt) ? lt : hint
            rhs = lowerExprWant(l, (*e).rhs, rightHint)
            rt = effectiveType(l, (*e).rhs, rightHint)
        }
        if op == XB_SHL || op == XB_SHR {
            if !l.s.types.same(lt, rt) {
                rhs = l.b.cast(rhs, typeNameOf(l, lt), false)
            }
            return l.b.binary(binaryOpName(op), lhs, rhs, typeNameOf(l, lt))
        }
        local common = -1
        if isNumeric(l, lt) && isNumeric(l, rt) {
            local c = commonBinaryType(l.s.types, lt, rt, l.s.pointerBits)
            if c.status == C_OK {
                common = c.ty
                if !l.s.types.same(lt, common) { lhs = l.b.cast(lhs, typeNameOf(l, common), true) }
                if !l.s.types.same(rt, common) { rhs = l.b.cast(rhs, typeNameOf(l, common), true) }
            }
        } else if isCmp {
            common = lt
        }
        return l.b.binary(binaryOpName(op), lhs, rhs, typeNameOf(l, isCmp ? boolT : common))
    }

    /// A name: a local, a global, a function or a constant.
export fn lowerName(l: *Lowerer, idx: i32) -> i32 {
        local name = l.s.exprTextAt(idx)
        local entry = l.lookupName(name)
        if entry == nil {
            l.err("E0706", (*l.s.exprAt(idx)).span,
                format("unknown name `{}`", name).asStr(), "not found in any scope")
            return -1
        }
        local tyName = exprTypeName(l,idx)
        if (*entry).kind == SE_LOCAL {
            return l.b.localRef((*entry).localId, tyName)
        }
        if (*entry).kind == SE_GLOBAL {
            return l.b.globalRef((*entry).qname.asStr(), tyName)
        }
        if (*entry).kind == SE_FUNCTION {
            return l.b.funcRef((*entry).qname.asStr(), tyName)
        }
        if (*entry).kind == SE_CONSTANT {
            // A define constant folds to its value.
            local value = l.constOfName(name)
            if value >= 0 {
                local cv = *l.s.consts.get(value as usize)
                return l.b.intConst((*cv).intValue.lo, tyName)
            }
        }
        l.err("E0706", (*l.s.exprAt(idx)).span,
            format("`{}` has no lowered form here", name).asStr(), "not a value")
        return -1
    }

/// `sizeOf(T)`, `alignOf(T)` and `offsetOf(T, field)`: folded to an integer constant from the
/// computed layout. Primitives use the fixed table; aggregates go through `layoutOfName`.
export fn lowerLayoutQuery(l: *Lowerer, idx: i32, e: *XExpr, which: str) -> i32 {
    if (*e).argsCount == 0 {
        l.err("E0709", (*e).span, format("`{}` needs a type", which).asStr(), "missing argument")
        return -1
    }
    local tyArg = l.s.refAt("expr", (*e).argsFirst as i32)
    local tyName = l.s.exprTextAt(tyArg)
    local value: u64 = 0
    if which == "offsetOf" {
        if (*e).argsCount < 2 {
            l.err("E0709", (*e).span, "`offsetOf` needs a type and a field", "missing argument")
            return -1
        }
        local fieldArg = l.s.refAt("expr", ((*e).argsFirst + 1 as u32) as i32)
        local fieldName = l.s.exprTextAt(fieldArg)
        local li = layoutOfName(l.s, tyName, (*e).span)
        if li < 0 {
            l.err("E0709", (*e).span, format("no layout for `{}`", tyName).asStr(),
                "unknown type")
            return -1
        }
        local lay = *l.s.layoutCache.get(li as usize)
        for i in 0..(*lay).fields.length() {
            local f = (*lay).fields.get(i)
            if (*f).name.asStr() == fieldName {
                value = (*f).offset
            }
        }
    } else {
        value = primLayout(tyName, which)
        if value == 0 {
            local li = layoutOfName(l.s, tyName, (*e).span)
            if li < 0 {
                l.err("E0709", (*e).span, format("no layout for `{}`", tyName).asStr(),
                    "unknown type")
                return -1
            }
            local lay = *l.s.layoutCache.get(li as usize)
            value = which == "sizeOf" ? (*lay).size : (*lay).align
        }
    }
    return l.b.intConst(value, "usize")
}

/// The size or alignment of a primitive type by name; 0 when `tyName` is not one.
fn primLayout(tyName: str, which: str) -> u64 {
    local size: u64 = 0
    if tyName == "i8" || tyName == "u8" || tyName == "bool" { size = 1 }
    else if tyName == "i16" || tyName == "u16" { size = 2 }
    else if tyName == "f32" { size = 4 }
    else if tyName == "i32" || tyName == "u32" || tyName == "f32" { size = 4 }
    else if tyName == "i64" || tyName == "u64" || tyName == "f64" || tyName == "usize" ||
            tyName == "isize" || tyName == "u128" || tyName == "i128" { size = 8 }
    else if tyName == "str" { size = 16 }
    if size == 0 { return 0 }
    return which == "sizeOf" ? size : size
}

    /// The initializer of a global: a constant expression folded to a literal.
export fn runConstInit(l: *Lowerer, exprIdx: i32, tyName: str) -> i32 {
        local value = evalConst(l.s, exprIdx)
        if value >= 0 {
            local cv = *l.s.consts.get(value as usize)
            if (*cv).kind == 0 {
                return l.b.intConst((*cv).intValue.lo, tyName)
            }
            if (*cv).kind == 1 {
                return l.b.floatConst((*cv).floatValue, tyName)
            }
            if (*cv).kind == 2 {
                return l.b.boolConst((*cv).boolValue, tyName)
            }
            if (*cv).kind == 3 {
                return l.b.strConst((*cv).text.asStr(), tyName)
            }
        }
        // Not constant: lowered as an expression; the codegen emits a dynamic initializer.
        return lowerExpr(l, exprIdx)
    }

/// The statements of the single-statement block or statement `idx`, as a list.
export fn lowerStmtList(l: *Lowerer, idx: i32) -> Vec<i32> {
    local out = Vec<i32>()
    if idx < 0 { return out }
    local st = lowerStmt(l, idx)
    if st >= 0 { out.push(st) }
    return out
}

/// A C-style `for`: the initializer, the condition, the step and the body, as a block holding
/// the initializer and a `while` whose body ends with the step. A `continue` inside the body
/// still runs the step because the C++ pass moves the step under every `continue`; the flat
/// form keeps that fix-up to the statement walker of a later pass.
export fn lowerCFor(l: *Lowerer, st: *XStmt) -> i32 {
    local inner = Vec<i32>()
    if (*st).init >= 0 {
        local init = lowerStmt(l, (*st).init)
        if init >= 0 { inner.push(init) }
    }
    local cond = -1
    if (*st).expr >= 0 {
        cond = lowerExpr(l, (*st).expr)
    } else {
        cond = l.b.boolConst(true, "bool")
    }
    l.loopDepth = l.loopDepth + 1
    local body = lowerBlockInto(l, (*st).body)
    l.loopDepth = l.loopDepth - 1
    if (*st).step >= 0 {
        local step = lowerStmt(l, (*st).step)
        if step >= 0 { body.push(step) }
    }
    inner.push(l.b.whileStmt(cond, body, l.loopDepth as u32, false))
    return l.b.blockStmt(inner)
}

/// A `for i in lo..hi` (or `..=`): a counter local compared against the bound.
export fn lowerForRange(l: *Lowerer, idx: i32, st: *XStmt) -> i32 {
    local name = l.s.stmtTextAt(idx)
    local lo = lowerExpr(l, (*st).expr)
    local hi = lowerExpr(l, (*st).expr2)
    local counter = addLocal(l,name, "i64")
    local entry = new ScopeEntry()
    (*entry).kind = SE_LOCAL
    (*entry).name = String(name)
    (*entry).ty = -1
    (*entry).localId = counter
    l.scopes.declare(entry)
    local inner = Vec<i32>()
    // counter = lo
    local target = l.b.localRef(counter, "i64")
    inner.push(l.b.assign(target, lo))
    l.loopDepth = l.loopDepth + 1
    local body = lowerBlockInto(l, (*st).body)
    l.loopDepth = l.loopDepth - 1
    // counter = counter + 1
    local ref = l.b.localRef(counter, "i64")
    local one = l.b.intConst(1, "i64")
    local inc = l.b.binary("+", ref, one, "i64")
    body.push(l.b.assign(l.b.localRef(counter, "i64"), inc))
    // counter < hi (or <=)
    local cmp = l.b.binary((*st).rangeInclusive != 0 ? "<=" : "<",
        l.b.localRef(counter, "i64"), hi, "bool")
    inner.push(l.b.whileStmt(cmp, body, l.loopDepth as u32, false))
    return l.b.blockStmt(inner)
}

/// A `switch`: an if/else chain over the case values; the default case is the last `else`.
export fn lowerSwitch(l: *Lowerer, idx: i32, st: *XStmt) -> i32 {
    local value = lowerExpr(l, (*st).expr)
    local chain = Vec<i32>()
    local defaultBody = Vec<i32>()
    for i in 0..(*st).casesCount as usize {
        local c = l.s.flat.caseAt(((*st).casesFirst + i as u32) as i32)
        local body = lowerBlockInto(l, (*c).body)
        if (*c).isDefault != 0 {
            defaultBody = body
            continue
        }
        // One `if` per case value, chained through the else arms.
        for j in 0..(*c).valuesCount as usize {
            local v = l.s.refAt("expr", ((*c).valuesFirst + j as u32) as i32)
            local cv = lowerExpr(l, v)
            local cond = l.b.binary("==", value, cv, "bool")
            if j + 1 < (*c).valuesCount as usize {
                // Several values sharing one body: nested `if`s fall through to the same body.
                local rest = Vec<i32>()
                chain.push(l.b.ifStmt(cond, body, rest))
                continue
            }
            chain.push(l.b.ifStmt(cond, body, Vec<i32>()))
        }
    }
    // Chain the ifs: each else arm holds the rest; the default body is the last else.
    local out = Vec<i32>()
    if chain.length() == 0 {
        out = defaultBody
    } else {
        // Build from the last if backwards: elseFirst ranges over stmt refs.
        local acc = defaultBody
        for k in 0..chain.length() {
            local idxK = chain.length() - 1 - k
            local ifIdx = *chain.get(idxK)
            local stp = l.b.stmtAt(ifIdx)
            (*stp).elseFirst = l.b.refs.length() as u32
            for m in 0..acc.length() {
                l.b.refs.push(*acc.get(m) as u32)
            }
            (*stp).elseCount = acc.length() as u32
            acc = Vec<i32>()
            acc.push(ifIdx)
        }
        out = acc
    }
    return l.b.blockStmt(out)
}

/// The lowered argument expressions of a record's `argsFirst/argsCount` range, in order.
export fn lowerArgList(l: *Lowerer, e: *XExpr) -> Vec<i32> {
    local out = Vec<i32>()
    for i in 0..(*e).argsCount as usize {
        local a = l.s.refAt("expr", ((*e).argsFirst + i as u32) as i32)
        local v = lowerExpr(l, a)
        if v < 0 { continue }
        out.push(v)
    }
    return out
}

/// A struct literal: the field initializers in source order.
export fn lowerStructLit(l: *Lowerer, idx: i32, e: *XExpr) -> i32 {
    local tyName = typeNameOf(l, aggregateTypeOf(l, e))
    local inits = Vec<i32>()
    local first = l.b.fieldInits.length() as u32
    for i in 0..(*e).fieldsCount as usize {
        local f = l.s.flat.initAt(((*e).fieldsFirst + i as u32) as i32)
        local v = lowerExpr(l, (*f).value)
        if v < 0 { continue }
        local rec: XlcHirFieldInit
        rec.name = XlcHirStr { bytes: nil as *u8, len: 0 }
        rec.value = v
        l.b.fieldInits.push(rec)
        l.b.fieldName(l.b.fieldInits.length() as u32 - 1, l.s.flat.strOf((*f).name),
            fieldIndexOf(l, aggregateTypeOf(l, e), l.s.flat.strOf((*f).name)))
    }
    local at = l.b.expr(E_STRUCT_LIT, tyName)
    local p = l.b.exprAt(at)
    (*p).fieldFirst = first
    (*p).fieldCount = l.b.fieldInits.length() as u32 - first
    return at
}

/// `new T` / `new T { fields }` / `new T(args)`: the allocation, the init call and the fields.
export fn lowerNew(l: *Lowerer, idx: i32, e: *XExpr) -> i32 {
    local tyName = typeNameOf(l, aggregateTypeOf(l, e))
    local at = l.b.newExpr(format("*{}", tyName).asStr())
    local p = l.b.exprAt(at)
    // A class with an `init`: the call becomes the init function over the argument list.
    if (*e).hasCallArgs != 0 {
        local args = lowerArgList(l, e)
        local range = l.b.args(args)
        (*p).lhs = l.b.construct(format("{}.init", tyName).asStr(), Vec<i32>(), tyName)
        (*p).argFirst = range.0
        (*p).argCount = range.1
        return at
    }
    // The field initializers.
    local first = l.b.fieldInits.length() as u32
    for i in 0..(*e).fieldsCount as usize {
        local f = l.s.flat.initAt(((*e).fieldsFirst + i as u32) as i32)
        local v = lowerExpr(l, (*f).value)
        if v < 0 { continue }
        local rec: XlcHirFieldInit
        rec.name = XlcHirStr { bytes: nil as *u8, len: 0 }
        rec.value = v
        l.b.fieldInits.push(rec)
        l.b.fieldName(l.b.fieldInits.length() as u32 - 1, l.s.flat.strOf((*f).name),
            fieldIndexOf(l, aggregateTypeOf(l, e), l.s.flat.strOf((*f).name)))
    }
    (*p).fieldFirst = first
    (*p).fieldCount = l.b.fieldInits.length() as u32 - first
    return at
}

/// The spelling of a `UnaryOp` (Neg=0 Not=1 Deref=2 AddrOf=3 BitNot=4), the form the HIR keeps.
fn unaryOpName(op: i32) -> str {
    switch {
        case op == XU_NEG { return "-" }
        case op == XU_NOT { return "!" }
        case op == XU_DEREF { return "*" }
        case op == XU_ADDROF { return "&" }
        case op == XU_BITNOT { return "~" }
    }
    return "?"
}

/// The spelling of a `BinaryOp` (Add=0 .. Shr=17, declaration order).
fn binaryOpName(op: i32) -> str {
    switch {
        case op == XB_ADD { return "+" }
        case op == XB_SUB { return "-" }
        case op == XB_MUL { return "*" }
        case op == XB_DIV { return "/" }
        case op == XB_MOD { return "%" }
        case op == XB_EQ { return "==" }
        case op == XB_NE { return "!=" }
        case op == XB_LT { return "<" }
        case op == XB_LE { return "<=" }
        case op == XB_GT { return ">" }
        case op == XB_GE { return ">=" }
        case op == XB_AND { return "&&" }
        case op == XB_OR { return "||" }
        case op == XB_BITAND { return "&" }
        case op == XB_BITOR { return "|" }
        case op == XB_BITXOR { return "^" }
        case op == XB_SHL { return "<<" }
        case op == XB_SHR { return ">>" }
    }
    return "?"
}
