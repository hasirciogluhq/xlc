// Compile-time queries of the xlang lowering pass: the layout builtins (`sizeOf`, `alignOf`,
// `offsetOf`), enum member values and the HIR spellings of the operators. None of them lowers an
// expression, so they sit apart from the expression walk in function.xl (no cyclic imports).
from "std" import String, Vec, format
from "../lang/ast/ast" import XExpr, XU_NEG, XU_NOT, XU_DEREF, XU_ADDROF, XU_BITNOT,
    XB_ADD, XB_SUB, XB_MUL, XB_DIV, XB_MOD, XB_EQ, XB_NE, XB_LT, XB_LE, XB_GT, XB_GE,
    XB_AND, XB_OR, XB_BITAND, XB_BITOR, XB_BITXOR, XB_SHL, XB_SHR
from "../hir/abi" import E_INT_CONST, E_FLOAT_CONST, E_BOOL_CONST, E_STR_CONST, E_NIL, E_FUNC_REF,
    E_EXTERNAL, E_GLOBAL_REF, E_UNARY, E_BINARY, E_CAST, E_INDEX, E_FIELD, E_ADDR_OF, E_ARRAY_LIST,
    E_ARRAY_REPEAT, E_TUPLE_LIT, E_STRUCT_LIT, E_TO_INTERFACE
from "../sema/item" import SDecl
from "../sema/sema" import Sema
from "../sema/subst" import TypeEnv
from "../sema/const_eval" import evalConst
from "../sema/layout_calc" import layoutOf
from "../sema/module_scope" import exprToType
from "../sema/resolve" import resolve
from "./state" import Lowerer
from "./typing" import arrayLength, hasSideEffects

/// `base.len` of an array of type `arr` (C++ fieldExpr): the constant length as `usize`. The array
/// is not evaluated, so a base that calls or allocates is E0709. An array whose length is not a
/// constant gives -1 here, with nothing reported.
export fn lowerArrayLen(l: *Lowerer, e: *XExpr, arr: i32) -> i32 {
    local n = arrayLength(l, arr)
    if n < 0 { return -1 }
    if hasSideEffects(l, (*e).lhs) {
        local label = format("the length is the constant {}; bind the array to a local first, or write the constant", n)
        l.err("E0709", (*e).span, "`.len` of an array does not evaluate the array", label.asStr())
        return -1
    }
    return l.b.intConst(n as u64, "usize")
}

/// `sizeOf(T)`, `alignOf(T)` and `offsetOf(T, field)`: folded to an integer constant from the
/// computed layout of the resolved type (primitives included, so the target's pointer size holds).
export fn lowerLayoutQuery(l: *Lowerer, idx: i32, e: *XExpr, which: str) -> i32 {
    if (*e).argsCount == 0 {
        l.err("E0709", (*e).span, format("`{}` needs a type", which).asStr(), "missing argument")
        return -1
    }
    local tyArg = l.s.refAt("expr", (*e).argsFirst as i32)
    // The operand is a type written as an expression (`T`, `a::B`, `*T`, `[]u8`): made a type of
    // this module and resolved, which applies the instance env first, so `sizeOf(T)` in
    // `Vec<Route>` is the layout of the argument wherever it is declared.
    local ty = resolve(l.s, exprToType(l.s, tyArg))
    if ty < 0 {
        l.err("E0709", (*e).span, format("no layout for `{}`", l.s.exprTextAt(tyArg)).asStr(),
            "not a type")
        return -1
    }
    local li = layoutOf(l.s, ty, (*e).span)
    if li < 0 { return -1 } // layoutOf reported why
    local lay = *l.s.layoutCache.get(li as usize)
    if which != "offsetOf" {
        return l.b.intConst(which == "sizeOf" ? (*lay).size : (*lay).align, "usize")
    }
    if (*e).argsCount < 2 {
        l.err("E0709", (*e).span, "`offsetOf` needs a type and a field", "missing argument")
        return -1
    }
    local fieldName = l.s.exprTextAt(l.s.refAt("expr", ((*e).argsFirst + 1 as u32) as i32))
    for i in 0..(*lay).fields.length() {
        local f = (*lay).fields.get(i)
        if (*f).name.asStr() == fieldName { return l.b.intConst((*f).offset, "usize") }
    }
    // The C++ pass (and the first port) folded an unknown field to 0 silently.
    l.err("E0709", (*e).span,
        format("`{}` has no field `{}`", l.s.types.text(ty).asStr(), fieldName).asStr(),
        "offsetOf names a field of the type")
    return -1
}

/// The value of the member `member` of the enum declared by `d`, numbered as the C++ enumMember
/// does: a written value (a constant expression), else one more than the member before it.
export fn enumMemberValue(l: *Lowerer, d: *SDecl, member: str) -> i64 {
        return enumMemberValueIn(l.s, d, member)
    }

/// The value of `member` of the enum `d` declared in module `s` (evaluated there).
export fn enumMemberValueIn(s: *Sema, d: *SDecl, member: str) -> i64 {
        local next: i64 = 0
        for i in 0..(*d).membersCount as usize {
            local m = s.memberAt((*d).membersFirst as usize + i)
            local value = next
            if (*m).value >= 0 {
                local c = evalConst(s, (*m).value)
                if c >= 0 { value = (*s.consts.get(c as usize)).intValue.lo as i64 }
            }
            if s.text((*m).name) == member { return value }
            next = value + 1
        }
        return 0
    }

/// The spelling of a `UnaryOp` (Neg=0 Not=1 Deref=2 AddrOf=3 BitNot=4), the form the HIR keeps.
export fn unaryOpName(op: i32) -> str {
    switch {
        case op == XU_NEG { return "-" }
        case op == XU_NOT { return "!" }
        case op == XU_DEREF { return "*" }
        case op == XU_ADDROF { return "&" }
        case op == XU_BITNOT { return "~" }
    }
    return "?"
}

/// The spelling of a `BinaryOp` (Add=0 .. Shr=17, declaration order).
export fn binaryOpName(op: i32) -> str {
    switch {
        case op == XB_ADD { return "+" }
        case op == XB_SUB { return "-" }
        case op == XB_MUL { return "*" }
        case op == XB_DIV { return "/" }
        case op == XB_MOD { return "%" }
        case op == XB_EQ { return "==" }
        case op == XB_NE { return "!=" }
        case op == XB_LT { return "<" }
        case op == XB_LE { return "<=" }
        case op == XB_GT { return ">" }
        case op == XB_GE { return ">=" }
        case op == XB_AND { return "&&" }
        case op == XB_OR { return "||" }
        case op == XB_BITAND { return "&" }
        case op == XB_BITOR { return "|" }
        case op == XB_BITXOR { return "^" }
        case op == XB_SHL { return "<<" }
        case op == XB_SHR { return ">>" }
    }
    return "?"
}

/// True when the lowered expression `idx` is a compile-time constant (C++ Lowerer::isConstValue):
/// literals, function and external references, arithmetic and casts of constants, arrays, tuples
/// and struct literals of constants, and `&global` with constant indexes and fields. When it is
/// not, `offender` receives the first node that is not, unless it already holds one.
export fn isConstValue(l: *Lowerer, idx: i32, offender: *i32) -> bool {
    local e = l.b.exprAt(idx)
    local k = (*e).kind
    if k == E_INT_CONST || k == E_FLOAT_CONST || k == E_BOOL_CONST || k == E_STR_CONST || k == E_NIL ||
        k == E_FUNC_REF || k == E_EXTERNAL { return true }
    if k == E_UNARY || k == E_CAST || k == E_TO_INTERFACE || k == E_ARRAY_REPEAT {
        return (*e).lhs >= 0 && isConstValue(l, (*e).lhs, offender)
    }
    if k == E_BINARY {
        return (*e).lhs >= 0 && (*e).rhs >= 0 && isConstValue(l, (*e).lhs, offender) &&
            isConstValue(l, (*e).rhs, offender)
    }
    if k == E_ARRAY_LIST || k == E_TUPLE_LIT {
        for i in 0..(*e).argCount as usize {
            if !isConstValue(l, *l.b.refs.get(((*e).argFirst + i as u32) as usize) as i32, offender) {
                return false
            }
        }
        return true
    }
    if k == E_STRUCT_LIT {
        for i in 0..(*e).fieldCount as usize {
            local f = l.b.fieldInits.get(((*e).fieldFirst + i as u32) as usize)
            if !isConstValue(l, (*f).value, offender) { return false }
        }
        return true
    }
    if k == E_ADDR_OF {
        // `&global`, `&global[const]`, `&global.field` (not through a pointer)
        local cur = (*e).lhs
        while cur >= 0 {
            local c = l.b.exprAt(cur)
            if (*c).kind == E_GLOBAL_REF { return true }
            if (*c).kind == E_INDEX {
                local r = (*c).rhs
                if r < 0 || (*l.b.exprAt(r)).kind != E_INT_CONST {
                    return failAt(cur, offender)
                }
                cur = (*c).lhs
            } else if (*c).kind == E_FIELD && (*c).throughPointer == 0 {
                cur = (*c).lhs
            } else {
                return failAt(idx, offender)
            }
        }
        return failAt(idx, offender)
    }
    return failAt(idx, offender)
}

/// Records `idx` as the offender when none is recorded yet; the result is always false.
fn failAt(idx: i32, offender: *i32) -> bool {
    if *offender < 0 { *offender = idx }
    return false
}
