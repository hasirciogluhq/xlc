// Payload enums (sum types) of the xlang lowering pass. The twin of src/sema/lower/sum/sum.cpp.
//
// The parser turns `enum E { A(i64), B }` into the struct `E { tag: E$Tag, data: E$Data }`, the tag
// enum `E$Tag`, the union `E$Data { A: E$A }` and one struct `E$A` per variant with data (see
// sema/instances.xl). Here a variant is built: `E.B` is `E { tag = 1 }`, `E.A(x)` is
// `E { tag = 0, data = E$Data { A = E$A { _0 = x } } }`.
//
// Lowered: payload enums that are not generic. A generic payload enum (`Option<T>`) needs the
// instance choice (`sumFor` in the C++ pass) and is not ported yet.
from "std" import String, Vec, format
from "../hir/abi" import XlcHirStr, XlcHirFieldInit, E_STRUCT_LIT
from "../lang/ast/ast" import XExpr, XStmt, XE_CALL, XE_FIELD, XE_NAME
from "./stmt" import switchChain
from "../sema/sema" import Sema, SY_STRUCT
from "../sema/item" import SDecl, SSumVariant
from "../sema/resolve" import resolve
from "./state" import Lowerer, SE_TYPE
from "./typing" import typeNameOf, adoptFrom, entryOwner
from "./methods" import classLoc
from "./function" import lowerExprAs, lowerExprWant, lowerBlockInto, hiddenLocal, addLocal, bindLocal

/// A payload enum: the module that owns it and its declaration.
export struct Sum {
    owner: *Sema
    decl: *SDecl
}

/// The payload enum that `name` names in this module (its own or an import), or a Sum with a nil
/// `decl`. A generic enum (`Result`) is the instance the expected type `l.sumWant` names.
export fn sumNamed(l: *Lowerer, name: str) -> Sum {
    local none = Sum { owner: l.s, decl: nil as *SDecl }
    local entry = l.lookupName(name)
    if entry == nil || (*entry).kind != SE_TYPE || (*entry).item < 0 { return none }
    local owner = entryOwner(l, entry)
    local d = owner.declOfItem((*entry).item)
    if d < 0 { return none }
    local decl = owner.declAt(d as usize)
    if (*decl).variantsCount == 0 { return none }
    if owner.genericParamsOf((*entry).item).1 == 0 { return Sum { owner: owner, decl: decl } }
    // A generic enum: the instance of the expected type, when that is an instance of this enum.
    local want = sumOfType(l, l.sumWant)
    if want.decl == nil as *SDecl || want.owner != owner { return none }
    local head = Sum { owner: owner, decl: decl }
    if baseOf(want) != baseOf(head) { return none }
    return want
}

/// Same as `sumOfType`, for callers that have their own `sumOfType`.
export fn sumOfTypeIn(l: *Lowerer, t: i32) -> Sum {
    return sumOfType(l, t)
}

/// The payload enum (or instance of a generic one) that type `t` of this module is.
export fn sumOfType(l: *Lowerer, t: i32) -> Sum {
    local at = classLoc(l.s, t)
    local none = Sum { owner: l.s, decl: nil as *SDecl }
    if at.decl < 0 { return none }
    local decl = at.owner.declAt(at.decl as usize)
    if (*decl).variantsCount == 0 { return none }
    return Sum { owner: at.owner, decl: decl }
}

/// The name of the enum without the instance arguments: `Result<i32, E>` -> `Result`.
fn baseOf(sum: Sum) -> str {
    local name = sum.owner.text((*sum.decl).name)
    for i in 0..name.len as usize {
        if name[i] == b'<' { return name[0..i] }
    }
    return name
}

/// The instance arguments with their brackets (`<i32, E>`), "" for an enum that is not generic.
fn argsOf(sum: Sum) -> str {
    local name = sum.owner.text((*sum.decl).name)
    for i in 0..name.len as usize {
        if name[i] == b'<' { return name[i..name.len as usize] }
    }
    return ""
}

/// The qualified names of the parts of an enum (instances of a generic keep the arguments after
/// the part name: `Result$Data<i32, E>`; the tag enum is shared by every instance).
fn wholeName(l: *Lowerer, sum: Sum) -> str {
    return l.keep(sum.owner.qualify(sum.owner.text((*sum.decl).name)).asStr())
}

fn tagTypeName(l: *Lowerer, sum: Sum) -> str {
    return l.keep(sum.owner.qualify(format("{}$Tag", baseOf(sum)).asStr()).asStr())
}

fn dataTypeName(l: *Lowerer, sum: Sum) -> str {
    return l.keep(sum.owner.qualify(format("{}$Data{}", baseOf(sum), argsOf(sum)).asStr()).asStr())
}

fn payloadTypeName(l: *Lowerer, sum: Sum, vname: str) -> str {
    return l.keep(sum.owner.qualify(format("{}${}{}", baseOf(sum), vname, argsOf(sum)).asStr()).asStr())
}

/// The type of payload value `i` of variant `v`, resolved in the declaring module and adopted.
fn payloadType(l: *Lowerer, sum: Sum, v: *SSumVariant, i: u32) -> i32 {
    return adoptFrom(l, sum.owner, resolve(sum.owner, ((*v).payloadFirst + i) as i32))
}

/// Index of the variant `name`, or -1.
fn variantIndex(sum: Sum, name: str) -> i32 {
    for i in 0..(*sum.decl).variantsCount as usize {
        local v = sum.owner.variants.get(((*sum.decl).variantsFirst + i as u32) as usize)
        if sum.owner.text((*v).name) == name { return i as i32 }
    }
    return -1
}

/// Index of the variant's field inside `E$Data`: only variants with data have one.
fn dataIndex(sum: Sum, variant: i32) -> u32 {
    local n: u32 = 0
    for i in 0..variant as usize {
        local v = sum.owner.variants.get(((*sum.decl).variantsFirst + i as u32) as usize)
        if (*v).payloadCount != 0 { n++ }
    }
    return n
}

/// A struct literal of `typeName` whose fields are `names[i] = values[i]` at position `i`
/// (`indexes`); the initializers are recorded together, so the literal's range is contiguous.
fn literal(l: *Lowerer, typeName: str, names: Vec<str>, indexes: Vec<u32>, values: Vec<i32>) -> i32 {
    local first = l.b.fieldInits.length() as u32
    for i in 0..names.length() {
        local rec: XlcHirFieldInit
        rec.name = XlcHirStr { bytes: nil as *u8, len: 0 }
        rec.value = *values.get(i)
        l.b.fieldInits.push(rec)
        l.b.fieldName(first + i as u32, *names.get(i), *indexes.get(i))
    }
    local at = l.b.expr(E_STRUCT_LIT, typeName)
    local p = l.b.exprAt(at)
    (*p).fieldFirst = first
    (*p).fieldCount = names.length() as u32
    return at
}

/// The enum value of variant `variant` carrying `values` (one per payload type).
export fn construct(l: *Lowerer, sum: Sum, variant: i32, values: Vec<i32>) -> i32 {
    local whole = wholeName(l, sum)
    local tagName = tagTypeName(l, sum)
    local v = sum.owner.variants.get(((*sum.decl).variantsFirst + variant as u32) as usize)
    local names = Vec<str>()
    local indexes = Vec<u32>()
    local inner = Vec<i32>()
    names.push("tag")
    indexes.push(0)
    inner.push(l.b.intConst(variant as u64, tagName))
    if (*v).payloadCount != 0 {
        local vname = sum.owner.text((*v).name)
        local payNames = Vec<str>()
        local payIndexes = Vec<u32>()
        for i in 0..values.length() {
            payNames.push(l.keep(format("_{}", i).asStr()))
            payIndexes.push(i as u32)
        }
        local payload = literal(l, payloadTypeName(l, sum, vname), payNames, payIndexes, values)
        local dataNames = Vec<str>()
        local dataIndexes = Vec<u32>()
        local dataValues = Vec<i32>()
        dataNames.push(vname)
        dataIndexes.push(dataIndex(sum, variant))
        dataValues.push(payload)
        local data = literal(l, dataTypeName(l, sum), dataNames, dataIndexes, dataValues)
        names.push("data")
        indexes.push(1)
        inner.push(data)
    }
    return literal(l, whole, names, indexes, inner)
}

/// `E.B` used as a value: only a variant without data can stand alone (E0706, E0751).
export fn lowerSumValue(l: *Lowerer, sum: Sum, e: *XExpr, member: str) -> i32 {
    local variant = variantIndex(sum, member)
    local ename = baseOf(sum)
    if variant < 0 {
        l.err("E0706", (*e).span, format("enum `{}` has no member `{}`", ename, member).asStr(),
            "unknown member")
        return -1
    }
    local v = sum.owner.variants.get(((*sum.decl).variantsFirst + variant as u32) as usize)
    if (*v).payloadCount != 0 {
        l.err("E0751", (*e).span,
            format("variant `{}.{}` carries {} value(s)", ename, member, (*v).payloadCount).asStr(),
            format("write `{}.{}(...)` with its values", ename, member).asStr())
        return -1
    }
    return construct(l, sum, variant, Vec<i32>())
}

/// `E.A(x, y)`: every argument converts to the payload type at its position (E0706, E0751).
export fn lowerSumCall(l: *Lowerer, sum: Sum, call: *XExpr, member: str) -> i32 {
    local variant = variantIndex(sum, member)
    local ename = baseOf(sum)
    if variant < 0 {
        l.err("E0706", (*call).span, format("enum `{}` has no member `{}`", ename, member).asStr(),
            "unknown member")
        return -1
    }
    local v = sum.owner.variants.get(((*sum.decl).variantsFirst + variant as u32) as usize)
    if (*call).argsCount != (*v).payloadCount {
        l.err("E0751", (*call).span,
            format("variant `{}.{}` takes {} value(s), {} given", ename, member, (*v).payloadCount,
                (*call).argsCount).asStr(),
            "the number of values must match the variant's payload")
        return -1
    }
    local values = Vec<i32>()
    local ok = true
    for i in 0..(*call).argsCount as usize {
        local arg = l.s.refAt("expr", ((*call).argsFirst + i as u32) as i32)
        local want = payloadType(l, sum, v, i as u32)
        local value = lowerExprAs(l, arg, want)
        if value < 0 { ok = false }
        values.push(value)
    }
    if !ok { return -1 }
    return construct(l, sum, variant, values)
}

/// The `Shape$Tag == variant` test over the hidden local `subject`.
export fn tagIs(l: *Lowerer, sum: Sum, subject: u32, selfName: str, variant: i32) -> i32 {
    local tagName = tagTypeName(l, sum)
    local tag = l.b.field(l.b.localRef(subject, selfName), "tag", tagName, false, 0)
    return l.b.binary("==", tag, l.b.intConst(variant as u64, tagName), "bool")
}

/// The place `subject.data.<Variant>._<index>`.
export fn payloadRead(l: *Lowerer, sum: Sum, subject: u32, selfName: str, variant: i32, index: u32) -> i32 {
    local v = sum.owner.variants.get(((*sum.decl).variantsFirst + variant as u32) as usize)
    local vname = sum.owner.text((*v).name)
    local data = l.b.field(l.b.localRef(subject, selfName), "data", dataTypeName(l, sum), false, 1)
    local payload = l.b.field(data, vname, payloadTypeName(l, sum, vname), false, dataIndex(sum, variant))
    return l.b.field(payload, l.keep(format("_{}", index).asStr()),
        typeNameOf(l, payloadType(l, sum, v, index)), false, index)
}

/// `switch` on a payload enum (C++ sum/switch.cpp, without drops): a case names variants,
/// `case E.A(x, y) { }` binds the payload, `case E.A, E.B { }` matches without binding. Without a
/// `default` every variant must be covered (E0750).
export fn lowerSumSwitch(l: *Lowerer, st: *XStmt, sum: Sum, selfTy: i32) -> i32 {
    local selfName = typeNameOf(l, selfTy)
    local ename = baseOf(sum)
    l.scopes.push()
    local value = lowerExprWant(l, (*st).expr, -1)
    local subject = hiddenLocal(l, "sw", selfName)
    local inner = Vec<i32>()
    inner.push(l.b.localStmt(subject, format("$sw{}", l.hiddenCount - 1).asStr(), selfName, value))
    local conds = Vec<i32>()
    local bodies = Vec<Vec<i32>>()
    local defaultBody = Vec<i32>()
    local hasDefault = false
    local covered = Vec<i32>()
    for i in 0..(*st).casesCount as usize {
        local c = l.s.flat.caseAt(((*st).casesFirst + i as u32) as i32)
        if (*c).isDefault != 0 {
            if hasDefault {
                l.err("E0709", (*c).span, "a `switch` has more than one `default`", "remove the duplicate")
            }
            hasDefault = true
            defaultBody = lowerBlockInto(l, (*c).body)
            continue
        }
        l.scopes.push()
        local cond = -1
        local binds = Vec<i32>()
        for j in 0..(*c).valuesCount as usize {
            local vi = l.s.refAt("expr", ((*c).valuesFirst + j as u32) as i32)
            local value = l.s.exprAt(vi)
            local isCall = (*value).kind == XE_CALL
            local patIdx = isCall ? (*value).lhs : vi
            local pat = l.s.exprAt(patIdx)
            local named = Sum { owner: l.s, decl: nil as *SDecl }
            if (*pat).kind == XE_FIELD && (*l.s.exprAt((*pat).lhs)).kind == XE_NAME {
                l.sumWant = selfTy
                named = sumNamed(l, l.s.exprTextAt((*pat).lhs))
            }
            if named.decl == nil as *SDecl {
                l.err("E0749", (*value).span,
                    format("`case` of a `{}` switch must name one of its variants", ename).asStr(),
                    format("write `{}.Variant` or `{}.Variant(names...)`", ename, ename).asStr())
                continue
            }
            local member = l.s.exprTextAt(patIdx)
            if baseOf(named) != ename {
                l.err("E0757", (*value).span,
                    format("`case {}.{}` names a variant of `{}`, but the value is a `{}`",
                        baseOf(named), member, baseOf(named), ename).asStr(),
                    format("write `{}.{}`", ename, member).asStr())
                continue
            }
            local variant = variantIndex(sum, member)
            if variant < 0 {
                l.err("E0706", (*pat).span, format("enum `{}` has no member `{}`", ename, member).asStr(),
                    "unknown member")
                continue
            }
            local dup = false
            for k in 0..covered.length() {
                if *covered.get(k) == variant { dup = true }
            }
            if dup {
                l.err("E0709", (*value).span, "duplicate `case` variant",
                    "this variant is already handled by an earlier `case`")
            } else {
                covered.push(variant)
            }
            local test = tagIs(l, sum, subject, selfName, variant)
            cond = cond < 0 ? test : l.b.binary("||", cond, test, "bool")
            if !isCall { continue }
            local v = sum.owner.variants.get(((*sum.decl).variantsFirst + variant as u32) as usize)
            local allNames = true
            for a in 0..(*value).argsCount as usize {
                if (*l.s.exprAt(l.s.refAt("expr", ((*value).argsFirst + a as u32) as i32))).kind != XE_NAME {
                    allNames = false
                }
            }
            if (*c).valuesCount != 1 || (*value).argsCount != (*v).payloadCount || !allNames {
                l.err("E0749", (*value).span,
                    format("pattern `{}.{}(...)` needs one name per payload value ({}), alone in its `case`",
                        ename, member, (*v).payloadCount).asStr(),
                    "write `case E.A(x, y) { }`; use `_` to ignore a value")
                continue
            }
            for a in 0..(*v).payloadCount as usize {
                local nameIdx = l.s.refAt("expr", ((*value).argsFirst + a as u32) as i32)
                local name = l.s.exprTextAt(nameIdx)
                if name == "_" { continue }
                local pty = payloadType(l, sum, v, a as u32)
                local id = addLocal(l, name, typeNameOf(l, pty))
                binds.push(l.b.localStmt(id, name, typeNameOf(l, pty),
                    payloadRead(l, sum, subject, selfName, variant, a as u32)))
                bindLocal(l, name, id, pty)
            }
        }
        local body = lowerBlockInto(l, (*c).body)
        l.scopes.pop()
        if cond < 0 { continue }
        local all = binds
        for k in 0..body.length() { all.push(*body.get(k)) }
        conds.push(cond)
        bodies.push(all)
    }
    l.scopes.pop()
    local variantCount = (*sum.decl).variantsCount as usize
    if !hasDefault && covered.length() < variantCount {
        local missing = String("")
        for k in 0..variantCount {
            local seen = false
            for m in 0..covered.length() {
                if *covered.get(m) == k as i32 { seen = true }
            }
            if seen { continue }
            local v = sum.owner.variants.get(((*sum.decl).variantsFirst + k as u32) as usize)
            if missing.length() > 0 { missing.append(", ") }
            missing.append(format("`{}.{}`", ename, sum.owner.text((*v).name)).asStr())
        }
        l.err("E0750", (*st).span, format("`switch` on `{}` does not cover {}", ename, missing.asStr()).asStr(),
            "add a `case` for each missing variant, or a `default`")
    }
    local chain = Vec<i32>()
    if !hasDefault && covered.length() == variantCount && conds.length() > 0 {
        // Every variant is covered: the last arm is the `else` of the chain.
        local lastBody = (*bodies.get(bodies.length() - 1)).clone()
        defaultBody.push(l.b.blockStmt(lastBody))
        conds.pop()
        bodies.pop()
    }
    chain = switchChain(l, &conds, &bodies, &defaultBody)
    for i in 0..chain.length() { inner.push(*chain.get(i)) }
    return l.b.blockStmt(inner)
}
