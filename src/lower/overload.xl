// Overload resolution of the xlang lowering pass: the parameter types of a declaration and the
// choice among the candidates of one call. The C++ twin is src/sema/lower/call/overload.cpp
// (argumentCost, literalFits, convertible, resolveOverload). The functions here see only
// declarations and Types indices: no lowering, no diagnostics. The caller reports E0404 when no
// candidate fits and E0403 when two fit equally well.
from "std" import String, Vec
from "../sema/sema" import Sema
from "../sema/types" import T_INT, T_FLOAT, T_POINTER, T_FN_PTR, T_ENUM, T_STR, T_ARRAY, T_INTERFACE
from "../sema/conversion" import implicitConversion, C_OK, C_WARN
from "../sema/item" import SDecl, SParam
from "../sema/resolve" import resolve

/// How an argument of a call looks to the overload costs. `ARG_EXPR` is any expression, typed
/// with no context; the others are the literal forms the C++ `preLowerArgs` keeps apart.
export const ARG_EXPR: i32 = 0
export const ARG_INT: i32 = 1
export const ARG_FLOAT: i32 = 2
export const ARG_STR: i32 = 3
export const ARG_NIL: i32 = 4

/// The results of `pickOverload` that are not a candidate index.
export const PICK_NONE: i32 = -1
export const PICK_AMBIGUOUS: i32 = -2

/// The parameter types of the declaration `d` (its `self` excluded), resolved, in order.
export fn declParamTypes(s: *Sema, d: *SDecl) -> Vec<i32> {
    local out = Vec<i32>()
    for i in 0..(*d).paramsCount as usize {
        local p = s.paramAt((*d).paramsFirst as usize + i)
        if (*p).isSelf != 0 { continue }
        out.push(resolve(s, (*p).ty))
    }
    return out
}

/// The result type of `d`: `void` without a return type, else the resolved type.
export fn declRetType(s: *Sema, d: *SDecl) -> i32 {
    if (*d).hasRet == 0 { return s.types.makeVoid() }
    return resolve(s, (*d).ret)
}

/// The parameter keys of an overload: each type's symbol-safe spelling, the form `overloadKey`
/// appends to the name.
export fn mangledParams(s: *Sema, params: *Vec<i32>) -> Vec<String> {
    local out = Vec<String>()
    for i in 0..(*params).length() {
        out.push(s.types.mangle(*(*params).get(i)))
    }
    return out
}

/// True when a literal argument of kind `kind` fits `param` (C++ `literalFits`). A byte-array
/// parameter takes a string literal of at most its length in C++; that length is not known here,
/// so such a parameter does not fit (a known gap: `docs` lists it with the overload rules).
fn literalFits(s: *Sema, kind: i32, param: i32) -> bool {
    local p = s.types.get(param)
    if kind == ARG_INT { return p.kind == T_INT || p.kind == T_FLOAT || p.kind == T_ENUM }
    if kind == ARG_FLOAT { return p.kind == T_FLOAT }
    if kind == ARG_STR {
        if p.kind == T_STR || p.kind == T_POINTER { return true }
        if p.kind == T_ENUM && p.elem >= 0 { return s.types.get(p.elem).kind == T_POINTER }
        return false
    }
    if kind == ARG_NIL { return p.kind == T_POINTER || p.kind == T_FN_PTR }
    return false
}

/// True when a value of type `from` converts to `param` (C++ `convertible`): an unknown type
/// always does; otherwise the implicit conversion must be allowed or only warn.
/// Interface and class-to-interface conversions are not decided here yet (a known gap).
fn convertible(s: *Sema, argTy: i32, param: i32) -> bool {
    if argTy < 0 || param < 0 { return true }
    local r = implicitConversion(s.types, argTy, param, false, s.pointerBits)
    return r.status == C_OK || r.status == C_WARN
}

/// The cost of passing an argument of `kind` (type `from` when it is an expression) to `param`:
/// lower is closer (C++ `argumentCost`). The ranking, not the numbers, is what the choice uses.
fn argCost(s: *Sema, kind: i32, argTy: i32, param: i32) -> i32 {
    local p = s.types.get(param)
    if kind == ARG_INT {
        if p.kind == T_INT { return p.bits == 64 && p.isSigned != 0 ? 1 : 2 }
        return 3
    }
    if kind == ARG_FLOAT {
        if p.kind == T_FLOAT { return p.bits == 64 ? 1 : 2 }
        return 3
    }
    if kind == ARG_STR {
        if p.kind == T_STR { return 0 }
        if p.kind == T_POINTER { return 1 }
        return p.kind == T_ARRAY ? 2 : 3
    }
    if kind == ARG_NIL { return 1 }
    if argTy < 0 || s.types.same(argTy, param) { return 0 }
    local f = s.types.get(argTy)
    if p.kind == T_INT && f.kind == T_INT { return 1 }
    if p.kind == T_INTERFACE { return 1 }
    if p.kind == T_FLOAT && (f.kind == T_INT || f.kind == T_FLOAT) { return 2 }
    return 3
}

/// The candidate that the call fits best: `cands[i]` lists the parameter types of candidate i,
/// `kinds[j]` and `types[j]` describe argument j (`types` is the expression type, -1 when
/// unknown, and is ignored for the literal kinds). Returns the candidate index, `PICK_NONE` when no
/// candidate takes the arguments, or `PICK_AMBIGUOUS` when several are equally close (C++
/// `resolveOverload`: viable means every argument fits, then the lowest total cost wins).
export fn pickOverload(s: *Sema, cands: *Vec<Vec<i32>>, kinds: *Vec<i32>, types: *Vec<i32>) -> i32 {
    local bestCost = -1
    local best = PICK_NONE
    local ties = 0
    for c in 0..(*cands).length() {
        local params = (*cands).get(c)
        if (*params).length() != (*kinds).length() { continue }
        local ok = true
        local cost = 0
        for j in 0..(*kinds).length() {
            local param = *(*params).get(j)
            local kind = *(*kinds).get(j)
            local argTy = *(*types).get(j)
            if kind == ARG_EXPR {
                ok = ok && convertible(s, argTy, param)
            } else {
                ok = ok && literalFits(s, kind, param)
            }
            cost = cost + argCost(s, kind, argTy, param)
        }
        if !ok { continue }
        if best == PICK_NONE || cost < bestCost {
            best = c as i32
            bestCost = cost
            ties = 1
        } else if cost == bestCost {
            ties = ties + 1
        }
    }
    if best == PICK_NONE { return PICK_NONE }
    return ties > 1 ? PICK_AMBIGUOUS : best
}
