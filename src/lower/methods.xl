// Methods of the xlang lowering pass: the declaration of a class or struct type, and the method a
// call names, searched in the class and then its base classes (C++ `Lowerer::findMethod`). A
// method is found in one class only; the overloads of that name in that class are its candidates
// (C++ `methodCandidates`). Virtual methods are found too, so the caller can tell them apart.
// Only the module's own declarations are searched; a base class of another module is a known gap.
from "std" import String, Vec, format
from "../sema/sema" import Sema
from "../sema/module_scope" import lookupEntity, entityByQName
from "../sema/item" import SDecl
from "../sema/types" import T_CLASS, T_STRUCT
from "../sema/resolve" import resolve
from "../lang/ast/ast" import XD_IMPL

/// Where a class or struct is declared: the module `owner` and the SDecl index `decl` in it
/// (-1 when it is not found). A type of an imported module is spelled `key::Name`.
export struct ClassLoc {
    owner: *Sema
    decl: i32
}

/// True when the type name carries `::` (a name already qualified by its module).
fn isQualified(name: str) -> bool {
    for i in 0..name.len as usize {
        if name[i] == b':' && i + 1 < name.len as usize && name[i + 1] == b':' { return true }
    }
    return false
}

/// The declaration of the class or struct named `name` as seen from module `s`.
fn locate(s: *Sema, name: str) -> ClassLoc {
    local out = ClassLoc { owner: s, decl: -1 }
    local ref = isQualified(name) ? entityByQName(s, name) : lookupEntity(s, name)
    if ref.sym < 0 { return out }
    out.owner = ref.owner != nil ? ref.owner : s
    out.decl = out.owner.declOfItem(out.owner.itemOf(ref.sym))
    return out
}

/// The class or struct `ty` (a Types index of `s`), `decl` -1 when it is none.
export fn classLoc(s: *Sema, ty: i32) -> ClassLoc {
    local none = ClassLoc { owner: s, decl: -1 }
    if ty < 0 { return none }
    local rec = s.types.get(ty)
    if rec.kind != T_STRUCT && rec.kind != T_CLASS { return none }
    return locate(s, s.types.pathOf(rec).asStr())
}

/// The SDecl index of the class or struct `ty` (a Types index), -1 when it has none here.
export fn classDeclIndex(s: *Sema, ty: i32) -> i32 {
    return classLoc(s, ty).decl
}

/// The base class of the declaration `d` of `owner` (found from `owner`'s scope), `decl` -1 when
/// it has no base. The base is written as a path in the flat AST, as `lowerAggregate` reads it.
export fn baseLoc(owner: *Sema, d: i32) -> ClassLoc {
    local decl = owner.declAt(d as usize)
    if (*decl).baseCount == 0 { return ClassLoc { owner: owner, decl: -1 } }
    return locate(owner, owner.text(owner.flat.pathSeg((*decl).baseFirst)))
}

/// The SDecl index of the base class of the declaration `d`, -1 when it has no base.
export fn baseDeclIndex(s: *Sema, d: i32) -> i32 {
    return baseLoc(s, d).decl
}

/// The methods of the declaration `d` named `name`, as SDecl indices in declaration order.
export fn methodsNamed(s: *Sema, d: i32, name: str) -> Vec<i32> {
    local out = Vec<i32>()
    local decl = s.declAt(d as usize)
    for j in 0..(*decl).methodsCount as usize {
        local mIdx = (*decl).methodsFirst as usize + j
        if s.text((*s.declAt(mIdx)).name) == name { out.push(mIdx as i32) }
    }
    return out
}

/// A method a call names: `found` is false when no class of the chain declares it.
/// `decl` is the SDecl index of the method, `cdecl` the SDecl index of the class that declares it,
/// `cls` the qualified name of that class (the key prefix), `isVirtual` tells a vtable call from a
/// direct one.
export class MethodRef {
    found: bool
    owner: *Sema ///< the module that declares the class (`decl` and `cdecl` index its arena)
    decl: i32
    cdecl: i32
    cls: String
    isVirtual: bool
    viaInterface: bool ///< found in an `impl I for T` block (`cls` is `T.I`)
    ambiguous: bool    ///< two interface impls of the type declare the name (E0403)

    fn init(self) {
        self.viaInterface = false
        self.ambiguous = false
        self.found = false
        self.owner = nil
        self.decl = -1
        self.cdecl = -1
        self.cls = String("")
        self.isVirtual = false
    }
}

/// The method `name` of the class or struct `ty`, searched through its base classes.
export fn findMethod(s: *Sema, ty: i32, name: str) -> *MethodRef {
    local out = new MethodRef()
    local at = classLoc(s, ty)
    local depth = 0
    while at.decl >= 0 && depth < 32 {
        local o = at.owner
        local found = methodsNamed(o, at.decl, name)
        if found.length() > 0 {
            local m = *found.get(0)
            local decl = o.declAt(m as usize)
            (*out).found = true
            (*out).owner = o
            (*out).decl = m
            (*out).cdecl = at.decl
            (*out).cls = o.qualify(o.text((*o.declAt(at.decl as usize)).name))
            (*out).isVirtual = (*decl).isVirtual != 0 || (*decl).isOverride != 0
            return out
        }
        at = baseLoc(o, at.decl)
        depth = depth + 1
    }
    return findInherent(s, ty, name, out)
}

/// The method `name` of an `impl T { }` or `impl I for T { }` block whose target is the struct or
/// class `ty`. An inherent method is the function `T.name`, an interface one `T.I.name` (`cls`
/// carries the prefix); `cdecl` is the impl declaration (its methods are ranged like a class's).
/// The impl lives in the module that declares `T`. An inherent method wins; the same name in two
/// interface impls is `ambiguous` (the C++ pass silently took the first impl in item order).
fn findInherent(s: *Sema, ty: i32, name: str, out: *MethodRef) -> *MethodRef {
    local at = classLoc(s, ty)
    if at.decl < 0 { return out }
    local o = at.owner
    local typeQ = o.qualify(o.text((*o.declAt(at.decl as usize)).name))
    for i in 0..o.items.length() {
        local di = o.declOfItem(i as i32)
        if di < 0 { continue }
        local d = o.declAt(di as usize)
        if (*d).kind != XD_IMPL { continue }
        local target = resolve(o, (*d).implTarget)
        if target < 0 || o.types.pathOf(o.types.get(target)).asStr() != typeQ.asStr() { continue }
        local found = methodsNamed(o, di, name)
        if found.length() == 0 { continue }
        local isIface = (*d).ifacePathCount > 0
        if isIface && (*out).found {
            // An earlier inherent match wins; an earlier interface match makes it ambiguous.
            if (*out).viaInterface { (*out).ambiguous = true }
            continue
        }
        local cls = typeQ.clone()
        if isIface {
            local iface = interfaceQName(o, (*d).ifacePathFirst)
            if iface.length() == 0 { continue }
            cls = format("{}.{}", typeQ.asStr(), iface.asStr())
        }
        (*out).found = true
        (*out).owner = o
        (*out).decl = *found.get(0)
        (*out).cdecl = di
        (*out).cls = cls
        (*out).isVirtual = false
        (*out).viaInterface = isIface
        (*out).ambiguous = false
        if !isIface { return out }
    }
    return out
}

/// The qualified name of the interface whose first path segment is at `first` in the type
/// string table of `o`, "" when it names no interface (impls.xl reports that).
fn interfaceQName(o: *Sema, first: u32) -> String {
    local ref = lookupEntity(o, o.text(*o.types.strs.get(first)))
    if ref.sym < 0 { return String("") }
    local owner = ref.owner != nil ? ref.owner : o
    return owner.qualify(owner.text(ref.name))
}

/// The type of `self` in a method of the class `cls` (its qualified name): a pointer to the class.
export fn classSelfType(s: *Sema, cls: str) -> i32 {
    local segs = Vec<String>()
    segs.push(String(cls))
    return s.types.makePointer(s.types.makeAggregate(T_CLASS, segs, Vec<i32>()))
}
