// Shared helpers of the lowering pass.
from "std" import String, Vec, format
from "../sema/sema" import Sema

/// The qualified name of the base-class init helper of `cls`.
export fn baseInitKey(s: *Sema, cls: str) -> String {
    return format("{}.init$base", s.qualify(cls).asStr())
}

/// The key of an overload: the qualified name with each parameter's mangled type appended after a
/// `$`, the form the C++ pass writes (`name$i32$f64`). `params` holds the mangled types
/// (`mangledParams` in overload.xl, `paramTypes` in items.xl).
export fn overloadKey(qname: str, params: Vec<String>) -> String {
    local out = String(qname)
    for i in 0..params.length() {
        out.push(b'$')
        out.append((*params.get(i)).asStr())
    }
    return out
}
