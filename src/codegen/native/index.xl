// The native backend: the arm64 encoder (arm64), the Mach-O object writer (macho) and the
// instruction selector from the flat HIR (isel). It is the only code generator of xlc: macOS on
// arm64 (Apple silicon) is the one supported target.
from "std" import String
from "std/io" import fprint
from "std/io/fs" import fsWrite
from "../../hir/abi" import XlcHirModule
from "../isel" import select
from "../macho" import MachoObject, writeObject

/// Writes the Mach-O object of `m` to `output`. With `only` set, only the functions and globals of
/// the module keyed `only` are defined and every other symbol stays external (the incremental
/// build); `hasOnly` false defines the whole program and its boot code. False (reported) when the
/// module uses something the selector does not lower.
export fn emitNativeObj(m: *XlcHirModule, hasOnly: bool, only: str, output: *String) -> bool {
    local o = MachoObject()
    if !select(m, &o, hasOnly, only) {
        return false
    }
    local bytes = writeObject(&o)
    if output.asStr() == "-" {
        // `-o -` streams the object to stdout.
        fprint(1, bytes.asStr())
        return true
    }
    if !fsWrite(output.cstr(), bytes.asStr()) {
        fprint(2, "error: cannot write the object file\n")
        return false
    }
    return true
}
