// The Mach-O object writer (macOS, arm64): serializes an ObjectFile (src/codegen/obj) into a
// linkable `MH_OBJECT` file. References: `mach-o/loader.h`, `mach-o/nlist.h` and
// `mach-o/arm64/reloc.h` of Apple's cctools/xnu
// (https://github.com/apple-oss-distributions/xnu/blob/main/EXTERNAL_HEADERS/mach-o/loader.h,
// https://github.com/apple-oss-distributions/cctools/blob/main/include/mach-o/arm64/reloc.h). The
// layout mirrors what `clang -c` emits so `ld64` accepts it without special flags.
//
// File layout: the 32-byte header, the load commands (LC_SEGMENT_64 with every section,
// LC_BUILD_VERSION, LC_SYMTAB), the section contents (each aligned to its own alignment), the
// per-section relocation lists (8 bytes each), the symbol table (`nlist_64`, 16 bytes each) and
// the string table. All integers little-endian.
//
// Mach-O facts the writer owns (not the selector):
// - every C-visible symbol carries one leading `_` (`main` is `_main`, `_start` is `__start`);
// - the arm64 PAGEOFF12 relocation infers the load/store scale from the instruction itself, so
//   one kind covers `add` and every `ldr`/`str` width (ELF needs one number per width);
// - addends of instruction relocations would need an ARM64_RELOC_ADDEND pair; the selector never
//   emits one (every instruction relocation targets the symbol itself), the 8-byte data pointers
//   carry their addend in place.
// Fix over the first writer: symbols are written locals first, then defined externals, then
// undefined ones, the order `LC_DYSYMTAB`-aware tools expect, whatever order the selector used.
from "std" import String, Vec
from "../obj" import ObjectFile, Section, Sym, Reloc, SEC_TEXT, SEC_CSTRING, SEC_CONST, SEC_DATA,
    R_ABS64, R_BRANCH26, R_PAGE21, R_PAGEOFF12, R_GOT_PAGE21, R_GOT_PAGEOFF12, BIND_LOCAL, BIND_WEAK

// mach-o/arm64/reloc.h numbers (verified against clang's own output).
const ARM64_RELOC_UNSIGNED: u32 = 0
const ARM64_RELOC_BRANCH26: u32 = 2
const ARM64_RELOC_PAGE21: u32 = 3
const ARM64_RELOC_PAGEOFF12: u32 = 4
const ARM64_RELOC_GOT_LOAD_PAGE21: u32 = 5
const ARM64_RELOC_GOT_LOAD_PAGEOFF12: u32 = 6

const MH_MAGIC_64: u32 = 0xfeedfacf
const CPU_TYPE_ARM64: u32 = 0x0100000c
const CPU_SUBTYPE_ARM64_ALL: u32 = 0
const MH_OBJECT: u32 = 1
const LC_SEGMENT_64: u32 = 0x19
const LC_SYMTAB: u32 = 0x2
const LC_BUILD_VERSION: u32 = 0x32
const PLATFORM_MACOS: u32 = 1

// nlist types: a defined global is `N_EXT | N_SECT`, a local `N_SECT`, an undefined `N_EXT | N_UNDF`.
const N_UNDF: u32 = 0
const N_EXT: u32 = 0x01
const N_SECT: u32 = 0x0e
const N_WEAK_DEF: u32 = 0x80

// Section flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS for code,
// S_CSTRING_LITERALS for the literal pool.
const TEXT_FLAGS: u32 = 0x80000400
const CSTRING_FLAGS: u32 = 0x2

/// The section and segment names of a section kind.
fn sectName(kind: u32) -> str {
    return kind == SEC_TEXT ? "__text" : kind == SEC_CSTRING ? "__cstring" : kind == SEC_CONST ? "__const" : "__data"
}

fn segName(kind: u32) -> str {
    return kind == SEC_TEXT || kind == SEC_CSTRING ? "__TEXT" : "__DATA"
}

fn machoReloc(kind: u32) -> u32 {
    return kind == R_ABS64 ? ARM64_RELOC_UNSIGNED : kind == R_BRANCH26 ? ARM64_RELOC_BRANCH26
         : kind == R_PAGE21 ? ARM64_RELOC_PAGE21 : kind == R_PAGEOFF12 ? ARM64_RELOC_PAGEOFF12
         : kind == R_GOT_PAGE21 ? ARM64_RELOC_GOT_LOAD_PAGE21 : ARM64_RELOC_GOT_LOAD_PAGEOFF12
}

fn put16(out: *String, v: u32) {
    for k in 0..2 { out.push(((v >> ((k * 8) as u32)) & 0xff) as u8) }
}

fn put32(out: *String, v: u32) {
    for k in 0..4 { out.push(((v >> ((k * 8) as u32)) & 0xff) as u8) }
}

fn put64(out: *String, v: u64) {
    for k in 0..8 { out.push(((v >> ((k * 8) as u64)) & 0xff) as u8) }
}

/// Appends `s` as one NUL-padded 16-byte field (`sectname`/`segname`).
fn putName16(out: *String, s: str) {
    for i in 0..16 as usize { out.push(i < s.len ? s.ptr[i] : 0) }
}

fn padTo(out: *String, at: usize) {
    while out.length() < at { out.push(0) }
}

fn alignUp(v: usize, a: usize) -> usize {
    return (v + a - 1) / a * a
}

/// The rank of a symbol in the table: locals, defined externals, undefined.
fn rank(s: *Sym) -> u32 {
    return !s.defined ? 2 : s.bind == BIND_LOCAL ? 0 : 1
}

/// Serializes `o` to the bytes of a Mach-O object file.
export fn writeMacho(o: *ObjectFile) -> String {
    local nsect: usize = o.sections.length()
    local nsyms: usize = o.syms.length()

    // The written order of the symbols and each symbol's index in it.
    local order = Vec<u32>()
    local index = Vec<u32>()
    for i in 0..nsyms { index.push(0) }
    for r in 0..3 {
        for i in 0..nsyms {
            if rank(o.syms.get(i)) == r as u32 {
                index.set(i, order.length() as u32)
                order.push(i as u32)
            }
        }
    }

    // The string table: byte 0 is the empty name, then every `_`-prefixed name NUL-terminated.
    local strsize: usize = 1
    local strx = Vec<u32>()
    for i in order {
        strx.push(strsize as u32)
        strsize += o.syms.get(*i as usize).name.length() + 2
    }

    // The load commands: segment (72 bytes + 80 per section), build version (24), symtab (24).
    local sizeofcmds: usize = 72 + 80 * nsect + 24 + 24
    local cursor: usize = 32 + sizeofcmds

    // Section addresses inside the one segment, and their file offsets.
    local vmaddr = Vec<u32>()
    local dataOff = Vec<u32>()
    // The file image of the segment mirrors its memory image byte for byte (file offset =
    // fileoff + vm address), so filesize == vmsize; `nm`/`otool` reject filesize > vmsize, which
    // separate file and memory padding produced when the two cursors had different alignments.
    local vm: usize = 0
    local maxAlign: usize = 1
    for i in 0..nsect {
        local s: *Section = o.sections.get(i)
        local a: usize = (1 << s.alignLog2) as usize
        if a > maxAlign { maxAlign = a }
        vm = alignUp(vm, a)
        vmaddr.push(vm as u32)
        vm += s.code.length()
    }
    local fileoff: usize = alignUp(cursor, maxAlign)
    for i in 0..nsect { dataOff.push((fileoff + *vmaddr.get(i) as usize) as u32) }
    local filesize: usize = vm
    cursor = fileoff + vm
    local relocOff = Vec<u32>()
    for i in 0..nsect {
        cursor = alignUp(cursor, 8)
        relocOff.push(cursor as u32)
        cursor += 8 * o.sections.get(i).relocs.length()
    }
    cursor = alignUp(cursor, 8)
    local symoff: u32 = cursor as u32
    cursor += 16 * nsyms
    local stroff: u32 = cursor as u32

    local out = String()
    // mach_header_64: magic, cpu, subtype, file type, ncmds, sizeofcmds, flags, reserved.
    for v in [MH_MAGIC_64, CPU_TYPE_ARM64, CPU_SUBTYPE_ARM64_ALL, MH_OBJECT, 3, sizeofcmds as u32, 0, 0] {
        put32(&out, *v)
    }

    // LC_SEGMENT_64: one unnamed segment covering every section (what `clang -c` writes).
    put32(&out, LC_SEGMENT_64)
    put32(&out, (72 + 80 * nsect) as u32)
    putName16(&out, "")
    put64(&out, 0)
    put64(&out, vm as u64)
    put64(&out, fileoff as u64)
    put64(&out, filesize as u64)
    put32(&out, 7)  // maxprot rwx
    put32(&out, 7)  // initprot
    put32(&out, nsect as u32)
    put32(&out, 0)
    for i in 0..nsect {
        local s: *Section = o.sections.get(i)
        putName16(&out, sectName(s.kind))
        putName16(&out, segName(s.kind))
        put64(&out, *vmaddr.get(i) as u64)
        put64(&out, s.code.length() as u64)
        put32(&out, *dataOff.get(i))
        put32(&out, s.alignLog2)
        put32(&out, *relocOff.get(i))
        put32(&out, s.relocs.length() as u32)
        put32(&out, s.kind == SEC_TEXT ? TEXT_FLAGS : s.kind == SEC_CSTRING ? CSTRING_FLAGS : 0)
        put32(&out, 0)
        put32(&out, 0)
        put32(&out, 0)
    }

    // LC_BUILD_VERSION: platform macOS, minos 11.0 (the first arm64 macOS), sdk 14.0, no tools.
    for v in [LC_BUILD_VERSION, 24, PLATFORM_MACOS, 0x000b0000, 0x000e0000, 0] { put32(&out, *v) }

    // LC_SYMTAB.
    for v in [LC_SYMTAB, 24, symoff, nsyms as u32, stroff, strsize as u32] { put32(&out, *v) }

    for i in 0..nsect {
        padTo(&out, *dataOff.get(i) as usize)
        for b in o.sections.get(i).code { out.push(*b) }
    }
    for i in 0..nsect {
        padTo(&out, *relocOff.get(i) as usize)
        for r in o.sections.get(i).relocs {
            // relocation_info: r_address, then symbolnum:24 pcrel:1 length:2 extern:1 type:4.
            local t: u32 = machoReloc(r.kind)
            local pcrel: u32 = t == ARM64_RELOC_BRANCH26 || t == ARM64_RELOC_PAGE21 || t == ARM64_RELOC_GOT_LOAD_PAGE21 ? 1 : 0
            local len: u32 = r.kind == R_ABS64 ? 3 : 2
            put32(&out, r.addr)
            put32(&out, (*index.get(r.sym as usize) & 0xffffff) | (pcrel << 24) | (len << 25) | (1 << 27) | (t << 28))
        }
    }
    padTo(&out, symoff as usize)
    for k in 0..order.length() {
        local sym: *Sym = o.syms.get(*order.get(k) as usize)
        // nlist_64: n_strx, n_type, n_sect (1-based), n_desc, n_value (the section address plus
        // the offset).
        put32(&out, *strx.get(k))
        out.push((sym.defined ? (sym.bind == BIND_LOCAL ? N_SECT : N_EXT | N_SECT) : N_EXT | N_UNDF) as u8)
        out.push((sym.defined ? sym.section + 1 : 0) as u8)
        put16(&out, sym.bind == BIND_WEAK ? N_WEAK_DEF : 0)
        put64(&out, sym.defined ? (*vmaddr.get(sym.section as usize) as u64) + sym.value : 0)
    }
    padTo(&out, stroff as usize)
    out.push(0)
    for i in order {
        out.push(b'_')
        out.append(&o.syms.get(*i as usize).name)
        out.push(0)
    }
    return out
}
