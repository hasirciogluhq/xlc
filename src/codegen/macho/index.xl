// The Mach-O object file writer for arm64 (macOS): turns sections of code and data plus a
// symbol table into a linkable `MH_OBJECT` file. The format reference is Apple's
// `mach-o/loader.h` and `mach-o/arm64/reloc.h`; the layout mirrors what `clang -c` emits so
// `ld64` accepts the result without special flags.
//
// File layout of an object: the 32-byte header, the load commands, the section contents (each
// aligned to its own alignment), the per-section relocation lists, the symbol table (`nlist_64`
// entries, 16 bytes each) and the string table. All integers are little-endian.
from "std" import String, Vec

// The arm64 relocation types (mach-o/arm64/reloc.h; the numbers verified against clang's own
// output).
export const RELOC_UNSIGNED: u32 = 0     // absolute 32/64-bit word
export const RELOC_SUBTRACTOR: u32 = 1   // half of a `sym2 - sym1` pair
export const RELOC_BRANCH26: u32 = 2     // `b`/`bl`: the 26-bit word distance
export const RELOC_PAGE21: u32 = 3       // `adrp` @page: the 21-bit page distance
export const RELOC_PAGEOFF12: u32 = 4    // `add`/`ldr` @pageoff: the 12-bit page offset
export const RELOC_GOT_PAGE21: u32 = 5   // `adrp` of the GOT slot
export const RELOC_GOT_PAGEOFF12: u32 = 6
export const RELOC_POINTER_TO_GOT: u32 = 7

const MH_MAGIC_64: u32 = 0xfeedfacf
const CPU_TYPE_ARM64: u32 = 0x0100000c
const CPU_SUBTYPE_ARM64_ALL: u32 = 0
const MH_OBJECT: u32 = 1
const LC_SEGMENT_64: u32 = 0x19
const LC_SYMTAB: u32 = 0x2
const LC_DYSYMTAB: u32 = 0xb
const LC_BUILD_VERSION: u32 = 0x32
const PLATFORM_MACOS: u32 = 1

// nlist symbol types (mach-o/nlist.h). A defined symbol is `N_EXT | N_SECT` (a global with its
// section number), an undefined external is `N_EXT | N_UNDF`.
const N_UNDF: u32 = 0
const N_EXT: u32 = 0x01
const N_SECT: u32 = 0x0e

// The __text section flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS.
export const TEXT_FLAGS: u32 = 0x80000400

/// One relocation: patch `lengthLog2` bytes at `addr` inside the section from `symIndex`.
@repr(c)
export struct MachoReloc {
    addr: u32
    symIndex: u32
    pcrel: bool
    lengthLog2: u32  // log2 of the patched size: 2 = 4 bytes, 3 = 8 bytes
    isExtern: bool
    rtype: u32
}

/// One symbol. `section` is the 1-based section number of a defined symbol, 0 for an undefined
/// external; `value` is the byte offset inside that section. Defined symbols must be added
/// before undefined ones: the symbol table is written in that order and `LC_DYSYMTAB` indexes
/// the two runs.
export class MachoSym {
    name: String
    defined: bool
    section: u32
    value: u64

    fn init(self, name: str, defined: bool, section: u32, value: u64) {
        self.name = String(name)
        self.defined = defined
        self.section = section
        self.value = value
    }
}

/// One section: the contents, the relocations against them, and the header fields.
export class MachoSection {
    name: String
    flags: u32
    alignLog2: u32
    code: Vec<u8>
    relocs: Vec<MachoReloc>

    fn init(self, name: str, flags: u32, alignLog2: u32) {
        self.name = String(name)
        self.flags = flags
        self.alignLog2 = alignLog2
        self.code = Vec<u8>()
        self.relocs = Vec<MachoReloc>()
    }
}

/// The object under construction: sections and symbols, then `writeObject` serializes it.
export /// The Mach-O spelling of a symbol name: every user symbol carries the `_` prefix in the object
/// file. Idempotent, so a caller that already spelled `_name` stays as it is.
fn machoName(name: str) -> String {
    if name.len > 0 && __builtin_read(name.ptr) == b'_' {
        return String(name)
    }
    local out = String("_")
    out.append(name)
    return out
}

export class MachoObject {
    sections: Vec<MachoSection>
    syms: Vec<MachoSym>

    fn init(self) {
        self.sections = Vec<MachoSection>()
        self.syms = Vec<MachoSym>()
    }

    /// Adds a section and returns its 0-based index.
    fn addSection(self, name: str, flags: u32, alignLog2: u32) -> u32 {
        self.sections.push(MachoSection(name, flags, alignLog2))
        return (self.sections.length() - 1) as u32
    }

    /// Appends one instruction word to a code section, little-endian.
    fn addWord(self, section: u32, w: u32) {
        local s: *MachoSection = self.sections.get(section)
        s.code.push((w & 0xff) as u8)
        s.code.push(((w >> 8) & 0xff) as u8)
        s.code.push(((w >> 16) & 0xff) as u8)
        s.code.push(((w >> 24) & 0xff) as u8)
    }

    /// Appends one raw byte to a section: the bytes of a string literal in `__cstring`.
    fn addByte(self, section: u32, b: u8) {
        local s: *MachoSection = self.sections.get(section)
        s.code.push(b)
    }

    /// Adds a defined global symbol at `offset` inside `section` (0-based) and returns its
    /// symbol-table index. The stored value is the offset; `writeObject` turns it into the
    /// virtual address by adding the section's address.
    /// Adds a defined symbol at `offset` in `section` and returns its index. The name goes in
    /// with the Mach-O spelling: the object file prefixes every user symbol with `_` (what the
    /// LLVM target layer does on the LLVM path), so `add` arrives as `_add`.
    fn addDefined(self, name: str, section: u32, offset: u64) -> u32 {
        local spelled = machoName(name)
        self.syms.push(MachoSym(spelled.asStr(), true, section + 1, offset))
        return (self.syms.length() - 1) as u32
    }

    /// Adds an undefined external symbol (resolved by the linker) and returns its index.
    fn addUndefined(self, name: str) -> u32 {
        local spelled = machoName(name)
        self.syms.push(MachoSym(spelled.asStr(), false, 0, 0))
        return (self.syms.length() - 1) as u32
    }

    /// Adds a relocation against `symIndex` at byte `addr` of `section`.
    fn addReloc(self, section: u32, addr: u32, symIndex: u32, rtype: u32) {
        local s: *MachoSection = self.sections.get(section)
        // PC-relative: the branch distances and the `adrp` page distance. `PAGEOFF12` and the
        // absolute forms patch a plain offset.
        s.relocs.push(MachoReloc { addr: addr, symIndex: symIndex, pcrel: rtype == RELOC_BRANCH26 || rtype == RELOC_PAGE21,
            lengthLog2: 2, isExtern: true, rtype: rtype })
    }
}

/// Appends the little-endian 16-bit value.
fn put16(out: *String, v: u32) {
    out.push((v & 0xff) as u8)
    out.push(((v >> 8) & 0xff) as u8)
}

/// Appends the little-endian 32-bit value.
fn put32(out: *String, v: u32) {
    out.push((v & 0xff) as u8)
    out.push(((v >> 8) & 0xff) as u8)
    out.push(((v >> 16) & 0xff) as u8)
    out.push(((v >> 24) & 0xff) as u8)
}

/// Appends the little-endian 64-bit value.
fn put64(out: *String, v: u64) {
    local i: u32 = 0
    while i < 8 {
        out.push(((v >> (i * 8)) & 0xff) as u8)
        i += 1
    }
}

/// Appends `s` as one NUL-padded 16-byte field (`sectname`/`segname`).
fn putName16(out: *String, s: str) {
    local i: usize = 0
    while i < 16 {
        out.push(i < s.len ? s.ptr[i] : 0)
        i += 1
    }
}

/// Rounds `v` up to the next multiple of `a` (`a` a power of two).
fn alignUp(v: usize, a: usize) -> usize {
    return (v + a - 1) / a * a
}

/// Serializes the object to the file bytes. Emits `LC_SEGMENT_64` (all sections in `__TEXT`),
/// `LC_BUILD_VERSION` (macOS 11.0, SDK 14.0) and `LC_SYMTAB`, in that order, then the section
/// contents, relocations, symbols and strings.
export fn writeObject(o: *MachoObject) -> String {
    local nsect: usize = o.sections.length()
    local nsyms: usize = o.syms.length()

    // The string table: byte 0 is the empty name, then every symbol name NUL-terminated.
    local strsize: usize = 1
    local strx: Vec<u32> = Vec<u32>()
    for i in 0..nsyms {
        strx.push(strsize as u32)
        strsize += o.syms.get(i).name.length() + 1
    }

    // The load commands: segment (72 bytes + 80 per section), build version (24), symtab (24).
    local sizeofcmds: usize = 72 + 80 * nsect + 24 + 24
    local cursor: usize = 32 + sizeofcmds

    // The virtual addresses of the sections inside the segment: the running, aligned sum.
    local vmaddr: Vec<u32> = Vec<u32>()
    local vm: usize = 0
    for i in 0..nsect {
        local s: *MachoSection = o.sections.get(i)
        vm = alignUp(vm, (1 << s.alignLog2) as usize)
        vmaddr.push(vm as u32)
        vm += s.code.length()
    }
    local vmsize: usize = vm

    // Section data, each aligned to its declared alignment; the segment spans it.
    local dataOff: Vec<u32> = Vec<u32>()
    for i in 0..nsect {
        local s: *MachoSection = o.sections.get(i)
        cursor = alignUp(cursor, (1 << s.alignLog2) as usize)
        dataOff.push(cursor as u32)
        cursor += s.code.length()
    }
    local fileoff: usize = nsect > 0 ? (*dataOff.get(0)) as usize : cursor
    local filesize: usize = cursor - fileoff
    // Relocation lists, 8-byte entries on an 8-byte boundary.
    local relocOff: Vec<u32> = Vec<u32>()
    for i in 0..nsect {
        cursor = alignUp(cursor, 8)
        relocOff.push(cursor as u32)
        cursor += 8 * o.sections.get(i).relocs.length()
    }
    // Symbol table, then strings.
    cursor = alignUp(cursor, 8)
    local symoff: u32 = cursor as u32
    cursor += 16 * nsyms
    local stroff: u32 = cursor as u32

    local out: String = String()

    // The header: magic, cpu, file type, load-command count and size, flags, reserved.
    put32(&out, MH_MAGIC_64)
    put32(&out, CPU_TYPE_ARM64)
    put32(&out, CPU_SUBTYPE_ARM64_ALL)
    put32(&out, MH_OBJECT)
    put32(&out, 3)
    put32(&out, sizeofcmds as u32)
    put32(&out, 0)
    put32(&out, 0)

    // LC_SEGMENT_64: one `__TEXT` segment covering every section of the object.
    put32(&out, LC_SEGMENT_64)
    put32(&out, (72 + 80 * nsect) as u32)
    putName16(&out, "__TEXT")
    put64(&out, 0)                  // vmaddr
    put64(&out, vmsize as u64)
    put64(&out, fileoff as u64)
    put64(&out, filesize as u64)
    put32(&out, 7)  // maxprot (rwx)
    put32(&out, 7)  // initprot
    put32(&out, nsect as u32)
    put32(&out, 0)  // flags
    for i in 0..nsect {
        local s: *MachoSection = o.sections.get(i)
        putName16(&out, s.name.asStr())  // sectname
        putName16(&out, "__TEXT")        // segname
        put64(&out, *vmaddr.get(i) as u64)  // the virtual address inside the segment
        put64(&out, s.code.length() as u64)
        put32(&out, *dataOff.get(i))
        put32(&out, s.alignLog2)
        put32(&out, *relocOff.get(i))
        put32(&out, s.relocs.length() as u32)
        put32(&out, s.flags)
        put32(&out, 0)                   // reserved1
        put32(&out, 0)                   // reserved2
        put32(&out, 0)                   // reserved3
    }

    // LC_BUILD_VERSION: platform macOS, minos 11.0, sdk 14.0, no tools.
    put32(&out, LC_BUILD_VERSION)
    put32(&out, 24)
    put32(&out, PLATFORM_MACOS)
    put32(&out, 0x000b0000)  // minos
    put32(&out, 0x000e0000)  // sdk
    put32(&out, 0)           // ntools

    // LC_SYMTAB.
    put32(&out, LC_SYMTAB)
    put32(&out, 24)
    put32(&out, symoff)
    put32(&out, nsyms as u32)
    put32(&out, stroff)
    put32(&out, strsize as u32)

    // The section contents, padded up to each recorded offset.
    for i in 0..nsect {
        local s: *MachoSection = o.sections.get(i)
        while out.length() < *dataOff.get(i) as usize {
            out.push(0)
        }
        for k in 0..s.code.length() {
            out.push(*s.code.get(k))
        }
    }
    // The relocation lists.
    for i in 0..nsect {
        local s: *MachoSection = o.sections.get(i)
        while out.length() < *relocOff.get(i) as usize {
            out.push(0)
        }
        for k in 0..s.relocs.length() {
            local r: *MachoReloc = s.relocs.get(k)
            // The 8-byte relocation entry packs into one u32: symbol index (24 bits),
            // then special bits: pcrel, length (2), extern, type (4).
            local info: u32 = (r.symIndex & 0xffffff) | ((r.pcrel ? 1 : 0) << 24) | (r.lengthLog2 << 25) | ((r.isExtern ? 1 : 0) << 27) | (r.rtype << 28)
            put32(&out, r.addr)
            put32(&out, info)
        }
    }
    // The symbol table.
    while out.length() < symoff as usize {
        out.push(0)
    }
    for i in 0..nsyms {
        local sym: *MachoSym = o.syms.get(i)
        put32(&out, *strx.get(i))
        out.push((sym.defined ? N_EXT | N_SECT : N_EXT | N_UNDF) as u8)
        out.push((sym.defined ? sym.section : 0) as u8)
        put16(&out, 0)  // n_desc
        // A defined symbol's value is its virtual address: the section address plus the offset.
        put64(&out, sym.defined ? (*vmaddr.get(sym.section - 1) as u64) + sym.value : 0)
    }
    // The string table.
    while out.length() < stroff as usize {
        out.push(0)
    }
    out.push(0)
    for i in 0..nsyms {
        local name: *String = &o.syms.get(i).name
        for k in 0..name.length() {
            out.push(name.at(k))
        }
        out.push(0)
    }
    return out
}
