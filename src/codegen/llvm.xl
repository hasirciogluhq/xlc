// The LLVM code generator as the output step uses it: the C API of include/xlang/codegen/codegen_c.h.
// Generation, optimization and the writers stay in C++ (src/codegen/*.cpp, LLVM); this file decides
// nothing about what is generated. Each artifact is released by the caller with `releaseArtifact`.
from "std" import String, Vec
from "../cli/backend" import XlcSession, XlcStr, XlcStrList, xstr, xlist

/// The LLVM artifact behind the opaque handle of codegen_c.h.
export type XlcArtifact = u8

/// What to generate. Matches `XlcCodegenRequest`.
@repr(c)
export struct XlcCodegenRequest {
    name: XlcStr
    emit: XlcStr
    hasOnly: i32
    only: XlcStr
}

// Every codegen function is `declare`d: it resolves at link time from the backend archive, like
// the functions of src/cli/backend.xl.
@allow(W0301)
export declare fn xlcCodegenGenerate(session: *XlcSession, request: *XlcCodegenRequest) -> *XlcArtifact
@allow(W0301)
export declare fn xlcArtifactOptimize(artifact: *XlcArtifact, optLevel: i32)
@allow(W0301)
export declare fn xlcArtifactWriteIR(artifact: *XlcArtifact, path: XlcStr) -> i32
@allow(W0301)
export declare fn xlcArtifactWriteBitcode(artifact: *XlcArtifact, path: XlcStr) -> i32
@allow(W0301)
export declare fn xlcArtifactWriteObject(artifact: *XlcArtifact, path: XlcStr) -> i32
@allow(W0301)
export declare fn xlcArtifactFree(artifact: *XlcArtifact)
@allow(W0301)
export declare fn xlcArchive(objects: XlcStrList, output: XlcStr, os: XlcStr) -> i32

/// Generates the program of `session` for the output kind `emit` (exe, shared, static, obj, ir or
/// bc). With `hasOnly`, only the module keyed `only` is defined (the incremental build). Nil after a
/// reported failure.
export fn generate(session: *XlcSession, name: *String, emit: *String, hasOnly: bool, only: *String) -> *XlcArtifact {
    local request: XlcCodegenRequest
    request.name = xstr(name)
    request.emit = xstr(emit)
    request.hasOnly = hasOnly ? 1 : 0
    request.only = xstr(only)
    return xlcCodegenGenerate(session, &request)
}

/// Optimizes `a` for `optLevel` and writes it to `output` as `format` (`ir`, `bc`, or `obj` for
/// anything else). `-` streams to stdout. False after a reported failure.
export fn writeArtifact(a: *XlcArtifact, optLevel: i32, format: str, output: *String) -> bool {
    xlcArtifactOptimize(a, optLevel)
    local path = xstr(output)
    local rc: i32 = format == "ir" ? xlcArtifactWriteIR(a, path)
                  : format == "bc" ? xlcArtifactWriteBitcode(a, path)
                  : xlcArtifactWriteObject(a, path)
    return rc == 0
}

/// Releases an artifact returned by `generate`.
export fn releaseArtifact(a: *XlcArtifact) {
    xlcArtifactFree(a)
}

/// Writes `objects` into the static library `output` for the target OS `os`. False after a
/// reported failure.
export fn archive(objects: *Vec<String>, output: *String, os: XlcStr) -> bool {
    local arena = Vec<XlcStr>()
    return xlcArchive(xlist(objects, &arena), xstr(output), os) == 0
}
