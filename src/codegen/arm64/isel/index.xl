// The arm64 instruction selector: walks the flat HIR module (hir/abi.xl) and emits arm64 machine
// code and data into the format-neutral object (codegen/obj); the writer of the target's format
// (macho/, elf/) serializes it. The OS shows only in `syscall` (call.xl) and the boot code (data.xl).
//
//   gen.xl      the state, symbols, labels, temporary registers
//   layout.xl   sizes, alignments, field offsets          regs.xl   the frame and the local homes
//   expr.xl     expressions                               stmt.xl   statements
//   call.xl     calls, `syscall`, `new`, atomics          asm.xl    `__builtin_asm`
//   conv.xl     the calling conventions                   func.xl   one function
//   data.xl     globals, tables, boot code
//
// `select` generates every function that has a body and belongs to this object, then the data, then
// resolves the branches and writes the symbol table: defined symbols first, then the undefined ones.
// @spec https://developer.arm.com/documentation/ddi0487/latest
from "std" import String, Vec
from "../../../hir/abi" import XlcHirModule, XlcHirFunction, view
from "../../obj" import ObjectFile
from "../../target" import Target
from "../../common/syms" import flushSyms
from "call" import installCalls
from "data" import emitGlobals, emitTables, emitPadTable, emitBoot
from "func" import genFunction
from "gen" import Gen, Fixup, Rel, DRel

/// Resolves every pending branch: the immediate reaches from the branch word to its label.
fn patchAll(g: *Gen) {
    for i in 0..g.fixups.length() {
        local f: *Fixup = g.fixups.get(i)
        local off: i32 = (*g.labelPos.get(f.label as usize) as i32) - (f.at as i32)
        local w: u32 = *g.code.get(f.at as usize)
        if (w & 0xfe000000) == 0xb4000000 || (w & 0xff000000) == 0x54000000 {
            // cbz, cbnz, b.cond: the 19-bit signed distance at bits 5..23.
            g.code.set(f.at as usize, w | (((off & 0x7ffff) as u32) << 5))
        } else if (w & 0x9f000000) == 0x10000000 {
            // adr: the byte distance, low two bits at 29..30, the rest at 5..23.
            local bytes: u32 = ((off * 4) & 0x1fffff) as u32
            g.code.set(f.at as usize, w | ((bytes & 3) << 29) | ((bytes >> 2) << 5))
        } else {
            // b, bl: the 26-bit signed distance at bits 0..25.
            g.code.set(f.at as usize, w | ((off & 0x3ffffff) as u32))
        }
    }
}

/// Selects the module into `o`. With `hasOnly`, only the functions and globals of module `only`
/// are defined and the rest stays external; otherwise the whole program is defined, boot code
/// included. False (reported) when something could not be lowered.
export fn select(m: *XlcHirModule, o: *ObjectFile, target: *Target, hasOnly: bool, only: str) -> bool {
    local g: Gen = Gen(m, o, target, hasOnly, only)
    installCalls(&g)
    for fi in 0..m.functionCount as usize {
        local f: *XlcHirFunction = &m.functions[fi]
        // A `declare fn` is defined elsewhere (another object or a DLL), even when the HIR marks
        // it as having a body.
        if f.hasBody != 0 && f.declared == 0 && g.definedHere(view(f.module)) {
            genFunction(&g, fi as u32)
            g.syms.define(g.syms.id(g.fnSymbol(fi as u32)), g.text, *g.labelPos.get(fi) as u64 * 4)
        }
    }
    if !hasOnly {
        emitBoot(&g)
    }
    emitGlobals(&g)
    emitTables(&g)
    emitPadTable(&g)
    patchAll(&g)
    for i in 0..g.code.length() {
        o.addWord(g.text, *g.code.get(i))
    }
    local mapped = flushSyms(&g.syms, o)
    for i in 0..g.rels.length() {
        local r: *Rel = g.rels.get(i)
        o.addReloc(g.text, r.addr, *mapped.get(r.sym as usize), r.rtype)
    }
    for i in 0..g.drels.length() {
        local r: *DRel = g.drels.get(i)
        o.addDataReloc(r.section, r.addr, *mapped.get(r.sym as usize))
    }
    return !g.failed
}
