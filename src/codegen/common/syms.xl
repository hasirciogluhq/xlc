// The symbol table a selector builds while it generates code: names interned to ids, each defined
// at most once (section and offset), file-local or weak when asked. `flushSyms` hands it to the
// format-neutral object (codegen/obj) and returns the object index of every id, which the
// selector then uses for its relocations. Shared by every architecture.
from "std" import String, Vec
from "std/collections/hashmap" import HashMap
from "../obj" import ObjectFile

/// The symbols of the object: interned by name, defined once.
export class Syms {
    names: Vec<String>
    defined: Vec<bool>
    section: Vec<u32>
    offset: Vec<u64>
    fileLocal: Vec<bool>
    weak: Vec<bool>        // a weak definition: another object's strong one wins at link time
    index: HashMap<String, u32>

    fn init(self) {
        self.names = Vec<String>()
        self.defined = Vec<bool>()
        self.fileLocal = Vec<bool>()
        self.weak = Vec<bool>()
        self.section = Vec<u32>()
        self.offset = Vec<u64>()
        self.index = HashMap<String, u32>()
    }

    /// The id of symbol `name`, created on first use.
    fn id(self, name: str) -> u32 {
        local key = String(name)
        local found = self.index.get(key.clone())
        if found.isSome() {
            return *found.unwrap()
        }
        local n: u32 = self.names.length() as u32
        self.names.push(key.clone())
        self.defined.push(false)
        self.fileLocal.push(false)
        self.weak.push(false)
        self.section.push(0)
        self.offset.push(0)
        self.index.put(key, n)
        return n
    }

    /// Defines symbol `id` at `offset` of `section`.
    fn define(self, id: u32, section: u32, offset: u64) {
        self.defined.set(id as usize, true)
        self.section.set(id as usize, section)
        self.offset.set(id as usize, offset)
    }
}

/// Adds every symbol of `s` to `o`, the defined ones first, and returns the object index of each
/// id.
export fn flushSyms(s: *Syms, o: *ObjectFile) -> Vec<u32> {
    local n: usize = s.names.length()
    local mapped = Vec<u32>()
    for i in 0..n { mapped.push(0) }
    for i in 0..n {
        if *s.defined.get(i) {
            local name: str = s.names.get(i).asStr()
            local sec: u32 = *s.section.get(i)
            local off: u64 = *s.offset.get(i)
            mapped.set(i, *s.fileLocal.get(i) ? o.addLocal(name, sec, off)
                        : *s.weak.get(i) ? o.addWeak(name, sec, off) : o.addDefined(name, sec, off))
        }
    }
    for i in 0..n {
        if !*s.defined.get(i) {
            mapped.set(i, o.addUndefined(s.names.get(i).asStr()))
        }
    }
    return mapped
}
