// Source files and spans (port of src/util/source.cpp and include/xlang/util/source.h).
//
// A `Span` is one source range: file + start (line, column) + end (line, column, exclusive).
// Lines and columns are 1-based; columns count bytes. `SourceManager` owns the files of one
// compilation; `FileId` indexes into it. The struct is the C ABI shape the util bridge
// (src/util/xl_bridge.hpp) mirrors, so it carries `@repr(c)`.

from "std" import String, Vec
from "std/io" import fsExists, fsReadAllString
from "std/str" import fromParts, view

export const NO_FILE: u32 = 0xFFFFFFFF

@repr(c)
export struct Span {
    file: u32
    line: u32
    column: u32
    endLine: u32
    endColumn: u32
}

/// The default span: no file, the 1-based start of line 1.
export fn spanNone() -> Span {
    local s: Span
    s.file = NO_FILE
    s.line = 1
    s.column = 1
    s.endLine = 1
    s.endColumn = 1
    return s
}

/// A span over one point: file, line and column, one cell wide.
export fn spanAt(file: u32, line: u32, column: u32) -> Span {
    local s = spanNone()
    s.file = file
    s.line = line
    s.column = column
    s.endLine = line
    s.endColumn = column + 1
    return s
}

impl Span {
    /// False for the default span: it marks no place.
    fn valid(self) -> bool {
        return self.file != NO_FILE
    }

    /// Range from the start of `first` to the end of `last`.
    fn merged(self, last: Span) -> Span {
        local out = self
        out.endLine = last.endLine
        out.endColumn = last.endColumn
        return out
    }

    /// True when `inner` lies completely inside this span (same file).
    fn contains(self, inner: Span) -> bool {
        if !self.valid() || self.file != inner.file {
            return false
        }
        // `before`: (line, column) does not start after (line2, column2).
        local before = |l1: u32, c1: u32, l2: u32, c2: u32| -> bool {
            return l1 < l2 || (l1 == l2 && c1 <= c2)
        }
        return before(self.line, self.column, inner.line, inner.column) &&
            before(inner.endLine, inner.endColumn, self.endLine, self.endColumn)
    }
}

/// One file of the compilation: its path, its whole text and the byte offset of every line.
export class SourceFile {
    path: String
    text: String
    lineStarts: Vec<usize> ///< line_starts_[i] is the byte offset of line i + 1

    fn init(self, path: str, text: str) {
        self.path = String(path)
        self.text = String(text)
        self.lineStarts = Vec<usize>()
        self.lineStarts.push(0)
        for i in 0..self.text.len {
            if self.text.at(i) == 10 { // '\n'
                self.lineStarts.push(i + 1)
            }
        }
    }

    fn lineCount(self) -> usize {
        return self.lineStarts.length()
    }

    /// Text of 1-based line `number` without the line terminator; empty when out of range. The
    /// view borrows `text`, so it lives as long as the file.
    fn line(self, number: usize) -> str {
        if number == 0 || number > self.lineStarts.length() {
            return fromParts(nil, 0)
        }
        local begin = *self.lineStarts.get(number - 1)
        local end = number < self.lineStarts.length() ? *self.lineStarts.get(number) : self.text.len
        while end > begin && (self.text.at(end - 1) == 10 || self.text.at(end - 1) == 13) { // \n \r
            end--
        }
        return view(self.text.asStr(), begin, end - begin)
    }
}

/// The files of one compilation; `FileId` is the index of `addFile`/`loadFile`.
export class SourceManager {
    files: Vec<SourceFile>

    fn init(self) {
        self.files = Vec<SourceFile>()
    }

    fn addFile(self, path: str, text: str) -> u32 {
        self.files.push(SourceFile(path, text))
        return (self.files.length() - 1) as u32
    }

    /// Reads `path` from disk; panics when it cannot be read (the C++ side throws XlangError).
    fn loadFile(self, path: *String) -> u32 {
        if !fsExists(path.cstr()) {
            panic("cannot read the file")
        }
        local text = fsReadAllString(path.cstr())
        self.files.push(SourceFile(path.asStr(), fromParts(text.ptr, text.len)))
        return (self.files.length() - 1) as u32
    }

    fn file(self, id: u32) -> *SourceFile {
        return self.files.get(id as usize)
    }

    fn fileCount(self) -> usize {
        return self.files.length()
    }
}

// -------------------------------------------------------------------------------------------
// The C ABI of the util bridge (src/util/xl_bridge.hpp)

/// One string handed over the bridge: bytes the caller owns, not NUL-terminated.
@repr(c)
export struct XbStr {
    ptr: *u8
    len: u32
}

/// A fresh source manager for the bridge.
export(c) fn xlcUtilSourcesNew() -> *SourceManager {
    return new SourceManager()
}

/// Adds one file; the bridge copies the bytes.
export(c) fn xlcUtilAddFile(m: *SourceManager, path: *XbStr, text: *XbStr) -> u32 {
    return m.addFile(fromParts(path.ptr, path.len as usize),
        fromParts(text.ptr, text.len as usize))
}

export(c) fn xlcUtilSourcesFree(m: *SourceManager) {
    delete m
}
