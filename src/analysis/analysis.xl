// The static analyses of a lowered program and their C ABI, declared in src/analysis/xl_bridge.hpp.
// The analyses only read: the MIR passes check what needs the control flow (moves, borrows,
// initialization). Neither changes the graph nor an earlier phase.
//
// A run collects the findings of every body, then reports them sorted by source position, never in
// the order the passes or functions ran. A new analysis is one file in this folder and one line in
// `analyzeBody`; nothing else calls a pass.
from "../mir/model" import Module, Body
from "findings" import Findings
from "moves" import checkMoves
from "../util/diagnostics" import DiagnosticEngine

/// The passes that run on the MIR of one function, in order.
fn analyzeBody(b: *Body, findings: *Findings) {
    checkMoves(b, findings)
}

/// Runs every analysis over the MIR module `m` and reports the findings to `engine`, the C++
/// `DiagnosticEngine`.
export(c) fn xlcAnalysisRun(m: *Module, engine: *u8) {
    local findings = new Findings()
    for i in 0..m.bodies.length() {
        analyzeBody(m.bodies.get(i), findings)
    }
    findings.reportTo(engine as *DiagnosticEngine)
    delete findings
}
