// The flat form of the MIR of one function: the arrays `xl_bridge.cpp` fills from `mir::Body`
// (include/xlang/mir/mir.h) and the analyses in this folder read. Nothing here owns memory:
// children are `(first, count)` ranges into the shared arenas of `XamBody`, and every string is a
// borrowed `(bytes, len)` view that stays alive for the duration of one call.
//
// The kind numbers agree with the declaration order of the C++ enums; the C++ side checks them
// with `static_assert` in xl_bridge.cpp, so a reordered enum fails to build instead of crossing
// the boundary with a wrong number.
from "std/str" import fromParts
from "../util/source" import Span

/// One string across the boundary: the bytes are not NUL-terminated.
@repr(c)
export struct XamStr {
    bytes: *u8
    len: u32
}

export fn view(s: XamStr) -> str {
    return fromParts(s.bytes, s.len as usize)
}

// `mir::Local::Kind`
export const LOCAL_PARAM: u32 = 0
export const LOCAL_USER: u32 = 1
export const LOCAL_DROP_FLAG: u32 = 2
export const LOCAL_TEMP: u32 = 3

// `mir::Projection::Kind`
export const PROJ_FIELD: u32 = 0
export const PROJ_DEREF: u32 = 1
export const PROJ_INDEX: u32 = 2

// `mir::Operand::Kind`
export const OPERAND_COPY: u32 = 0
export const OPERAND_MOVE: u32 = 1
export const OPERAND_CONSTANT: u32 = 2

// `mir::Rvalue::Kind`
export const RV_USE: u32 = 0
export const RV_ADDRESS_OF: u32 = 1
export const RV_UNARY: u32 = 2
export const RV_BINARY: u32 = 3
export const RV_CAST: u32 = 4
export const RV_AGGREGATE: u32 = 5
export const RV_REPEAT: u32 = 6
export const RV_ZERO: u32 = 7
export const RV_SLICE: u32 = 8
export const RV_TO_INTERFACE: u32 = 9

// `mir::Terminator::Kind`
export const TERM_GOTO: u32 = 0
export const TERM_BRANCH: u32 = 1
export const TERM_CALL: u32 = 2
export const TERM_DROP: u32 = 3
export const TERM_TRY: u32 = 4
export const TERM_RETURN: u32 = 5
export const TERM_UNREACHABLE: u32 = 6

// `mir::Callee::Kind`
export const CALLEE_DIRECT: u32 = 0
export const CALLEE_INDIRECT: u32 = 1
export const CALLEE_VIRTUAL: u32 = 2
export const CALLEE_INTERFACE: u32 = 3
export const CALLEE_SYSCALL: u32 = 4
export const CALLEE_BUILTIN: u32 = 5

/// A parameter, a user variable, a drop flag or a temporary (`LOCAL_*`).
@repr(c)
export struct XamLocal {
    kind: u32
    name: XamStr
}

/// A local followed by `projCount` projections starting at `projFirst` of `XamBody.projs`.
@repr(c)
export struct XamPlace {
    id: u32
    projFirst: u32
    projCount: u32
}

/// One step of a place path (`PROJ_*`); `index` is the local that holds the element index of a
/// `PROJ_INDEX` step, and zero otherwise.
@repr(c)
export struct XamProj {
    kind: u32
    index: u32
}

/// A value an rvalue or a call consumes (`OPERAND_*`); a constant has no place.
@repr(c)
export struct XamOperand {
    kind: u32
    place: XamPlace
}

/// `place = value`: the rvalue is its kind (`RV_*`), the place it names (`RV_ADDRESS_OF`,
/// `RV_SLICE`) and `opCount` operands starting at `opFirst` of `XamBody.operands`.
@repr(c)
export struct XamStmt {
    place: XamPlace
    rvKind: u32
    rvPlace: XamPlace
    opFirst: u32
    opCount: u32
    span: Span
}

/// The control transfer that ends a block. `args` are `argCount` operands from `argFirst` of
/// `XamBody.operands`; the successors are `targetCount` block ids from `targetFirst` of
/// `XamBody.targets`, then `unwind` when `hasUnwind` is set.
@repr(c)
export struct XamTerm {
    kind: u32
    operand: XamOperand
    calleeKind: u32
    calleeValue: XamOperand
    argFirst: u32
    argCount: u32
    hasDest: u32
    dest: XamPlace
    place: XamPlace
    targetFirst: u32
    targetCount: u32
    hasUnwind: u32
    unwind: u32
    span: Span
}

@repr(c)
export struct XamBlock {
    stmtFirst: u32
    stmtCount: u32
    term: XamTerm
}

/// The MIR of one function; block 0 is the entry.
@repr(c)
export struct XamBody {
    locals: *XamLocal
    localCount: u32
    blocks: *XamBlock
    blockCount: u32
    stmts: *XamStmt
    projs: *XamProj
    operands: *XamOperand
    targets: *u32
}
